    { "match": "*ship*", "class": "metal_rough" },
    { "match": "*girder*", "class": "metal_rough" },
    { "match": "*rivet*", "class": "metal_rough" },
    { "match": "*railing*", "class": "metal_rough" },
    { "match": "*keypad*", "class": "metal_rough" },
    { "match": "*microwave*", "class": "metal_rough" },
    { "match": "*fridge*", "class": "metal_rough" },
    { "match": "*subcar*", "class": "metal_rough" },
    { "match": "*crushedcar*", "class": "metal_rough" },
    { "match": "*diagram*", "class": "matte" },
    { "match": "*portrait*", "class": "matte" },
    { "match": "*newspaper*", "class": "matte" },
    { "match": "*trainmap*", "class": "matte" },
    { "match": "*keepclear*", "class": "matte" },
    { "match": "*trespass*", "class": "matte" },
    { "match": "*outoforder*", "class": "matte" },
    { "match": "*ceramic*", "class": "tile" },
    { "match": "*tile*", "class": "tile" },
    { "match": "*checker*", "class": "tile" },
    { "match": "*mrbl*", "class": "tile" },
    { "match": "*marble*", "class": "tile" },
    { "match": "*formica*", "class": "plastic" },
    { "match": "*cpanel*", "class": "plastic" },
    { "match": "*cubicle*", "class": "plastic" },
    { "match": "*miniblinds*", "class": "plastic" },
    { "match": "*wood*", "class": "wood" },
    { "match": "*wd.dtx", "class": "wood" },
    { "match": "*board*", "class": "wood" },
    { "match": "*plank*", "class": "wood" },
