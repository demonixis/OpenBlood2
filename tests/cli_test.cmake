set(expected 0)
if(CASE STREQUAL "help")
    set(args --help)
    set(pattern "Open Blood II")
elseif(CASE STREQUAL "unknown")
    set(args --not-an-option)
    set(expected 2)
    set(pattern "Unknown option")
elseif(CASE STREQUAL "missing_data")
    set(args --config "${CONFIG}" --data-dir "${DATA_DIR}/does-not-exist" --check-data)
    set(expected 2)
    set(pattern "directory not found")
elseif(CASE STREQUAL "missing_config")
    set(args --config "${CONFIG}.missing" --data-dir "${DATA_DIR}" --check-data)
    set(expected 2)
    set(pattern "Configuration not found")
elseif(CASE STREQUAL "metadata")
    set(args --config "${CONFIG}" --data-dir "${DATA_DIR}" --check-data)
    set(pattern "Metadata only; no archives mounted")
else()
    message(FATAL_ERROR "Unknown CLI test case")
endif()
execute_process(COMMAND "${APP}" ${args} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
if(NOT "${result}" STREQUAL "${expected}" OR NOT "${output}${errors}" MATCHES "${pattern}")
    message(FATAL_ERROR "Expected exit ${expected} and '${pattern}', got ${result}:\n${output}\n${errors}")
endif()
