file(REMOVE_RECURSE "${ROOT}")
execute_process(COMMAND "${TEST}" "${CASE}" "${ROOT}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
if(CASE STREQUAL "abrupt" OR CASE STREQUAL "crash")
    if(CASE STREQUAL "abrupt" AND NOT "${result}" STREQUAL "23")
        message(FATAL_ERROR "Expected abrupt exit 23, got ${result}: ${errors}")
    elseif(CASE STREQUAL "crash" AND "${result}" MATCHES "^[0-9]+$")
        message(FATAL_ERROR "Expected signal termination, got ${result}: ${errors}")
    endif()
    file(GLOB sessions "${ROOT}/session-*")
    list(LENGTH sessions count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one isolated session, got ${count}")
    endif()
    list(GET sessions 0 session)
    file(READ "${session}/blood2.log" log)
    if(NOT log MATCHES "LAST RECORD BEFORE ABRUPT TERMINATION" OR EXISTS "${session}/finished.txt")
        message(FATAL_ERROR "Missing flushed evidence or incorrect completion marker")
    endif()
elseif(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Logging test failed (${result}): ${output}\n${errors}")
endif()
