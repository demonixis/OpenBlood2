file(REMOVE_RECURSE "${ROOT}")
file(MAKE_DIRECTORY "${ROOT}")
foreach(case IN ITEMS metadata invalid missing_data)
    set(args --config "${CONFIG}" --data-dir "${DATA_DIR}" --check-data)
    set(expected 0)
    set(pattern "Metadata only")
    if(case STREQUAL "invalid")
        set(args --not-an-option)
        set(expected 2)
        set(pattern "Unknown option")
    elseif(case STREQUAL "missing_data")
        set(args --config "${CONFIG}" --data-dir "${ROOT}/missing" --check-data)
        set(expected 2)
        set(pattern "directory not found")
    endif()
    execute_process(COMMAND "${APP}" --log-dir "${ROOT}/${case} é" ${args}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "Unexpected ${case} exit: ${result}\n${output}\n${errors}")
    endif()
    file(GLOB sessions "${ROOT}/${case} é/session-*")
    list(LENGTH sessions count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one log session for ${case}")
    endif()
    list(GET sessions 0 session)
    file(READ "${session}/blood2.log" log)
    file(READ "${session}/finished.txt" finished)
    if(NOT log MATCHES "${pattern}" OR NOT log MATCHES "Session finished: exit_code=${expected}" OR
       NOT finished STREQUAL "exit_code=${expected}\n")
        message(FATAL_ERROR "Missing application diagnostics for ${case}: ${log}\n${finished}")
    endif()
endforeach()
# Simultaneous launches share a root but never a session/file (execute_process pipelines run concurrently).
execute_process(COMMAND "${APP}" --log-dir "${ROOT}/concurrent" --help
    COMMAND "${APP}" --log-dir "${ROOT}/concurrent" --help
    RESULTS_VARIABLE results OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
if(NOT results STREQUAL "0;0")
    message(FATAL_ERROR "Concurrent launches failed: ${results}\n${errors}")
endif()
file(GLOB sessions "${ROOT}/concurrent/session-*")
list(LENGTH sessions count)
if(NOT count EQUAL 2)
    message(FATAL_ERROR "Concurrent launches must have distinct sessions")
endif()
foreach(session IN LISTS sessions)
    if(NOT EXISTS "${session}/finished.txt")
        message(FATAL_ERROR "Concurrent session did not finish: ${session}")
    endif()
endforeach()
file(WRITE "${ROOT}/blocker" "not a directory")
execute_process(COMMAND "${APP}" --log-dir "${ROOT}/blocker" --config "${CONFIG}"
    --data-dir "${DATA_DIR}" --check-data RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
if(NOT "${result}" STREQUAL "0" OR NOT "${output}${errors}" MATCHES "File logging unavailable" OR
   NOT "${output}${errors}" MATCHES "Metadata only")
    message(FATAL_ERROR "Console fallback failed: ${result}\n${output}\n${errors}")
endif()
