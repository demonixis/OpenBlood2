file(REMOVE_RECURSE "${ROOT}")
if(CASE STREQUAL "debugger")
    execute_process(COMMAND "${GDB}" -nx -nh -batch -iex "set auto-load off" -iex "set debuginfod enabled off"
        -ex run --args "${TEST}" "${CASE}" "${ROOT}" "${GDB}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
else()
    execute_process(COMMAND "${TEST}" "${CASE}" "${ROOT}" "${GDB}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
endif()
file(GLOB sessions "${ROOT}/session-*")
list(LENGTH sessions count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected isolated crash session: ${result}\n${output}\n${errors}")
endif()
list(GET sessions 0 session)
if(CASE MATCHES "^(lifecycle|missing|existing|unavailable|debugger|child_reaper)$")
    if(NOT "${result}" STREQUAL "0" OR NOT EXISTS "${session}/finished.txt" OR EXISTS "${session}/crash.core")
        message(FATAL_ERROR "Crash startup/teardown test failed: ${result}\n${output}\n${errors}")
    endif()
    return()
endif()
if(CASE STREQUAL "abort")
    set(signal "Subprocess aborted")
else()
    set(signal "Segmentation fault")
endif()
if(NOT "${result}" STREQUAL "${signal}" OR EXISTS "${session}/finished.txt")
    message(FATAL_ERROR "Expected original ${signal} termination, got ${result}\n${output}\n${errors}")
endif()
file(READ "${session}/blood2.log" log)
file(READ "${session}/crash-context.txt" context)
if(NOT log MATCHES "LAST LOG BEFORE CRASH" OR NOT context MATCHES "instruction=0x[0-9a-f]+")
    message(FATAL_ERROR "Crash lost logs or signal context")
endif()
if(CASE MATCHES "^(dead_helper|collector_loss)$")
    if(EXISTS "${session}/crash.core")
        message(FATAL_ERROR "Dead helper must not claim a dump")
    endif()
    if(CASE STREQUAL "collector_loss")
        file(READ "${session}/crash-report.txt" report)
        string(REGEX MATCH "debugger_pid=([0-9]+)" pid_line "${report}")
        set(pid "${CMAKE_MATCH_1}")
        if(NOT pid)
            message(FATAL_ERROR "Collector-loss fixture did not reach debugger launch")
        endif()
        foreach(attempt RANGE 1 20)
            execute_process(COMMAND "${CMAKE_COMMAND}" -E cat "/proc/${pid}/stat"
                RESULT_VARIABLE present OUTPUT_VARIABLE state ERROR_QUIET)
            if(NOT present EQUAL 0 OR state MATCHES "\\) Z")
                break()
            endif()
            execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.01)
        endforeach()
        if(present EQUAL 0 AND NOT state MATCHES "\\) Z")
            message(FATAL_ERROR "Collector death left a live debugger: ${state}")
        endif()
    endif()
    return()
endif()
file(READ "${session}/crash-report.txt" report)
if(CASE MATCHES "^(timeout|dump_failure|size_limit)$")
    if(NOT report MATCHES "core_saved=0" OR EXISTS "${session}/crash.core")
        message(FATAL_ERROR "Failed capture claimed success: ${report}")
    endif()
    if(CASE STREQUAL "size_limit" AND EXISTS "${session}/crash.core.partial")
        file(SIZE "${session}/crash.core.partial" size)
        if(size GREATER 4096)
            message(FATAL_ERROR "Dump exceeded its configured limit")
        endif()
    endif()
    return()
endif()
file(READ "${session}/crash-stacktrace.txt" stack)
if(NOT report MATCHES "core_saved=1" OR NOT EXISTS "${session}/crash-executable" OR
   NOT EXISTS "${session}/crash.core")
    message(FATAL_ERROR "Missing successful dump: ${report}\n${stack}")
endif()
# Reopen the actual ELF dump with the preserved executable, not just a file-existence assertion.
execute_process(COMMAND "${GDB}" -nx -nh -batch -iex "set auto-load off" -iex "set debuginfod enabled off"
    "${session}/crash-executable" -c "${session}/crash.core"
    -ex "thread apply all bt 128" -ex "x/wx &crash_sentinel"
    RESULT_VARIABLE reopened OUTPUT_VARIABLE decoded ERROR_VARIABLE decode_errors TIMEOUT 20)
file(WRITE "${session}/reopened-core.txt" "${decoded}\n${decode_errors}")
if(NOT "${reopened}" STREQUAL "0" OR NOT decoded MATCHES "0x13572468")
    message(FATAL_ERROR "Cannot decode captured memory: ${decoded}\n${decode_errors}")
endif()
if(CASE MATCHES "^(segv|thread)$")
    if(NOT stack MATCHES "crash_leaf" OR NOT stack MATCHES "crash_capture_tests.cpp:[0-9]+" OR
       NOT decoded MATCHES "crash_middle" OR NOT decoded MATCHES "crash_outer")
        message(FATAL_ERROR "Fault origin or nested frames missing: ${stack}\n${decoded}")
    endif()
elseif(CASE STREQUAL "overflow" AND NOT decoded MATCHES "crash_overflow")
    message(FATAL_ERROR "Stack overflow origin missing: ${decoded}")
endif()
