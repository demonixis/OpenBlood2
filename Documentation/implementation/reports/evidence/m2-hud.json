  "commands": [
    "cmake --build build/<debug|release|sanitize> -j3 --target blood2_app hud_tests player_tests weapon_tests player_controls_tests player_restore_tests player_keepalive_tests world_tests object_contract_tests",
    "cmake --build build/<debug|release> -j3 --target level_change_gpu_tests",
    "ctest --test-dir build/<debug|release> -R '^(hud|player|weapons|player_controls|player_restore|player_keepalive|objects)\\.|^world\\.level_change' -V -j2",
    "ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 ctest --test-dir build/sanitize -R '^(hud|player|weapons|player_controls|player_restore|player_keepalive|objects)\\.|^world\\.level_change' -V -j2",
    "VK_DRIVER_FILES=/usr/share/vulkan/icd.d/nvidia_icd.x86_64.json ctest --test-dir build/<debug|release> -R '^gpu\\.(hud|lifecycle|player|weapons|player_restore|player_keepalive|player_controls|level_change|mouse_combat|corpse_clearance)$' -V",
    "ctest --test-dir build/<debug|release|sanitize> -R '^hud\\.' -V (sanitizer environment as above)",
    "VK_DRIVER_FILES=/usr/share/vulkan/icd.d/nvidia_icd.x86_64.json ctest --test-dir build/<debug|release> -R '^gpu.hud$' -V"
  ],
  "development_findings": [
    "Event-time text/disabled guards prevent a digit from leaking into gameplay when the inspector closes or controls enable in the same frame.",
    "Original SMSG_PLAYERSTATSUPDATE additionally caps ammo at 999; the display preserves that limit while the typed inspection snapshot retains raw counts.",
    "Private HUD fixtures grant/switch the M16 diagnostically during the intro to test distinct ammo pools; they are not authored acquisition/playthrough evidence."
  ],
  "limitations": [
    "Compact ImGui presentation only, not original PCX status-bar artwork, air/focus/item/communication HUD or rebinding.",
    "User reports of idle Cultists, enemy durability, possible post-transition firing failure, invisible level-two water and silent pickups are queued, not diagnosed/fixed in this increment.",
    "Linux NVIDIA validation does not certify native Metal execution. Required M2 services remain incomplete."
  ],
