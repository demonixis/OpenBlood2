+    float alpha = 1;
+    double start_time = 0, last_time = 0, next_update = 0;
+    std::uint64_t id = 0, event = 0, updates = 0;
+    DDWORD flags = FLAG_VISIBLE | FLAG_MODELGOURAUDSHADE | FLAG_NOLIGHT;
+
+  private:
+    bool initialized_ = false, scale_changes_ = false;
+};
