+            const auto* v = g.server.audio.get(id);
+            CHECK(v && v->loops == 3 && v->position.x == 75 && v->left == .25f && v->right == .25f);
+            CHECK(g.server.advance_audio(.1, {}, {{0, 1, 0}, 0}) && v->left == .25f && v->right == .25f);
+            SoundRequest r;
+            r.resource = "cue.wav";
