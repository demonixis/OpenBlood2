+        return true;
+    }
+} // namespace
+int main(int argc, char** argv)
+{
+    if (argc != 3)
+        return 2;
+    std::string mode = argv[1];
+    return (mode == "formulas"    ? formulas(argv[2])
+            : mode == "selection" ? selection(argv[2])
+            : mode == "failures"  ? failures(argv[2])
+                                  : mode == "private" && private_world(argv[2]))
+               ? 0
+               : 1;
+}
