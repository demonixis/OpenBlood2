diff --git a/src/game/original/CommLink.cpp b/src/game/original/CommLink.cpp
new file mode 100644
index 0000000..d820ca8
--- /dev/null
+++ b/src/game/original/CommLink.cpp
@@ -0,0 +1,126 @@
+#include "CommLink.h"
+#include <algorithm>
+void CCommLink::Reset(ServerDE& server)
+{
+    if (voice)
+        server.KillSound(voice);
+    *this = {};
+}
+bool CCommLink::Start(ServerDE& server, const OpenBlood2::Conversation& value)
+{
+    ++received;
+    ++voice_manager_requests; // Original shell StopAll; VoiceMgr is explicitly unavailable.
+    if (level)
+    {
+        ++busy;
+        return false;
+    }
+    if (voice)
+        server.KillSound(voice);
+    voice = 0;
+    message = value;
+    length = std::max(2.5f, static_cast<float>(message.text.size()) / 15.f);
+    text_length = length / 1.5f;
+    text_scroll = (length - text_length) / 2.f;
+    play_voice = message.file != "default.wav";
+    start = server.GetTime();
+    level = 1;
+    static constexpr const char* portraits[] = {"c_comm.pcx", "o_comm.pcx", "i_comm.pcx", "g_comm.pcx", "v_comm.pcx"};
+    portrait =
+        std::string("interface/commlink/") + (message.character < 5 ? portraits[message.character] : "u_comm.pcx");
+    error.clear();
+    ++started;
+    return true;
+}
+void CCommLink::Update(ServerDE& server, HOBJECT player)
+{
+    if (!level)
+        return;
+    const auto time = server.GetTime();
+    switch (level)
+    {
+        case 1:
+            if (time - start > .2f)
+            {
+                ratio = 1;
+                level = 2;
+                start = time;
+                text_level = 1;
+                text_start = time;
+                if (play_voice)
+                {
+                    ++voice_manager_requests;
+                    if (voice)
+                        server.KillSound(voice);
+                    OpenBlood2::SoundRequest r;
+                    r.resource = message.file;
+                    r.space = OpenBlood2::SoundSpace::Local;
+                    r.streaming = false;
+                    r.priority = 2;
+                    r.reverb_requested = false;
+                    ++sound_attempts;
+                    voice = server.PlayCinematicSound(player, r, error);
+                    if (!voice)
+                        ++sound_failures;
+                    else
+                    {
+                        float duration = 3;
+                        server.GetSoundDuration(voice, duration);
+                        voice_manager_delay = duration + .5f; // Requested only; no invented VoiceMgr arbitration.
+                    }
+                }
+            }
+            else
+                ratio = (time - start) / .2f;
+            break;
+        case 2:
+            // Original uses text-derived time, even if the voice is longer or already done.
+            if (time - start > length)
+            {
+                level = 3;
+                start = time;
+                if (voice)
+                    server.KillSound(voice);
+                voice = 0;
+            }
+            break;
+        case 3:
+            if (time - start > .2f)
+            {
+                ratio = 0;
+                level = 0;
+                start = time;
+            }
+            else
+                ratio = 1 - (time - start) / .2f;
+            break;
+    }
+    switch (text_level)
+    {
+        case 1:
+            if (time - text_start > text_scroll)
+            {
+                text_level = 2;
+                text_start = time;
+            }
+            else
+                text_ratio = (time - text_start) / text_scroll;
+            break;
+        case 2:
+            if (time - text_start > text_length)
+            {
+                text_level = 3;
+                text_start = time;
+            }
+            break;
+        case 3:
+            if (time - text_start > text_scroll)
+            {
+                text_level = 0;
+                text_start = time;
+            }
+            else
+                text_ratio = (time - text_start) / text_scroll;
+            break;
+    }
+}
