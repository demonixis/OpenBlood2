+    // InitialUpdate precedes SetClient, as in the original engine.
+    if (!m_InventoryMgr.Init(m_hObject,m_hClient) || !m_damage.Init(m_hObject,&m_InventoryMgr)) return DFALSE;
+    m_bFirstUpdate = DTRUE;
+    m_InventoryMgr.SetAmmoCount(1,50);
+    server->SetNextUpdate(m_hObject,.001f);
+    m_damage.SetHitPoints(100); m_damage.SetArmorPoints(0);
+    m_damage.m_fMaxHitPoints = m_damage.m_fMaxMegaHitPoints = 100;
+    m_damage.m_fMaxArmorPoints = m_damage.m_fMaxNecroArmorPoints = 100;
+    m_damage.m_fMass = 250;
+    m_fSmellTime = server->GetTime(); m_fSmellDelay = .5f;
+    ObjectCreateStruct state; server->GetObjectPos(m_hObject,&state.m_Pos);
+    if (auto* smell = server->CreateObject(server->GetClass("SmellHint"),&state)) initial_smell_ = smell->m_hObject;
+    else return DFALSE;
+    DVector dims{12,82.0f/2,12}; server->SetObjectDims(m_hObject,&dims);
+    m_hstrTrigger = server->CreateString("TRIGGER");
+    initialized = m_hstrTrigger != nullptr;
+    return initialized;
