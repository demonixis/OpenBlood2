+FireResult CPlayerObj::HandleWeaponFireMessage(const blood2::WeaponFire& request) {
+    if (!m_hClient || !attributes_received || m_damage.IsDead() ||
+        GetServerDE()->GetClientUserData(m_hClient)!=m_hObject) return FireResult::Invalid;
+    const auto result=m_InventoryMgr.FireCurrentWeapon(request);
+    if (result==FireResult::Fired || result==FireResult::DeliveryFailed)
+        UpdateStats();
+    return result;
+}
