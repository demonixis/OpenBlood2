+bool CPlayerObj::Respawn() {
+    auto* server = GetServerDE();
+    // Preserve the original single-player dead-player gate. This operation is
+    // an entry reset, not a replacement for loading a save after death.
+    if (m_damage.IsDead()) { entry_error = "A dead single-player character requires save restoration"; return false; }
+    if (!SetCharacter(m_nCharacter)) return false;
+    const DDWORD flags = FLAG_VISIBLE | FLAG_MODELKEYS | FLAG_YROTATION | FLAG_ANIMTRANSITION |
+        FLAG_TOUCH_NOTIFY | FLAG_SOLID | FLAG_STAIRSTEP | FLAG_SHADOW;
+    server->SetObjectFlags(m_hObject,flags);
+    DVector velocity{}; server->SetVelocity(m_hObject,&velocity);
+    m_damage.SetHitPoints(100); m_damage.SetArmorPoints(0); m_bDead = DFALSE; m_fAirLevel = 100;
+    for (DBYTE i = 1; i <= 12; ++i) m_InventoryMgr.SetAmmoCount(i,0);
+    m_InventoryMgr.SetAmmoCount(1,50);
+    ++respawns;
+    return UpdateClientPhysics() && TeleportClientToServerPos();
+}
