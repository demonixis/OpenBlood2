+// Original CultistAI.cpp:562-590. Impact hearing already selects StateDodge.
+bool CultistAI::AI_STATE_Dodge()
+{
+    ++dodge_updates;
+    switch (Metacmd)
+    {
+        case 1:
+            m_nDodgeFlags = CalculateDodge(m_vTrackObjPos);
+            if (m_nDodgeFlags < 0)
+                return StateFailure(locomotion_error.c_str());
+            ++Metacmd;
