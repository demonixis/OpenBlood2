+        case 2:
+            if (m_nDodgeFlags & 0x10)
+            {
+                if (m_nDodgeFlags & 4)
+                    return MC_Roll_Right();
+                if (m_nDodgeFlags & 8)
+                    return MC_Roll_Left();
+            }
+            ++Metacmd; // Source has no forward/backward or obstructed-roll action.
+            return true;
+        case 3:
+            return ComputeState();
+        default:
+            return true;
+    }
