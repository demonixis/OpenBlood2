+        CHECK(g.server.IntersectSegment({62, 50, 50}, {62, 50, 70}, p, hit, false, SegmentObjects::All) ==
+              SegmentResult::Hit);
+        CHECK(hit.object == c && near(g.objects.get(c)->state.m_Pos, {62, 50, 60}));
