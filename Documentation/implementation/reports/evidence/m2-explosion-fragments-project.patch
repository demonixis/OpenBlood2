+add_executable(explosion_fragment_tests explosion_fragment_tests.cpp ../src/app/model_scene.cpp)
+target_link_libraries(explosion_fragment_tests PRIVATE blood2_game)
+blood2_project_options(explosion_fragment_tests)
+foreach(case lifecycle collision recipes failures session)
+    add_test(NAME explosion_fragments.${case} COMMAND explosion_fragment_tests "${case}" "${CMAKE_CURRENT_BINARY_DIR}/explosion-fragments-${case}")
+    set_tests_properties(explosion_fragments.${case} PROPERTIES LABELS "headless;explosion_fragments" TIMEOUT 30)
+endforeach()
+if(BLOOD2_TEST_DATA_DIR)
+    add_test(NAME explosion_fragments.private COMMAND explosion_fragment_tests private "${BLOOD2_TEST_DATA_DIR}")
+    set_tests_properties(explosion_fragments.private PROPERTIES LABELS "headless;private;explosion_fragments" TIMEOUT 120)
+endif()
+if(BLOOD2_GPU_TESTS)
+    add_executable(explosion_fragment_gpu_tests explosion_fragment_gpu_tests.cpp)
+    target_link_libraries(explosion_fragment_gpu_tests PRIVATE blood2_game)
+    blood2_project_options(explosion_fragment_gpu_tests)
+    add_test(NAME gpu.explosion_fragment_alpha COMMAND explosion_fragment_gpu_tests "${CMAKE_CURRENT_BINARY_DIR}/explosion-fragment-alpha")
+    set_tests_properties(gpu.explosion_fragment_alpha PROPERTIES LABELS "gpu;explosion_fragments" TIMEOUT 30 RUN_SERIAL TRUE FAIL_REGULAR_EXPRESSION "Validation Error;VUID-")
+    if(BLOOD2_TEST_DATA_DIR)
+        add_test(NAME gpu.explosion_fragment_private COMMAND explosion_fragment_gpu_tests "${CMAKE_CURRENT_BINARY_DIR}/explosion-fragment-private" "${BLOOD2_TEST_DATA_DIR}")
+        set_tests_properties(gpu.explosion_fragment_private PROPERTIES LABELS "gpu;private;explosion_fragments" TIMEOUT 30 RUN_SERIAL TRUE FAIL_REGULAR_EXPRESSION "Validation Error;VUID-")
+    endif()
