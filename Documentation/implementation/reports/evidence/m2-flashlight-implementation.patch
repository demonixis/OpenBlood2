+    bool ray(const std::filesystem::path& root)
+    {
+        GameSession g;
+        CHECK(setup(g, root));
+        auto& p = player(g);
+        CHECK(p.m_InventoryMgr.AddItem(2, 1) == InventoryResult::Ok);
+        auto& f = *p.m_InventoryMgr.flashlight;
