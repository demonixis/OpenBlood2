+    bool collision_traversal()
+    {
+        WorldModel model;
+        model.surfaces.resize(1);
+        model.surfaces[0].flags = 1;
+        for (unsigned x = 0; x < 32; ++x)
+            for (unsigned z = 0; z < 32; ++z)
