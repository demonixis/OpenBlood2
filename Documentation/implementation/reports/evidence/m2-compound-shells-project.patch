+        CHECK(sweep_object(*r, {6, 2, 2}, {6, 2, 10}, {}, hit) == CollisionQuery::Hit);
+        CHECK(g.server.MoveWorldModel(h, {21, 1, 1}) == MoverResult::Moved);
+        CHECK(r->state.m_Pos.x == 21 && r->world_model->closed_components == 2);
