+    bool lifetime(const std::filesystem::path& root)
+    {
+        GameSession g;
+        CHECK(test_player::setup(g, root));
+        g.world.models.push_back(compound());
+        auto h = g.objects.create(g.objects.find_class("Door"), {}, Creation::World,
