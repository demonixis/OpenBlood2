65: DDWORD CHandWeaponModel::EngineMessageFn(DDWORD messageID, void *pData, DFLOAT lData)
66: {
67: 	CServerDE* pServerDE = GetServerDE();
68: 	if (!pServerDE) return 0;
69: 
70: 	switch(messageID)
71: 	{
72: 		case MID_PRECREATE:
73: 		{
74: 			ObjectCreateStruct *ocs = (ObjectCreateStruct*)pData;
75: 			m_dwClientID = ocs->m_UserData;
76: 
77: 			if(ocs->m_NextUpdate == 0.02f)
78: 				m_bLeftHand = DTRUE;
79: 
80: 			ocs = DNULL;
81: 		}
82: 
83: 		case MID_UPDATE:
84: 		{
85: 			if (!Update())
86: 				pServerDE->RemoveObject(m_hObject);
87: 			break;
88: 		}
89: 
90: 		case MID_INITIALUPDATE:
91: 		{
92: 			pServerDE->SetNextUpdate(m_hObject, 0.01f);
93: 			DVector vDims;
94: 			VEC_SET(vDims, 0.1f, 0.1f, 0.1f);
95: 			pServerDE->SetObjectDims(m_hObject, &vDims);
96: 
97: 			if(m_dwClientID)
98: 			{
99: 				HMESSAGEWRITE hMsg = pServerDE->StartSpecialEffectMessage(this);
100: 				pServerDE->WriteToMessageByte(hMsg, SFX_WEAPONHANDMODEL_ID);
101: 				pServerDE->WriteToMessageDWord(hMsg, m_dwClientID);
102: 				pServerDE->WriteToMessageByte(hMsg, (m_bLeftHand << 1) | DFALSE);
103: 				pServerDE->EndMessage2(hMsg, MESSAGE_GUARANTEED);
104: 			}
105: 			break;
106: 		}
107: 
108: 		default:
109: 			break;
110: 	}
111: 
112: 
113: 	return BaseClass::EngineMessageFn(messageID, pData, lData);
114: }
115: 
202: 
203: 		if( !m_bDropped )
204: 		{
205: 			pServerDE->SetNextUpdate(m_hObject, 0.0f);
206: 			return DTRUE;
207: 		}
208: 	}
209: 
210: 	// See if standing on anything
211: 	CollisionInfo collisionInfo;
212: 
213: 	pServerDE->GetStandingOn(m_hObject, &collisionInfo);
214: 	DBOOL bIsStandingOn = (collisionInfo.m_hObject != DNULL);
215: 
216: 	if (bIsStandingOn)
217: 	{
218: 		// Spawn a powerup
219: 		DVector vF, vPos, vU;
220: 		DRotation rRot;
221: 
222: 		// We want the rotation aligned.
223: 		pServerDE->GetObjectRotation(m_hObject, &rRot);
224: 		pServerDE->GetRotationVectors(&rRot, &vU, &vPos, &vF);
225: 		vF.y = 0.0f;
226: 		VEC_SET(vU, 0,1,0);
227: 		pServerDE->AlignRotation(&rRot, &vF, &vU);
