1404: void CWeapon::CreateHandModel()
1405: {
1406: 	CServerDE* pServerDE = BaseClass::GetServerDE();
1407: 	if (!pServerDE || !m_pHandModelFilename || !m_pHandModelSkinname) return;
1408: 
1409: 	HCLASS hOwnerClass = pServerDE->GetObjectClass(m_hOwner);
1410: 
1411: 	DVector vPos;
1412: 	DRotation rRot;
1413: 	char* szNode = m_bLeftHand ? "l_gun" : "r_gun";
1414: 
1415: 	pServerDE->GetObjectPos(m_hOwner, &vPos);
1416: 
1417: 	// Create the hand view model
1418: 	ObjectCreateStruct ocStruct;
1419: 	INIT_OBJECTCREATESTRUCT(ocStruct);
1420: 
1421: 	ocStruct.m_ObjectType = OT_MODEL; 
1422: 	ocStruct.m_Flags = FLAG_VISIBLE | FLAG_FORCECLIENTUPDATE;
1423: 	VEC_COPY(ocStruct.m_Pos, vPos);
1424: 
1425: 	if(m_hClient)
1426: 	{
1427: 		ocStruct.m_UserData = pServerDE->GetClientID(m_hClient);
1428: 		if(m_bLeftHand)
1429: 			ocStruct.m_NextUpdate = 0.02f;
1430: 	}
1431: 	else
1432: 		ocStruct.m_UserData = 0;
1433: 
1434: 	_mbscpy((unsigned char*)ocStruct.m_Filename, (const unsigned char*)m_pHandModelFilename);
1435: 	_mbscpy((unsigned char*)ocStruct.m_SkinName, (const unsigned char*)m_pHandModelSkinname);
1436: 
1437: 	HCLASS hClass = pServerDE->GetClass("CHandWeaponModel");
1438: 	m_pHandModel = (CHandWeaponModel*)pServerDE->CreateObject(hClass, &ocStruct);
1439: 
1440: 	if (m_pHandModel && m_pHandModel->m_hObject)
1441: 	{
1442: 		// Set to the animation with the proper origin offset
1443: 		DDWORD dwAnim = pServerDE->GetAnimIndex(m_pHandModel->m_hObject, "handheld");
1444: 		if (dwAnim != INVALID_ANI)
1445: 			pServerDE->SetModelAnimation(m_pHandModel->m_hObject, dwAnim);
1446: 
1447: 		m_pHandModel->SetType(m_nType);
1448: 		m_pHandModel->SetPlayerOwned( IsPlayer( m_hOwner ));
1449: 		m_pHandModel->SetWeaponOwner( this );
1450: 
1451: 		if (m_hClient)
1452: 			m_pHandModel->SetClient(m_hClient, m_bLeftHand);
1453: 
1454: 		DVector vOffset;
1455: 		DRotation rRotOffset;
1456: 		VEC_INIT(vOffset);
1457: 		ROT_INIT(rRotOffset);
1458: 
1459: 		// Create an attachment and show the model if there is a node
1460: 		if (pServerDE->GetModelNodeTransform(m_hOwner, szNode, &vPos, &rRot))
1461: 		{
1462: 			pServerDE->CreateAttachment(m_hOwner, m_pHandModel->m_hObject, szNode, &vOffset, &rRotOffset, &m_hHandAttachment);
1463: 			m_pHandModel->SetVisible(DTRUE);
1464: 		}
1465: 		else
1466: 		{	// hide it
1467: 			pServerDE->CreateAttachment(m_hOwner, m_pHandModel->m_hObject, DNULL, &vOffset, &rRotOffset, &m_hHandAttachment);
1468: 			m_pHandModel->SetVisible(DFALSE);
1469: 		}
1470: 	}
1471: }
