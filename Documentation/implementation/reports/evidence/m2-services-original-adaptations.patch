-	INLINE_FN void dl_InitList(DList *pList)
-	{
-		dl_TieOff(&pList->m_Head);
-		pList->m_nElements = 0;
-	}
-
-	INLINE_FN void dl_AddAfter(DList *pList, DLink *pAfter, DLink *pLink, void *pObj)
-	{
-		pLink->m_pData = pObj;
