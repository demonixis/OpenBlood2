66: DBOOL PathMgr::GetPath(char* pBasePathName, PathList* pReturnList)
67: {
68: 	CServerDE* pServerDE = BaseClass::GetServerDE();
69: 	if (!pServerDE) return DFALSE;
70: 
71: 	if (!pBasePathName || !pReturnList || pBasePathName[0] == '\0') return DFALSE;
72: 
73: 	// Make sure we've got some keys to look through...
74: 
75: 	if (m_pathList.IsEmpty()) return DFALSE;
76: 
77: 
78: 	// Make sure we start with a clean slate...
79: 
80: 	if (!pReturnList->IsEmpty()) pReturnList->RemoveAll();
81: 
82: 
83: 	int nNumItems = m_pathList.GetNumItems();
84: 	int nNameLen  = _mbstrlen(pBasePathName);
85: 	if (nNameLen < 1) return DFALSE;
86: 
87: 	DList sortList;
88: 	dl_InitList(&sortList);
89: 	sortList.m_Head.m_pData = DNULL;
90: 
91: 	for (int i=0; i < nNumItems; i++)
92: 	{
93: 		PathListData* pCurData = m_pathList[i];
94: 		if (!pCurData || !pCurData->m_hstrName) return DFALSE;
95: 
96: 		char* pName = pServerDE->GetStringData(pCurData->m_hstrName);
97: 		if (!pName) return DFALSE;
98: 
99: 		if (strnicmp(pName, pBasePathName, nNameLen) == 0)
100: 		{
101: 			int nTestLen = _mbstrlen(pName);
102: 			
103: 			// Make sure the name is of the form BaseXXX where XXX is
104: 			// a number...
105: 
106: 			if (nTestLen > nNameLen)
107: 			{
108: 				if (isdigit(pName[nNameLen]))
109: 				{
110: 					AddToSortedList(&sortList, pCurData);
111: 				}
112: 			}
113: 		}
114: 	}
115: 
116: 	if (sortList.m_nElements < 1) return DFALSE;
117: 
118: 
119: 	// Copy the sorted list to the return list...
120: 
121: 	DLink* pLink = sortList.m_Head.m_pNext;
122: 
123: 	while (sortList.m_nElements > 0)
124: 	{
125: 		PathListData* pData = (PathListData*)pLink->m_pData;
126: 		if (pData)
127: 		{
128: 			pReturnList->Add(pData);
129: 		}
130: 
131: 		dl_RemoveAt(&sortList, pLink);
151: void PathMgr::AddToSortedList(DList* pSortList, PathListData* pCurData)
152: {
153: 	CServerDE* pServerDE = BaseClass::GetServerDE();
154: 	if (!pServerDE || !pSortList || !pCurData) return;
155: 
156: 	DLink* pLink = new DLink;
157: 	if (!pLink) return;
158: 
159: 	pLink->m_pNext = pLink->m_pPrev = DNULL;
160: 	pLink->m_pData = DNULL;
161: 
162: 	// Find where in the list we belong...
163: 
164: 	DLink* pCurPos    = &pSortList->m_Head;
165: 	DLink* pInsertPos = pCurPos;
166: 
167: 	while (pCurPos)
168: 	{
169: 		PathListData* pData = (PathListData*)pCurPos->m_pData;
170: 		if (!pData) break;
171: 
172: 		if (pServerDE->CompareStringsUpper(pCurData->m_hstrName, pData->m_hstrName) < 0)
173: 		{
174: 			break;
175: 		}
176: 
177: 		pInsertPos = pCurPos;
178: 		pCurPos	   = pCurPos->m_pNext;
179: 	}
180: 
181: 	dl_AddAfter(pSortList, pInsertPos, pLink, (void*)pCurData);
182: }

