45: 
46: DBOOL PathListData::Copy(HOBJECT hPathPoint)
47: {
48: 	CServerDE* pServerDE = BaseClass::GetServerDE();
49: 	if (!hPathPoint || !pServerDE) return DFALSE;
50: 
51:     // Get the Object Position
52: 	pServerDE->GetObjectPos(hPathPoint, &m_vPos);
53: 	char* pName = pServerDE->GetObjectName(hPathPoint);
54: 	if (pName)
55: 	{
56: 		m_hstrName = pServerDE->CreateString(pName);
57: 	}
58:     
59:     // Get the Objects action
60:     PathPoint *pPathPoint = (PathPoint*)pServerDE->HandleToObject(hPathPoint);
61: 
62:     HSTRING hstrAction = pPathPoint->GetActionTarget();
63: 	if (hstrAction)
64: 	{
65: 		m_hstrActionTarget = pServerDE->CopyString(hstrAction);
66: 	}
67: 
68:     hstrAction = pPathPoint->GetActionMessage();
69: 	if (hstrAction)
70: 	{
71: 		m_hstrActionMessage = pServerDE->CopyString(hstrAction);
72: 	}
73: 
74: 	return DTRUE;
75: }
