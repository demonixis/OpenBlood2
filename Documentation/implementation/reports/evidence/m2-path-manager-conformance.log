17: class PathList
18: {
19: 	public :
20: 
21: 		int GetNumItems()	const { return m_nNumItems; }
22: 		DBOOL IsEmpty()		const { return (DBOOL)(m_nNumItems == 0); }
23: 
24: 		void Load(HMESSAGEREAD hRead);
25: 		void Save(HMESSAGEWRITE hWrite);
26: 
27: 		PathList()
28: 		{
29: 			m_pArray		  = DNULL;
30: 			m_nNumItems		  = 0;
31: 			m_bDeleteElements = DFALSE;
32: 		}
33: 
34: 		DBOOL Init(DBOOL bDeleteElements=DTRUE)
35: 		{
36: 			m_pArray = new CDynArray<PathListData*> (DTRUE, 4);
37: 			if (!m_pArray) return DFALSE;
38: 
39: 			m_nNumItems	= 0;
40: 			m_bDeleteElements = bDeleteElements;
41: 
42: 			return DTRUE;
43: 		}
44: 
45: 		~PathList()
46: 		{
47: 			if (m_pArray)
48: 			{
49: 				if (m_bDeleteElements)
50: 				{
51: 					for (int i=0; i < m_nNumItems; i++)
52: 					{
53: 						delete (*m_pArray)[i];
54: 					}
55: 				}
56: 
57: 				delete m_pArray;
58: 			}
59: 		}
60: 
61: 		PathListData* & operator[] (int nIndex)
62: 		{
63: 			assert (nIndex >= 0 && nIndex < m_nNumItems && m_pArray);
64: 			return ((*m_pArray)[nIndex]);
65: 		}
66: 
67: 		void Add(PathListData* pFX)
68: 		{
69: 			if (m_pArray && pFX)
70: 			{
71: 				(*m_pArray)[m_nNumItems++] = pFX;
72: 			}
73: 		}
74: 
75: 		DBOOL Remove(PathListData* pFX, DBOOL bRebuildArray=DTRUE)
76: 		{
77: 			DBOOL bRet = DFALSE;
78: 			if (!m_pArray || !pFX) return DFALSE;
79: 
80: 			for (int i=0; i < m_nNumItems; i++)
81: 			{
82: 				if ((*m_pArray)[i] == pFX)
83: 				{
84: 					if (m_bDeleteElements)
85: 					{
86: 						delete (*m_pArray)[i];
87: 					}
88: 
89: 					(*m_pArray)[i] = DNULL;
90: 					bRet = DTRUE;
91: 					break;
92: 				}
93: 			}
94: 
95: 			if (bRet && bRebuildArray) RebuildArray();
96: 
97: 			return bRet;
98: 		}
99: 
100: 		DBOOL Remove(int nIndex, DBOOL bRebuildArray=DTRUE)
101: 		{
102: 			if (!m_pArray || nIndex < 0 || nIndex > m_nNumItems) return DFALSE;
103: 
104: 			if (m_bDeleteElements)
105: 			{
106: 				delete (*m_pArray)[nIndex];
107: 			}
108: 
109: 			(*m_pArray)[nIndex] = DNULL;
110: 
111: 			if (bRebuildArray) RebuildArray();
112: 
113: 			return DTRUE;
114: 		}
115: 
116: 		void RemoveAll()
117: 		{
118: 			if (m_pArray)
119: 			{
120: 				if (m_bDeleteElements)
121: 				{
122: 					for (int i=0; i < m_nNumItems; i++)
123: 					{
124: 						delete (*m_pArray)[i];
125: 					}
126: 				}
127: 
128: 				delete m_pArray;
129: 			}
130: 
131: 			m_pArray	= new CDynArray<PathListData*> (DTRUE, 8);
132: 			m_nNumItems = 0;
133: 		}
134: 
135: 		// Remove all NULL entries from the array...
136: 
137: 		void RebuildArray()
138: 		{
139: 			if (!m_pArray) return;
140: 
141: 			CDynArray<PathListData*> *pNewArray = new CDynArray<PathListData*> (DTRUE, 16);
142: 			if (!pNewArray) return;
143: 
144: 			int nNewCount = 0;
145: 			for (int i=0; i < m_nNumItems; i++)
146: 			{
147: 				if ((*m_pArray)[i])
148: 				{
149: 					(*pNewArray)[nNewCount++] = (*m_pArray)[i];
150: 				}
151: 			}
152: 
153: 			delete m_pArray;
154: 
155: 			m_pArray	= pNewArray;
156: 			m_nNumItems = nNewCount;
157: 		}
158: 	
159: 	private :
160: 
161: 		CDynArray<PathListData*> *m_pArray;	// Dynamic array 
162: 		int	m_nNumItems;					// Number of elements in array
163: 		DBOOL m_bDeleteElements;			// Who's in charge of clean up
164: 
165: };
166: 
167: inline void PathList::Save(HMESSAGEWRITE hWrite)
168: {
169: 	if (!g_pServerDE || !hWrite) return;
170: 
171: 	g_pServerDE->WriteToMessageFloat(hWrite, (DFLOAT)m_nNumItems);
172: 	g_pServerDE->WriteToMessageByte(hWrite, m_bDeleteElements);
173: 
174: 	if (m_pArray)
175: 	{
176: 		for (int i=0; i < m_nNumItems; i++)
177: 		{
178: 			if ((*m_pArray)[i])
179: 			{
180: 				(*m_pArray)[i]->Save(hWrite);
181: 			}
182: 		}
183: 	}
184: }
185: 
186: inline void PathList::Load(HMESSAGEREAD hRead)
187: {
188: 	if (!g_pServerDE || !hRead) return;
189: 
190: 	int nNumItems		= (int) g_pServerDE->ReadFromMessageFloat(hRead);
191: 	m_bDeleteElements	= (DBOOL) g_pServerDE->ReadFromMessageByte(hRead);
192: 
193: 	for (int i=0; i < nNumItems; i++)
194: 	{
195: 		PathListData* pData = new PathListData;
196: 		if (!pData) return;
197: 
198: 		pData->Load(hRead);
199: 		Add(pData);
200: 	}
201: }
202: 
203: #endif // __PATH_LIST_H__

