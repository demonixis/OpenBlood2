25: DBOOL PathMgr::BuildPathList()
26: {
27: 	CServerDE* pServerDE = BaseClass::GetServerDE();
28: 	if (!pServerDE) return DFALSE;
29: 	
30: 	ClearPathList();
31: 
32: 	// Iterate through the world building our list of keys, and removing 
33: 	// all the PathPoints found...
34: 
35: 	HCLASS  hPathPoint = pServerDE->GetClass("PathPoint");
36: 	HOBJECT	hCurObject = DNULL;
37: 	while (hCurObject = pServerDE->GetNextObject(hCurObject))
38: 	{
39: 		if (pServerDE->IsKindOf(pServerDE->GetObjectClass(hCurObject), hPathPoint))
40: 		{
41:             // Make sure its not a SMELL pathpoint!
42: 			PathListData* pKeyData = new PathListData;
43: 			if (!pKeyData) return DFALSE;
44: 
45: 			pKeyData->Copy(hCurObject);
46: 
47: 			m_pathList.Add(pKeyData);
48: 
49:             // Check for Debug console var, if found do not REMOVE from world!
50: //			pServerDE->RemoveObject(hCurObject);
51: 		}
52: 	}
53: 
54: 	return DTRUE;
55: }
