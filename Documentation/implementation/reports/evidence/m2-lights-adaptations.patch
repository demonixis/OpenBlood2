+                         {"IntensityMin", -10.0f},
+                         {"IntensityMax", 300.0f},
+                         {"RadiusMin", -4.0f},
+                         {"RadiusMax", 20000.0f},
+                         {"LifeTime", -1.0f}});
+        CHECK(h && light(g, h)->settings.intensity.min == 0 && light(g, h)->settings.intensity.max == 255 &&
