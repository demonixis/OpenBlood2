sources/blood2/ObjectDLL/AI_Mgr.cpp SHA256 05a1604d3b41223f0ddaf8bc77d66d00ea8886639e75b500cfea93e25115b7e7

3071: // ROUTINE		: AI_Mgr::CanSee
3072: // DESCRIPTION	: Check if we have visual of target
3073: // RETURN TYPE	: DBOOL 
3074: // PARAMS		: HOBJECT hTarget - who we want to see
3075: // ----------------------------------------------------------------------- //
3076: DBOOL AI_Mgr::CanSee( HOBJECT hTarget )
3077: {
3078: 	IntersectQuery IQuery;
3079: 	IntersectInfo IInfo;
3080: 	DVector vTargetHeadPos;
3081: 	DRotation rRot;
3082: 	DVector vMyPos, vObjPos;
3083: 	GlobalFilterFnData globalFilterFnData;
3084: 
3085: #ifdef _ADD_ON
3086: 	// The nightmare ALWAYS sees you.
3087: 	if(m_pServerDE->IsKindOf(m_pServerDE->GetObjectClass(m_hObject),
3088: 		m_pServerDE->GetClass("Nightmare")))
3089: 		return DTRUE;
3090: #endif
3091: 
3092: 	if(!m_pServerDE->GetModelNodeTransform(m_hObject,"head",&vMyPos,&rRot))
3093: 		VEC_COPY(vMyPos, m_MoveObj.GetPos());
3094: 
3095: 	m_pServerDE->GetObjectPos(hTarget, &vObjPos);
3096: 	
3097: 	VEC_COPY(IQuery.m_From, vMyPos);
3098: 	VEC_COPY(IQuery.m_To, vObjPos);
3099: 
3100: 	IQuery.m_Flags	  = INTERSECT_OBJECTS | IGNORE_NONSOLID;
3101: 	IQuery.m_FilterFn = GlobalFilterFn;
3102: 	globalFilterFnData.m_dwFlags = IGNORE_LIQUID | IGNORE_GLASS;
3103: 	globalFilterFnData.m_nIgnoreObjects = 1;
3104: 	globalFilterFnData.m_hIgnoreObjects = &m_hObject;
3105: 	IQuery.m_pUserData = &globalFilterFnData;	
3106: 
3107: 	if(m_pServerDE->IntersectSegment(&IQuery, &IInfo))
3108: 	{
3109: 		if( hTarget == IInfo.m_hObject)
3110: 			return DTRUE;
3111: 		else
3112: 		{
3113: 			// His body is blocked.  Check if we can see the little camper's head
3114: 			if( m_pServerDE->GetModelNodeTransform( hTarget, "head", &vTargetHeadPos, &rRot ))
3115: 			{
3116: 				VEC_COPY( IQuery.m_From, vMyPos );
3117: 				VEC_COPY( IQuery.m_To, vTargetHeadPos );
3118: 
3119: 				if( m_pServerDE->IntersectSegment( &IQuery, &IInfo ))
3120: 				{
3121: 					if( hTarget == IInfo.m_hObject )
3122: 						return DTRUE;
3123: 				}
3124: 			}
3125: 		}
3126: 	}
3127: 
3128: 	return DFALSE;
3129: }
3130: 

sources/blood2/ObjectDLL/ObjectUtilities.cpp SHA256 72d957398c9feb8147f4c76ca9073765a53b85071ebb381005685e70700770d3

412: DBOOL GlobalFilterFn(HOBJECT hObj, void *pUserData)
413: {
414: 	DDWORD dwObject;
415: 	GlobalFilterFnData *pGlobalFilterFnData;
416: 	if (!hObj || !g_pServerDE) return DFALSE;
417: 
418: 	if( !pUserData )
419: 		return DTRUE;
420: 
421: 	pGlobalFilterFnData = ( GlobalFilterFnData * )pUserData;
422: 
423: 	if( pGlobalFilterFnData->m_nIgnoreObjects && pGlobalFilterFnData->m_hIgnoreObjects )
424: 	{
425: 		for( dwObject = 0; dwObject < pGlobalFilterFnData->m_nIgnoreObjects; dwObject++ )
426: 		{
427: 			if( pGlobalFilterFnData->m_hIgnoreObjects[dwObject] == hObj )
428: 				return DFALSE;
429: 		}
430: 	}
431: 
432: 	HCLASS hObjClass	= g_pServerDE->GetObjectClass(hObj);
433: 	BaseClass* pObj = (BaseClass*)g_pServerDE->HandleToObject(hObj);			
434: 
435: 	if( pGlobalFilterFnData->m_dwFlags & IGNORE_CHARACTER)
436: 	{
437: 		HCLASS hCharacter = g_pServerDE->GetClass("CBaseCharacter");
438: 
439: 		if(g_pServerDE->IsKindOf(hObjClass, hCharacter))
440: 			return DFALSE;
441: 	}
442: 
443: 	if( pGlobalFilterFnData->m_dwFlags & IGNORE_LIQUID)
444: 	{
445: 		HCLASS hLiquid	= g_pServerDE->GetClass("VolumeBrush");
446: 
447: 		if(g_pServerDE->IsKindOf(hObjClass, hLiquid))
448: 			return DFALSE;
449: 	}
450: 
451: 	if( pGlobalFilterFnData->m_dwFlags & IGNORE_DESTRUCTABLE)
452: 	{
453: 		HCLASS hDestruct = g_pServerDE->GetClass("CDestructableModel");
454: 
455: 		if(g_pServerDE->IsKindOf(hObjClass, hDestruct))
456: 		{
457: 			CDestructableModel* pModel = (CDestructableModel*)g_pServerDE->HandleToObject(hObj);			
458: 
459: 			if(pModel->IsDestructable())
460: 				return DFALSE;
461: 		}
462: 	}
463: 
464: 	if( pGlobalFilterFnData->m_dwFlags & IGNORE_GLASS)
465: 	{
466: 		HCLASS hBrush = g_pServerDE->GetClass("CDestructableBrush");
467: 
468: 		if(g_pServerDE->IsKindOf(hObjClass, hBrush))
469: 		{
470: 			CDestructableBrush* pBrush = (CDestructableBrush*)g_pServerDE->HandleToObject(hObj);			
471: 
472: 			if(pBrush->GetSurfaceType() == SURFTYPE_GLASS && pBrush->IsDestructable())
473: 				return DFALSE;
474: 		}
475: 	}
476: 
477: 	return DTRUE;

