607: // Called by the WorldTree in IntersectSegment.
608: static bool i_ISCallback(WorldTreeObj *pObj, void *pCBUser) 
609: {    
610:     ASSERT(pObj->GetObjType() == WTObj_DObject);
611:     LTObject *pObject = (LTObject*)pObj;
612:     
613:     if (pObject->m_Flags & (FLAG_RAYHIT|FLAG_SOLID) || g_bProcessNonSolid) 
614: 	{
615:         // Honor the INTERSECT_OBJECTS flag (or lack thereof...)
616:         if (!g_bProcessObjects && !pObject->IsMainWorldModel()) 
617: 		{
618:             return false;
619:         }
620: 
621:         // Hit the object if it has the ray hit flag, is solid, or if non-solid and it
622:         // query doesn't have ignore non-solid...
623:         // This is basically everything except for objects with only touch-notify...
624:         // Do further tests..
625:         return i_HandlePossibleIntersection(g_pCurQuery->m_From, g_pCurQuery->m_To, pObject);
626:     }
