+        h = make(g,
+                 {{"FlushWithWorld", true}, {"Repeat", true}, {"RepeatY", std::int32_t(2)}, {"DifficultyMed", false}});
+        c = get(g, h);
+        CHECK(c && c->filtered && c->children.size() == 1);
+        auto child = c->children[0];
+        CHECK(g.objects.finish_frame() && !g.objects.get(h) && g.objects.get(child));
+        return true;
+    }
