+        for (size_t i = 1; i < m->animations[0].keys.size(); ++i)
+            m->animations[0].keys[i].text.clear();
+        r->model = m;
+        ObjectCreateStruct sensor;
+        sensor.m_Pos = {2, 0, 0};
+        sensor.m_Flags = FLAG_TOUCH_NOTIFY;
