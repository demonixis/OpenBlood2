+        CHECK(g.objects.get(p->m_hObject)->state.m_Pos.x == pos.x);
+        return true;
+    }
+    bool catalog(const std::filesystem::path& root)
+    {
+        GameSession g;
+        CHECK(g.initialize());
+        Config config;
+        config.data_dir = root;
+        std::string error;
+        CHECK(g.resources.mount_game(config, error));
