diff --git a/src/engine/shaders/sprite_frag_msl.h b/src/engine/shaders/sprite_frag_msl.h
new file mode 100644
index 0000000..8f7753d
--- /dev/null
+++ b/src/engine/shaders/sprite_frag_msl.h
@@ -0,0 +1,38 @@
+#pragma once
+// Generated by pinned SDL_shadercross; see tools/shaders and GenerateWorldShaders.cmake.
+static constexpr unsigned sprite_frag_samplers = 1;
+static constexpr unsigned sprite_frag_uniforms = 1;
+static const char sprite_frag_msl[] = R"blood2msl(#include <metal_stdlib>
+#include <simd/simd.h>
+
+using namespace metal;
+
+struct Sprite
+{
+    float4 modulation;
+};
+
+struct main0_out
+{
+    float4 color [[color(0)]];
+};
+
+struct main0_in
+{
+    float3 faceColor [[user(locn0)]];
+    float2 texCoord [[user(locn1)]];
+};
+
+fragment main0_out main0(main0_in in [[stage_in]], constant Sprite& u [[buffer(0)]], texture2d<float> albedo [[texture(0)]], sampler albedoSmplr [[sampler(0)]])
+{
+    main0_out out = {};
+    float4 texel = albedo.sample(albedoSmplr, in.texCoord);
+    if (texel.w == 0.0)
+    {
+        discard_fragment();
+    }
+    out.color = float4(texel.xyz * in.faceColor, texel.w * u.modulation.x);
+    return out;
+}
+
+)blood2msl";
