+#pragma once
+// Generated by pinned SDL_shadercross; see tools/shaders and GenerateWorldShaders.cmake.
+static constexpr unsigned world_vert_samplers = 0;
+static constexpr unsigned world_vert_uniforms = 1;
+static const char world_vert_msl[] = R"blood2msl(#include <metal_stdlib>
+#include <simd/simd.h>
+
+using namespace metal;
+
+struct View
+{
+    float4 eye;
+    float4 right;
+    float4 up;
+    float4 forward;
+    float4 projection;
+    float4 translation;
+    float4 quaternion;
+    float4 _textureOffset;
+};
+
+struct main0_out
+{
+    float3 faceColor [[user(locn0)]];
+    float2 texCoord [[user(locn1)]];
+    float4 gl_Position [[position]];
+};
+
+struct main0_in
+{
+    float3 position [[attribute(0)]];
+    float3 color [[attribute(1)]];
+    float2 uv [[attribute(2)]];
+};
+
+vertex main0_out main0(main0_in in [[stage_in]], constant View& u [[buffer(0)]])
+{
+    main0_out out = {};
+    float3 q = u.quaternion.xyz;
+    float3 world = (in.position + (cross(q, cross(q, in.position) + (in.position * u.quaternion.w)) * 2.0)) + u.translation.xyz;
+    float3 relative = world - u.eye.xyz;
+    float z = dot(relative, u.forward.xyz);
+    out.gl_Position = float4(dot(relative, u.right.xyz) * u.projection.x, dot(relative, u.up.xyz) * u.projection.y, (z * u.projection.z) + u.projection.w, z);
+    out.faceColor = in.color;
+    out.texCoord = in.uv + u._textureOffset.xy;
+    return out;
+}
+
+)blood2msl";
