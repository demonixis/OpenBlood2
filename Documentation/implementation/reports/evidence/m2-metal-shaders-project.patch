diff --git a/tests/world_shader_tests.cpp b/tests/world_shader_tests.cpp
new file mode 100644
index 0000000..4937bcf
--- /dev/null
+++ b/tests/world_shader_tests.cpp
@@ -0,0 +1,68 @@
+#include "engine/world_shaders.h"
+#include "engine/world_view.h"
+#include <array>
+#include <cstring>
+#include <iostream>
+#include <string_view>
+using namespace OpenBlood2;
+#define CHECK(x)                                                                                                       \
+    do                                                                                                                 \
+    {                                                                                                                  \
+        if (!(x))                                                                                                      \
+        {                                                                                                              \
+            std::cerr << __LINE__ << ": " #x "\n";                                                                     \
+            return 1;                                                                                                  \
+        }                                                                                                              \
+    } while (false)
+int main()
+{
+    static_assert(sizeof(WorldViewUniform) == 8 * 16); // std140/Metal float4 uniform layout.
+    CHECK(WorldShaderFormats == (SDL_GPU_SHADERFORMAT_SPIRV | SDL_GPU_SHADERFORMAT_MSL));
+    SDL_GPUShaderCreateInfo info{};
+    for (auto formats : {SDL_GPU_SHADERFORMAT_SPIRV, SDL_GPU_SHADERFORMAT_MSL, WorldShaderFormats})
+        for (auto shader : {WorldShader::Vertex, WorldShader::OpaqueFragment, WorldShader::AlphaFragment})
+        {
+            CHECK(world_shader_info(shader, formats, info));
+            CHECK(info.code && info.code_size > 128 && info.props == 0);
+            CHECK(info.num_storage_buffers == 0 && info.num_storage_textures == 0);
+            CHECK(info.num_samplers == (shader == WorldShader::Vertex ? 0u : 1u));
+            CHECK(info.num_uniform_buffers == (shader == WorldShader::OpaqueFragment ? 0u : 1u));
+            CHECK(info.stage ==
+                  (shader == WorldShader::Vertex ? SDL_GPU_SHADERSTAGE_VERTEX : SDL_GPU_SHADERSTAGE_FRAGMENT));
+            if (formats & SDL_GPU_SHADERFORMAT_SPIRV)
+            {
+                CHECK(info.format == SDL_GPU_SHADERFORMAT_SPIRV && std::strcmp(info.entrypoint, "main") == 0);
+                const unsigned char magic[] = {3, 2, 35, 7};
+                CHECK(std::memcmp(info.code, magic, 4) == 0 && info.code_size % 4 == 0);
+            }
+            else
+            {
+                CHECK(info.format == SDL_GPU_SHADERFORMAT_MSL && std::strcmp(info.entrypoint, "main0") == 0);
+                const std::string_view source(reinterpret_cast<const char*>(info.code), info.code_size);
+                CHECK(source.starts_with("#include <metal_stdlib>"));
+                CHECK(info.code[info.code_size] == 0); // Runtime Metal compilation also gets terminated source.
+                CHECK(source.find(shader == WorldShader::Vertex ? "vertex main0_out main0("
+                                                                : "fragment main0_out main0(") != source.npos);
+                if (info.num_uniform_buffers)
+                    CHECK(source.find("[[buffer(0)]]") != source.npos);
+                if (info.num_samplers)
+                    CHECK(source.find("[[texture(0)]]") != source.npos && source.find("[[sampler(0)]]") != source.npos);
+                if (shader == WorldShader::Vertex)
+                    CHECK(source.find("u._textureOffset.xy") != source.npos);
+            }
+            const auto* owned = info.code;
+            SDL_GPUShaderCreateInfo repeated{};
+            CHECK(world_shader_info(shader, formats, repeated) && repeated.code == owned &&
+                  repeated.code_size == info.code_size);
+        }
+    for (SDL_GPUShaderFormat formats : std::array<SDL_GPUShaderFormat, 3>{
+             SDL_GPU_SHADERFORMAT_INVALID, SDL_GPU_SHADERFORMAT_DXIL, SDL_GPU_SHADERFORMAT_METALLIB})
+    {
+        CHECK(!world_shader_info(WorldShader::Vertex, formats, info));
+        CHECK(!info.code && !info.code_size && !info.entrypoint);
+    }
+    CHECK(!world_shader_info(static_cast<WorldShader>(999), WorldShaderFormats, info) && !info.code);
+    std::cout << "Shader selection: SPIR-V/MSL stages, generated entry points, reflected bindings, static lifetime and "
+                 "unsupported formats pass; native Metal compilation not exercised\n";
+    return 0;
+}
diff --git a/tools/shaders/CMakeLists.txt b/tools/shaders/CMakeLists.txt
new file mode 100644
index 0000000..7468caf
--- /dev/null
+++ b/tools/shaders/CMakeLists.txt
@@ -0,0 +1,46 @@
+cmake_minimum_required(VERSION 3.28)
+project(Blood2ShaderTools LANGUAGES C CXX)
+# Optional offline toolchain, never linked into the game. Point SDL3_DIR at the
+# configured game's _deps/sdl3-build directory (build SDL3-static there first).
+find_package(SDL3 3.1.3 REQUIRED CONFIG)
+include(FetchContent)
+get_filename_component(BLOOD2_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/../.." ABSOLUTE)
+
+# SDL_shadercross main resolved 2026-10-17; SPIRV-Cross is its exact submodule.
+set(BLOOD2_SHADERCROSS_REVISION 1ff05bec573988a98ef9e0260b4da44f512b8367)
+set(BLOOD2_SPIRVCROSS_REVISION 1a6169566c73d3da552748fc372fe2bbb856e46e)
+set(SPIRV_CROSS_CLI OFF CACHE BOOL "" FORCE)
+set(SPIRV_CROSS_ENABLE_TESTS OFF CACHE BOOL "" FORCE)
+# Keep dependency export sets for shadercross's static-library export, even
+# though this project never installs either dependency.
+set(SPIRV_CROSS_SKIP_INSTALL OFF CACHE BOOL "" FORCE)
+set(SPIRV_CROSS_STATIC ON CACHE BOOL "" FORCE)
+set(SPIRV_CROSS_SHARED OFF CACHE BOOL "" FORCE)
+FetchContent_Declare(spirvcross
+    URL https://codeload.github.com/KhronosGroup/SPIRV-Cross/tar.gz/${BLOOD2_SPIRVCROSS_REVISION}
+    URL_HASH SHA256=0f295b214b164e42a1d21537c8da7b44569806c16220dda9798558edfaacd11e
+    DOWNLOAD_NAME SPIRV-Cross-${BLOOD2_SPIRVCROSS_REVISION}.tar.gz
+    DOWNLOAD_DIR "${BLOOD2_ROOT}/.cache/downloads"
+    DOWNLOAD_EXTRACT_TIMESTAMP TRUE SYSTEM EXCLUDE_FROM_ALL)
+FetchContent_MakeAvailable(spirvcross)
+# Upstream's non-vendored find guard uses this spelling, while its link target
+# uses spirv-cross-c. Both refer to the same pinned build; no system fallback.
+add_library(spirv_cross_c ALIAS spirv-cross-c)
+set(SDLSHADERCROSS_DXC OFF CACHE BOOL "" FORCE)
+set(SDLSHADERCROSS_SHARED OFF CACHE BOOL "" FORCE)
+set(SDLSHADERCROSS_STATIC ON CACHE BOOL "" FORCE)
+set(SDLSHADERCROSS_SPIRVCROSS_SHARED OFF CACHE BOOL "" FORCE)
+set(SDLSHADERCROSS_CLI ON CACHE BOOL "" FORCE)
+set(SDLSHADERCROSS_CLI_STATIC ON CACHE BOOL "" FORCE)
+set(SDLSHADERCROSS_INSTALL OFF CACHE BOOL "" FORCE)
+FetchContent_Declare(shadercross
+    URL https://codeload.github.com/libsdl-org/SDL_shadercross/tar.gz/${BLOOD2_SHADERCROSS_REVISION}
+    URL_HASH SHA256=60aae35ff71bd1d5f85b363e9d077a86bb27dd36333c42685e56c2fd541174d2
+    DOWNLOAD_NAME SDL_shadercross-${BLOOD2_SHADERCROSS_REVISION}.tar.gz
+    DOWNLOAD_DIR "${BLOOD2_ROOT}/.cache/downloads"
+    DOWNLOAD_EXTRACT_TIMESTAMP TRUE SYSTEM EXCLUDE_FROM_ALL)
+FetchContent_MakeAvailable(shadercross)
+add_custom_target(regenerate
+    COMMAND "${CMAKE_COMMAND}" "-DSHADERCROSS=$<TARGET_FILE:shadercross>"
+        -P "${BLOOD2_ROOT}/cmake/GenerateWorldShaders.cmake"
+    DEPENDS shadercross VERBATIM)
