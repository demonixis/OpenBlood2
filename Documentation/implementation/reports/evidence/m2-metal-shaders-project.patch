+static const char world_frag_msl[] = R"blood2msl(#include <metal_stdlib>
+#include <simd/simd.h>
+
+using namespace metal;
+
+struct main0_out
+{
+    float4 color [[color(0)]];
+};
+
+struct main0_in
+{
+    float3 faceColor [[user(locn0)]];
+    float2 texCoord [[user(locn1)]];
+};
+
+fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> albedo [[texture(0)]], sampler albedoSmplr [[sampler(0)]])
+{
+    main0_out out = {};
+    out.color = float4(albedo.sample(albedoSmplr, in.texCoord).xyz * in.faceColor, 1.0);
