  "commands": [
    "cmake --build build/<debug|release|sanitize> -j3 --target blood2_app spark_tests blood_spurt_tests blood_splat_tests death_effect_tests corpse_tests weapon_impact_tests weapon_sprite_tests object_contract_tests world_tests player_controls_tests",
    "cmake --build build/<debug|release> -j3 --target spark_gpu_tests blood_spurt_gpu_tests blood_splat_gpu_tests death_effect_gpu_tests level_change_gpu_tests",
    "ctest --test-dir build/<debug|release> -R '^(sparks|blood_spurts|blood_splats|corpses|death_effects|weapon_impacts|weapon_sprites|objects|player_controls)\\.|^world\\.(level_change.*|destination_.*)$' -V -j2",
    "ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 ctest --test-dir build/sanitize -R '^(sparks|blood_spurts|blood_splats|corpses|death_effects|weapon_impacts|weapon_sprites|objects|player_controls)\\.|^world\\.(level_change.*|destination_.*)$' -V -j2",
    "VK_DRIVER_FILES=/usr/share/vulkan/icd.d/nvidia_icd.x86_64.json ctest --test-dir build/<debug|release> -R '^gpu\\.(sparks_private|blood_spurt|blood_spurt_private|blood_splat_alpha|blood_splat_private|death_effects|level_change|mouse_combat|corpse_clearance)$' -V"
  ],
  "development_findings": [
    "The source retains empty detached spark systems until list eviction. The port reclaims only exhausted invisible systems strictly after duration; class behavior remains directly tested.",
    "Review reproduced a 30 Hz precision tail: the double clock crosses duration while float particle lifetimes retain sub-microsecond values. Presentation clamps negative alpha to zero; source raw alpha and particle clocks remain inspected/tested.",
    "Existing authored combat/corpse assertions and timeouts are unchanged."
  ],
  "limitations": [
    "Selected flesh/metal weapon sparks only; underwater bubbles, generic/fade-color callers, shared eviction and other required M2 services remain unavailable.",
    "Portable cosmetic RNG, later-engine AddParticles interpolation and existing particle rasterization are documented adaptations, not retail parity.",
    "Diagnostic private floor and assets are not complete campaign traversal.",
    "No native Metal run, shader/dependency/reference/asset modifications this increment."
  ],
