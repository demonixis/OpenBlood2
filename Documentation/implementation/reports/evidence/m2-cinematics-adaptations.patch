+    bool failures(const std::filesystem::path& root)
+    {
+        GameSession g;
+        CHECK(setup(g, root));
+        auto h = cine(g, {{"Sound1", std::string("missing.wav")}});
+        CHECK(h && trigger(g, h));
+        auto* c = get(g, h);
+        CHECK(g.step(.01) && c->starts == 1 && c->failures == 1 && !c->sound && c->current == 0 && !c->error.empty());
+        CHECK(g.step(.01) && c->starts == 2 && c->failures == 2 &&
