+#define CHECK(x)                                                                                                       \
+    do                                                                                                                 \
+    {                                                                                                                  \
+        if (!(x))                                                                                                      \
+        {                                                                                                              \
+            std::cerr << __func__ << ':' << __LINE__ << ": " #x "\n";                                                  \
+            return false;                                                                                              \
