+                continue;
+            if (!game.objects.get(brush_selection))
+                brush_selection = id;
+            auto label = std::string(r->state.m_Name) + ((r->state.m_Flags & FLAG_VISIBLE) ? "" : " [hidden]") +
+                         (r->activity == OBJSTATE_ACTIVE ? "" : " [inactive]");
