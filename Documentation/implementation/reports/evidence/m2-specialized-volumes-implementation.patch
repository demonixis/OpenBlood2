+    bool conveyor_motion(const std::filesystem::path& root)
+    {
+        GameSession game;
+        CHECK(enter(game, root));
+        auto belt =
+            volume(game, "Conveyor", "belt", {-500, 0, -500}, {500, 900, 500}, {{"Current", DVector{2400, 0, 0}}});
