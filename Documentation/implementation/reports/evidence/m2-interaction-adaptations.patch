diff --git a/src/game/original/PlayerUse.cpp b/src/game/original/PlayerUse.cpp
new file mode 100644
index 0000000..3292108
--- /dev/null
+++ b/src/game/original/PlayerUse.cpp
@@ -0,0 +1,69 @@
+#include "Door.h"
+#include "PlayerObj.h"
+#include "RotatingDoor.h"
+#include "engine/collision.h"
+#include <cmath>
+using namespace OpenBlood2;
+
+// PlayerObj.cpp OnCommandOn(COMMAND_USE), ordinary single-player branch.
+// Dead multiplayer respawn / slow-death rescue are outside the accepted session.
+bool CPlayerObj::OnCommandUse()
+{
+    if (!g_pServerDE->IsObjectAlive(m_hObject) || movement_blocked)
+        return false;
+    ++use_commands;
+    use_hit = {};
+    use_door_refused = false;
+    g_pServerDE->GetObjectPos(m_hObject, &use_from);
+    use_from.y += eye_level;
+    const float cp = std::cos(m_fPitch);
+    const DVector forward{std::sin(m_fYaw) * cp, -std::sin(m_fPitch), std::cos(m_fYaw) * cp};
+    use_to = vector_add(use_from, vector_scale(forward, 82));
+    // Self is excluded explicitly: the source ray normally starts inside its
+    // player box and the old engine reports entry faces, not interior starts.
+    use_result = g_pServerDE->IntersectSegment(use_from, use_to, m_hObject, use_hit, false, SegmentObjects::All);
+    if (use_result == SegmentResult::Invalid || use_result == SegmentResult::Unavailable)
+        return false;
+    if (use_result != SegmentResult::Hit || !use_hit.object)
+        return true;
+    use_door_refused =
+        g_pServerDE->IsKindOf(g_pServerDE->GetObjectClass(use_hit.object), g_pServerDE->GetClass("Door"));
+    if (use_door_refused)
+        return true;
+    auto message = g_pServerDE->StartMessageToObject(this, use_hit.object, 1000);
+    if (!message)
+        return false;
+    const auto written = g_pServerDE->WriteToMessageHString(message, m_hstrTrigger);
+    const auto sent = g_pServerDE->EndMessage(message);
+    if (written != DE_OK || sent != DE_OK)
+        return false;
+    ++use_messages;
+    return true;
+}
+
+// PlayerObj.cpp ObjectTouch / UpdateClientPhysics rotating-door push branch.
+void CPlayerObj::ObjectTouchDoor(HOBJECT object)
+{
+    if (door_push_pending || !g_pServerDE->IsObjectAlive(object))
+        return;
+    const auto* door = dynamic_cast<RotatingDoor*>(g_pServerDE->HandleToObject(object));
+    if (!door || door->state != Door::Opening || !door->push_player_back)
+        return;
+    DRotation rotation;
+    g_pServerDE->GetObjectRotation(m_hObject, &rotation);
+    door_push_velocity = rotate_vector({0, 0, -500}, rotation);
+    door_push_pending = true;
+    ++door_pushes;
+}
+bool CPlayerObj::ApplyDoorPush()
+{
+    if (!door_push_pending)
+        return true;
+    DVector velocity;
+    g_pServerDE->GetVelocity(m_hObject, &velocity);
+    velocity = vector_add(velocity, door_push_velocity);
+    if (g_pServerDE->SetVelocity(m_hObject, &velocity) != DE_OK)
+        return false;
+    door_push_pending = false;
+    return true;
+}
diff --git a/src/game/original/RotatingDoor.cpp b/src/game/original/RotatingDoor.cpp
new file mode 100644
index 0000000..7822075
--- /dev/null
+++ b/src/game/original/RotatingDoor.cpp
@@ -0,0 +1,111 @@
+#include "RotatingDoor.h"
+#include "engine/collision.h"
+#include "engine/objects.h"
+#include <cmath>
+#include <numbers>
+using namespace OpenBlood2;
+
+DDWORD RotatingDoor::EngineMessageFn(DDWORD message, void* data, DFLOAT reason)
+{
+    constexpr float radians = std::numbers::pi_v<float> / 180;
+    if (message == MID_PRECREATE)
+    {
+        if (!Door::EngineMessageFn(message, data, reason))
+            return 0;
+        g_pServerDE->GetPropVector("RotationAngles", &rotation_angles);
+        g_pServerDE->GetPropVector("RotationPoint", &rotation_point);
+        GenericProp prop;
+        if (g_pServerDE->GetPropGeneric("Rotation", &prop) == DE_OK)
+            angles = prop.m_Vec;
+        const auto expected = rotation_from_euler(angles);
+        const auto actual = static_cast<ObjectCreateStruct*>(data)->m_Rotation;
+        if (std::abs(vector_dot(expected.m_Vec, actual.m_Vec) + expected.m_Spin * actual.m_Spin) < .99999f)
+            return 0;
+        DBOOL push = DTRUE;
+        g_pServerDE->GetPropBool("PushPlayerBack", &push);
+        push_player_back = push != 0;
+        if (!physics_vector(rotation_angles) || !physics_vector(rotation_point) || !physics_vector(angles))
+            return 0;
+        speed *= radians;
+        closing_speed *= radians;
+        return 1;
+    }
+    if (message == MID_INITIALUPDATE)
+    {
+        closed_angles = angles;
+        open_angles = vector_add(angles, vector_scale(rotation_angles, radians));
+        g_pServerDE->GetObjectPos(m_hObject, &original_position);
+        // Retain the source's asymmetric < +1 degree comparison (including zero).
+        const auto direction = [&](float offset) { return offset > radians ? -1.0f : offset < radians ? 1.0f : 0.0f; };
+        open_direction = {direction(closed_angles.x - open_angles.x), direction(closed_angles.y - open_angles.y),
+                          direction(closed_angles.z - open_angles.z)};
+    }
+    return Door::EngineMessageFn(message, data, reason);
+}
+bool RotatingDoor::CalcAngle(float& angle, float initial, float target, int direction, float speed, unsigned wave,
+                             float dt)
+{
+    // Defined zero-span guard for the source's 0/0; retain its duplicated increment
+    // and late endpoint clamp. This can overshoot for one update.
+    if (initial == target)
+    {
+        angle = target;
+        return true;
+    }
+    const float percent = 1 - (target - angle) / (target - initial);
+    const float amount = GetWaveValue(speed, percent, wave) * dt;
+    bool done = direction == 0;
+    for (int pass = 0; pass < 2; ++pass)
+    {
+        if (direction > 0)
+        {
+            if (angle < target)
+                angle += amount;
+            else
+            {
+                angle = target;
+                done = true;
+            }
+        }
+        else if (direction < 0)
+        {
+            if (angle > target)
+                angle -= amount;
+            else
+            {
+                angle = target;
+                done = true;
+            }
+        }
+    }
+    return done;
+}
+void RotatingDoor::Move(bool opening)
+{
+    if (opening && !started_moving)
+    {
+        started_moving = true;
+        StartSound(open_busy, true);
+        portal_open = true;
+    }
+    const auto initial = opening ? closed_angles : open_angles;
+    const auto target = opening ? open_angles : closed_angles;
+    const auto direction = vector_scale(open_direction, opening ? 1.0f : -1.0f);
+    auto next = angles;
+    const auto velocity = opening ? speed : closing_speed;
+    const auto dt = g_pServerDE->GetFrameTime();
+    const bool x = CalcAngle(next.x, initial.x, target.x, static_cast<int>(direction.x), velocity, waveform, dt);
+    const bool y = CalcAngle(next.y, initial.y, target.y, static_cast<int>(direction.y), velocity, waveform, dt);
+    const bool z = CalcAngle(next.z, initial.z, target.z, static_cast<int>(direction.z), velocity, waveform, dt);
+    last_move = g_pServerDE->RotateWorldModel(m_hObject, {angles, next, original_position, rotation_point});
+    if (last_move != MoverResult::Moved)
+        return;
+    angles = next;
+    if (x && y && z)
+    {
+        if (opening)
+            SetOpen();
+        else
+            SetClosed();
+    }
+}
