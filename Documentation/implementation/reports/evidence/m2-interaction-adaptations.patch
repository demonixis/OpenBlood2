+        p->eye_level = 12;
+        CHECK(p->OnCommandUse() && p->use_result == SegmentResult::Miss && near(p->use_from.y, 62));
+        g.objects.get(t)->state.m_Pos.y = 62;
+        CHECK(p->OnCommandUse() && p->use_hit.object == t);
