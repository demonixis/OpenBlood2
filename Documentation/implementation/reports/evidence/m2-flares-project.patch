diff --git a/tests/flare_fixture.h b/tests/flare_fixture.h
new file mode 100644
index 0000000..159d23e
--- /dev/null
+++ b/tests/flare_fixture.h
@@ -0,0 +1,70 @@
+#pragma once
+#include "energy_fixture.h"
+#include "game/original/FlareProjectile.h"
+#include "game/original/WeaponPickups.h"
+namespace test_flare
+{
+    using namespace OpenBlood2;
+    inline bool mount(GameSession& g, const std::filesystem::path& root)
+    {
+        test_player::Directory dir;
+        test_model::Writer sprite;
+        for (auto n : {1u, 15u, 1u, 1u, 0u})
+            sprite.u32(n);
+        std::string frame = "alpha.dtx";
+        sprite.u16(frame.size());
+        sprite.b.insert(sprite.b.end(), frame.begin(), frame.end());
+        dir.children["sprites"].files["lensflare32.spr"] = sprite.b;
+        for (auto name : {"flarepistol_pv.abc", "lh_flarepistol_pv.abc"})
+            dir.children["models"].children["weapons"].files[name] = test_model::abc(true).b;
+        dir.children["models"].children["powerups"].files["flarepistol_pu.abc"] = test_model::abc(true).b;
+        dir.children["skins"].children["weapons"].files["c_flare_pv_t.dtx"] = {1, 2, 3};
+        dir.children["skins"].children["powerups"].files["flarepistol_pu.dtx"] = {1, 2, 3};
+        for (auto name : {"fire.wav", "alt.wav", "projectile.wav", "impact.wav"})
+            dir.children["sounds"].children["weapons"].children["flare"].files[name] = test_audio::wave();
+        test_model::Writer w;
+        w.b.resize(168);
+        w.b[0] = w.b[62] = w.b[124] = 13;
+        w.b[1] = w.b[63] = w.b[125] = 10;
+        w.b[126] = 26;
+        w.patch(127, 1);
+        const auto [offset, size] = test_player::write_dir(w, dir);
+        w.patch(131, offset);
+        w.patch(135, size);
+        auto file = root / "flare.rez";
+        std::ofstream out(file, std::ios::binary);
+        out.write(reinterpret_cast<const char*>(w.b.data()), w.b.size());
+        out.close();
+        std::string error;
+        return test_naga::mount(g.resources, root, error) && g.resources.mount(file, error);
+    }
+    inline bool setup(GameSession& g, const std::filesystem::path& root)
+    {
+        return test_player::setup(g, root) && mount(g, root);
+    }
+    template <class T = CFlareProjectile>
+    T* projectile(GameSession& g, HOBJECT owner, DVector pos, DVector dir = {0, 0, 1}, float speed = 2000,
+                  int radius = 100)
+    {
+        const char* name = std::is_same_v<T, CFlareProjectile>      ? "CFlareProjectile"
+                           : std::is_same_v<T, CFlareAltProjectile> ? "CFlareAltProjectile"
+                                                                    : "CFlareBurstProjectile";
+        ObjectCreateStruct state;
+        state.m_Pos = pos;
+        legacy_copy(state.m_Name, name);
+        auto* p = dynamic_cast<T*>(g.server.CreateObject(g.server.GetClass(name), &state));
+        return p && p->Setup(dir, 3, 20, speed, radius, owner) ? p : nullptr;
+    }
+    inline bool equip(GameSession& g)
+    {
+        auto* p = g.server_shell.Player(g.local_client);
+        if (!p)
+            return false;
+        auto& inv = p->m_InventoryMgr;
+        if (inv.ObtainWeapon(3, 2) != InventoryResult::Ok || inv.ObtainWeapon(3, 2) != InventoryResult::Ok)
+            return false;
+        inv.SetAmmoCount(4, 200);
+        std::string error;
+        return g.select_weapon(2, error);
+    }
+} // namespace test_flare
diff --git a/tests/flare_gpu_tests.cpp b/tests/flare_gpu_tests.cpp
new file mode 100644
index 0000000..cf3fc2d
--- /dev/null
+++ b/tests/flare_gpu_tests.cpp
@@ -0,0 +1,113 @@
+#include "app/sprite_scene.h"
+#include "engine/capture.h"
+#include "engine/runtime.h"
+#include "engine/world_renderer.h"
+#include "flare_fixture.h"
+using namespace OpenBlood2;
+#define CHECK(x)                                                                                                       \
+    do                                                                                                                 \
+    {                                                                                                                  \
+        if (!(x))                                                                                                      \
+        {                                                                                                              \
+            std::cerr << __LINE__ << ": " #x " " << error << " " << SDL_GetError() << "\n";                            \
+            return 1;                                                                                                  \
+        }                                                                                                              \
+    } while (false)
+int main(int argc, char** argv)
+{
+    if (argc != 2 && argc != 3)
+        return 2;
+    std::string error;
+    Runtime runtime;
+    CHECK(runtime.initialize(true, error));
+    GameSession game;
+    if (argc == 3)
+    {
+        Config c;
+        c.data_dir = argv[2];
+        CHECK(game.initialize() && game.resources.mount_game(c, error));
+        WorldModel floor;
+        floor.points = {{-1000, 0, -1000}, {1000, 0, -1000}, {1000, 0, 1000}, {-1000, 0, 1000}};
+        floor.surfaces.resize(1);
+        floor.surfaces[0].flags = 1;
+        floor.polygons = {{0, {0, 1, 2, 3}}};
+        CHECK(game.collision.build(floor, error));
+        game.server.collision_ready = true;
+    }
+    else
+        CHECK(test_flare::setup(game, argv[1]));
+    auto* owner = test_energy::actor(game, {0, 50, 0});
+    CHECK(owner);
+    auto* projectile = test_flare::projectile(game, owner->m_hObject, {0, 50, 20}, {0, 0, 1}, 100);
+    CHECK(projectile);
+    auto h = projectile->m_hObject;
+    projectile->color = {1, 0, 0}; // A source color, fixed for a pixel-level tint assertion.
+    WorldRenderer renderer(runtime.gpu, DrawStyle::SpriteAlpha);
+    SpriteView scene;
+    std::vector<Uint8> blank;
+    unsigned previous = 0;
+    for (unsigned stage = 0; stage < 3; ++stage)
+    {
+        CHECK(game.objects.advance(stage == 0 ? .005 : .01));
+        if (stage == 2)
+            CHECK(game.server.advance_projectiles(.1));
+        auto* record = game.objects.get(h);
+        CHECK(record && record->sprite);
+        CHECK(scene.begin_frame({0, 50, 0}, {}, error));
+        CHECK(scene.add(record->sprite.get(), record->sprite_track, {record->state.m_Pos, record->state.m_Rotation},
+                        record->state.m_Scale, record->state.m_Flags, record->id, game.resources, error, record->alpha,
+                        record->color));
+        CHECK(scene.entries.size() == 1 && scene.entries[0].error.empty());
+        CHECK(stage == 0 ? scene.draws.empty() : scene.draws.size() == 1);
+        Capture capture;
+        CHECK(capture.initialize(runtime.gpu, SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, 640, 480));
+        CHECK(
+            renderer.prepare(scene.mesh, scene.revision, SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, 640, 480, error, true));
+        auto* commands = SDL_AcquireGPUCommandBuffer(runtime.gpu);
+        CHECK(commands);
+        CHECK(renderer.draw(commands, capture.texture, scene.mesh, scene.draws, {0, 50, 0}, {}, false, error));
+        auto* copy = SDL_BeginGPUCopyPass(commands);
+        CHECK(copy);
+        SDL_GPUTextureRegion region{};
+        region.texture = capture.texture;
+        region.w = 640;
+        region.h = 480;
+        region.d = 1;
+        SDL_GPUTextureTransferInfo target{};
+        target.transfer_buffer = capture.transfer;
+        target.pixels_per_row = 640;
+        target.rows_per_layer = 480;
+        SDL_DownloadFromGPUTexture(copy, &region, &target);
+        SDL_EndGPUCopyPass(copy);
+        CHECK(SDL_SubmitGPUCommandBuffer(commands) && SDL_WaitForGPUIdle(runtime.gpu));
+        auto* pixels = static_cast<const Uint8*>(SDL_MapGPUTransferBuffer(runtime.gpu, capture.transfer, false));
+        CHECK(pixels);
+        unsigned changed = 0, red = 0;
+        if (stage == 0)
+            blank.assign(pixels, pixels + 640 * 480 * 4);
+        else
+            for (unsigned i = 0; i < 640 * 480; ++i)
+                if (!std::equal(pixels + i * 4, pixels + i * 4 + 3, blank.data() + i * 4))
+                {
+                    ++changed;
+                    if (pixels[i * 4] > pixels[i * 4 + 1] + 8 && pixels[i * 4] > pixels[i * 4 + 2] + 8)
+                        ++red;
+                }
+        SDL_UnmapGPUTransferBuffer(runtime.gpu, capture.transfer);
+        CHECK(stage == 0 || (changed > 20 && red > 20));
+        if (stage == 2)
+            CHECK(changed < previous);
+        previous = changed;
+        std::error_code ec;
+        std::filesystem::create_directories(argv[1], ec);
+        CHECK(!ec);
+        CHECK(capture.save((std::filesystem::path(argv[1]) / ("flare-" + std::to_string(stage) + ".png")).c_str()));
+        std::cout << "Stage " << stage << ": scale " << record->state.m_Scale.x << ", z " << record->state.m_Pos.z
+                  << ", red pixels " << red << ", changed pixels " << changed << "\n";
+    }
+    CHECK(game.objects.remove(h) && game.objects.finish_frame());
+    CHECK(update_sprite_scene(game, scene, error) && scene.entries.empty());
+    renderer.clear_geometry();
+    CHECK(game.unload_world());
+    return 0;
+}
