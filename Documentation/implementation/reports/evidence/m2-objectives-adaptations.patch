+    }
+    bool missing(const std::filesystem::path& root)
+    {
+        GameSession g;
+        CHECK(setup(g, root));
+        auto h = create(g, {{"ResourceNum", std::int32_t(1)}});
+        CHECK(send(g, h, g.client_shell.player));
