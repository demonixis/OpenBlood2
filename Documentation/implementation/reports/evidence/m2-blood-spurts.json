  "commands": [
    "cmake --build build/<debug|release|sanitize> -j3 --target blood2_app blood_spurt_tests blood_splat_tests death_effect_tests corpse_tests weapon_impact_tests weapon_sprite_tests object_contract_tests world_tests player_controls_tests",
    "cmake --build build/<debug|release> -j3 --target blood_spurt_gpu_tests blood_splat_gpu_tests death_effect_gpu_tests level_change_gpu_tests",
    "ctest --test-dir build/<debug|release> -R '^(blood_spurts|blood_splats|corpses|death_effects|weapon_impacts|weapon_sprites|objects|player_controls)\\.|^world\\.(level_change.*|destination_.*)$' -V -j2",
    "ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 ctest --test-dir build/sanitize -R '^(blood_spurts|blood_splats|corpses|death_effects|weapon_impacts|weapon_sprites|objects|player_controls)\\.|^world\\.(level_change.*|destination_.*)$' -V -j2",
    "VK_DRIVER_FILES=/usr/share/vulkan/icd.d/nvidia_icd.x86_64.json ctest --test-dir build/<debug|release> -R '^gpu\\.(blood_spurt|blood_spurt_private|blood_splat_alpha|blood_splat_private|death_effects|level_change|mouse_combat|corpse_clearance)$' -V"
  ],
  "development_findings": [
    "Initial compilation caught namespace qualifiers, the actual TeleportObject API and a typed byte seed in the new fixture; corrected without changing services.",
    "Initial NPC shot fixture aimed at authored coordinates instead of the actual post-initialization body center; it now reads that center.",
    "Existing authored combat/clearance tests exposed unintended AI random-stream perturbation: 50 shots exhausted ammo with the target alive at 0.84485 HP. Selection now uses the established cosmetic stream, retaining original integer range, chance and draw-before-damage order. Existing combat assertions/fixtures are unchanged.",
    "Private collision-mark GPU capture moved the diagnostic camera back to show its bounded silhouette, with an additional upper pixel bound.",
    "No acceptance assertion, production physics bound or timeout was relaxed."
  ],
  "limitations": [
    "Selected flesh recipe only; separate flesh SparksFX, generic/recursive debris, outside-world point classification, shared SFX eviction and full save/restore remain unavailable.",
    "Portable isolated RNG, discrete collision/particle integration and existing fullbright sprite rasterization are not retail executable parity.",
    "Private floor/asset diagnostics and existing authored encounter checks are not complete campaign traversal.",
    "No native Metal run, shader/dependency/reference/asset modifications this increment."
  ],
