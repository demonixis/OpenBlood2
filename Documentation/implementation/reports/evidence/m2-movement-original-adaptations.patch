+void CMoveMgr::UpdateMotion(float yaw) {
+    body.acceleration={}; UpdateOnGround();
+    const auto max_velocity=physics.move_speed*((m_dwControlFlags&run) ? 1.5f : 1.0f);
+    const auto max_acceleration=max_velocity*drag;
+    // Source flattened/normalized camera axes: looking up/down never changes
+    // walking speed. Digital diagonals retain the original sqrt(2) allowance.
+    const DVector front{std::sin(yaw),0,std::cos(yaw)}, right{std::cos(yaw),0,-std::sin(yaw)};
+    const float forward_accel=((m_dwControlFlags&forward) ? max_acceleration : 0)-((m_dwControlFlags&backward) ? max_acceleration : 0);
+    const float strafe_accel=((m_dwControlFlags&strafe_right) ? max_acceleration : 0)-((m_dwControlFlags&strafe_left) ? max_acceleration : 0);
+    body.acceleration=vector_add(body.acceleration,vector_add(vector_scale(front,forward_accel),vector_scale(right,strafe_accel)));
+    bool steep=false;
+    if (m_bOnGround) {
+        if (body.ground_normal.z+body.ground_normal.x>body.ground_normal.y) {
+            body.acceleration.y-=4000; steep=true;
+        } else TiltVectorToPlane(body.acceleration,body.ground_normal);
+    }
+    m_bFalling=!m_bOnGround;
+    if (m_dwControlFlags&jump) {
+        if (!m_bLastJumpCommand && m_bOnGround && !steep) {
+            body.velocity.y+=physics.jump_speed;
+            m_bLastJumpCommand=true; m_bOnGround=false; ++jumps;
+        }
+    } else m_bLastJumpCommand=false;
+    auto air_velocity=body.velocity;
+    if (!m_bOnGround) air_velocity.y=air_velocity.y>=0 ? 0 : std::max(air_velocity.y/2,-25.0f);
+    if (vector_dot(air_velocity,air_velocity)>0.01f)
+        body.acceleration=vector_add(body.acceleration,vector_scale(air_velocity,-drag));
+    const float horizontal=std::hypot(body.velocity.x,body.velocity.z);
+    const float cap=max_velocity*std::sqrt(2.0f);
+    if (horizontal>cap) { body.velocity.x*=cap/horizontal; body.velocity.z*=cap/horizontal; }
+    if (m_bLastJumpCommand && body.velocity.y>0 && body.acceleration.y>0) body.acceleration.y=0;
 }
