+namespace {
+constexpr DDWORD run=0x0001, jump=0x0002, forward=0x0008, backward=0x0010,
+    strafe_right=0x0100, strafe_left=0x0200; // Shared/SharedMovement.h
+constexpr float drag=15.0f; // Original g_fDragCoeff.
+DVector cross(DVector a,DVector b) { return {a.y*b.z-a.z*b.y,a.z*b.x-a.x*b.z,a.x*b.y-a.y*b.x}; }
+float magnitude(DVector v) { return std::sqrt(blood2::vector_dot(v,v)); }
+DVector normalized(DVector v) { const auto n=magnitude(v); return n>0 ? blood2::vector_scale(v,1/n) : DVector{}; }
+void TiltVectorToPlane(DVector& v,DVector normal) {
+    auto q=cross(normal,v);
+    if (blood2::vector_dot(q,q)>0.001f) v=blood2::vector_scale(cross(normalized(q),normal),magnitude(v));
 }
+}
