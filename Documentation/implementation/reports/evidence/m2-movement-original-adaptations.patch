+    position = {}; camera_position = {}; rotation = {}; physics = {}; stats = {};
+    blocker.clear();
+}
+bool CBloodClientShell::InitSinglePlayer(CBloodServerShell& server) {
+    if (!m_bFirstWorld) return false;
+    blood2::PlayerInit init; // Default entry profile; original fields/order retained.
+    if (!server.OnMessage(client_,init)) return false;
+    m_bFirstWorld = false;
+    // Original next requests CMSG_AUTOSAVE and sets GS_PLAYING. Both remain
+    // gated: successful attribute exchange cannot imply complete gameplay.
+    return true;
+}
+bool CBloodClientShell::OnMessage(const blood2::PlayerEvent& event,CBloodServerShell& server) {
+    if (!m_bInWorld || server_.GetClientUserData(client_) != player) return false;
+    ++messages;
+    if (std::holds_alternative<blood2::PlayerInitRequest>(event)) return InitSinglePlayer(server);
+    if (const auto* value = std::get_if<blood2::PlayerRotation>(&event)) rotation = *value;
+    else if (const auto* value = std::get_if<blood2::PlayerPosition>(&event)) {
+        if (!move_mgr.OnServerForcePos(*value)) return false;
+        position=value->position;
+    } else if (const auto* value = std::get_if<blood2::PlayerPhysics>(&event)) {
+        if (!move_mgr.OnPhysicsUpdate(*value)) return false;
+        physics=*value;
+    }
+    else if (const auto* value = std::get_if<blood2::PlayerStats>(&event)) stats = *value;
+    return true;
+}
+bool CBloodClientShell::Update() {
+    if (!m_bInWorld || server_.GetClientUserData(client_) != player) return false;
+    ++updates;
+    server_.GetObjectPos(player,&position);
+    // Caleb's source standing eye level. Original camera effects remain absent.
+    camera_position = position; camera_position.y += 36;
+    m_bFirstUpdate = false; return true;
+}
+bool CBloodClientShell::UpdateMovement(CBloodServerShell& server,double seconds,std::string& error) {
+    auto* owner=server.Player(client_);
+    if (!owner || !move_mgr.Update(server,movement_input,rotation.yaw,seconds,!owner->m_damage.IsDead())) {
+        error="Original MoveMgr step failed (invalid association, movement message or collision)"; return false;
+    }
+    return true;
+}
+bool CBloodClientShell::SyncWeapons(blood2::ModelStore& models,blood2::Resources& resources,CBloodServerShell& server,std::string& error) {
+    auto* owner=server.Player(client_); if (!owner) return false;
+    std::array<CViewWeapon,2> prepared;
+    std::array<bool,2> changed{};
+    for (unsigned i=0;i<2;++i) {
+        const auto* weapon=owner->m_InventoryMgr.CurrentWeapon(i!=0);
+        const auto type=weapon ? weapon->data.m_nType : 0;
+        changed[i]=type!=weapons[i].type;
+        if (changed[i] && type && !prepared[i].Create(type,i!=0,models,resources,error)) return false;
+    }
+    for (unsigned i=0;i<2;++i) if (changed[i]) weapons[i]=std::move(prepared[i]);
+    return true;
+}
+bool CBloodClientShell::UpdateWeapons(CBloodServerShell& server,double seconds,std::string& error) {
+    const float cp=std::cos(rotation.pitch);
+    const DVector forward{std::sin(rotation.yaw)*cp,-std::sin(rotation.pitch),std::cos(rotation.yaw)*cp};
+    for (auto& weapon : weapons)
+        if (!weapon.Update(server_,server,client_,weapon_input,camera_position,forward,seconds,error)) return false;
+    return true;
+}
