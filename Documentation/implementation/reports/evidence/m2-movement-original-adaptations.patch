+bool CPlayerObj::OnSinglePlayerInit(const blood2::PlayerInit& init) {
+    if (attributes_received || !m_hClient || init.name.size() > 100 || init.name.find('\0') != std::string::npos || init.character != 0 || init.skin != 0) return false;
