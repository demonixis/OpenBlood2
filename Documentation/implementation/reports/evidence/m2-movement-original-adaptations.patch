+    m_nCharacter = init.character; m_nSkin = init.skin;
+    m_nAttribStrength = init.strength; m_nAttribSpeed = init.speed;
+    m_nAttribResistance = init.resistance; m_nAttribMagic = init.magic;
+    ValidateAttributes();
+    m_InventoryMgr.requested_weapons = init.weapons;
+    if (m_InventoryMgr.ObtainWeapon(WEAP_MELEE,0)!=InventoryResult::Ok) return false;
+    for (unsigned i=0;i<init.weapons.size();++i) {
+        const auto type=static_cast<DBYTE>(init.weapons[i] & ~DUAL_HAND_MASK);
