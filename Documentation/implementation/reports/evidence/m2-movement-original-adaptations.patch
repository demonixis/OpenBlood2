+bool CPlayerObj::GoToStartPoint(HSTRING start_name) {
+    auto* server = GetServerDE(); auto* list = server->FindNamedObjects("Blood2StartPoint");
+    if (!list) return false;
+    // Fix the original empty-list early-return leak and use checked casts.
+    struct Release { ServerDE* server; ObjectList* list; ~Release() { server->RelinquishList(list); } } release{server,list};
+    bool remove_string = !start_name;
+    if (remove_string) start_name = server->CreateString("start");
+    if (!start_name) return false;
+    GameStartPoint* start = nullptr; GameStartPoint* fallback = nullptr;
+    for (auto* link = list->m_pFirstLink; link; link = link->m_pNext) {
+        auto* candidate = dynamic_cast<GameStartPoint*>(server->HandleToObject(link->m_hObject));
+        if (candidate && !candidate->IsMultiplayer()) {
+            fallback = candidate;
+            if (server->CompareStringsUpper(start_name,candidate->GetName())) { start = candidate; break; }
+        }
+    }
+    if (remove_string) server->FreeString(start_name);
+    if (!start) start = fallback;
+    if (!start) { entry_error = "No single-player GameStartPoint"; return false; }
+    m_fYaw = start->GetPitchYawRoll().y; m_fPitch = 0;
+    DVector position; server->GetObjectPos(start->m_hObject,&position);
+    start->SendTrigger();
+    if (server->TeleportObject(m_hObject,&position) != DE_OK ||
+        server->SendToClient(m_hClient,blood2::PlayerRotation{m_fPitch,m_fYaw}) != DE_OK) return false;
+    if (server->MoveObjectToGround(m_hObject) != DE_OK) { entry_error = "Start point has no supported ground collision"; return false; }
+    return UpdateClientPhysics() && TeleportClientToServerPos();
+}
+bool CPlayerObj::UpdateClientPhysics() {
+    if (!m_hClient) return true; // Original InitialUpdate has no client yet.
+    blood2::PlayerPhysics physics; physics.model = "Models\\Characters\\Caleb.abc";
+    physics.skin = "Skins\\Characters\\Caleb1.dtx";
+    auto* server = GetServerDE();
+    if (server->GetObjectDims(m_hObject,&physics.dimensions) != DE_OK || server->GetGlobalForce(&physics.gravity) != DE_OK) return false;
+    physics.move_speed = m_fMoveVel; physics.jump_speed = m_fJumpVel;
+    return server->SendToClient(m_hClient,physics) == DE_OK;
+}
+bool CPlayerObj::TeleportClientToServerPos() {
+    if (!m_hClient) return true;
+    blood2::PlayerPosition position; GetServerDE()->GetObjectPos(m_hObject,&position.position);
+    position.move_code=++m_byClientMoveCode;
+    return GetServerDE()->SendToClient(m_hClient,position) == DE_OK;
+}
+bool CPlayerObj::HandlePlayerPositionMessage(const blood2::PlayerMove& move) {
+    auto* server=GetServerDE();
+    if (!m_hClient || !attributes_received || server->GetClientUserData(m_hClient)!=m_hObject || move.move_code!=m_byClientMoveCode)
+        return false;
+    auto finite=[](DVector v) { return std::isfinite(v.x) && std::isfinite(v.y) && std::isfinite(v.z) &&
+        std::abs(v.x)<=10000000 && std::abs(v.y)<=10000000 && std::abs(v.z)<=10000000; };
+    if (!finite(move.position) || !finite(move.velocity) || !finite(move.acceleration)) return false;
+    auto velocity=move.velocity, acceleration=move.acceleration, position=move.position;
+    if (server->SetVelocity(m_hObject,&velocity)!=DE_OK || server->SetAcceleration(m_hObject,&acceleration)!=DE_OK ||
+        server->MoveObject(m_hObject,&position)!=DE_OK) return false;
+    blood2::MovementState state;
+    if (!server->GetMovementState(m_hObject,state)) return false;
+    // The original handler accepts the client's on-ground bit and enforces a
+    // prediction leash. Here one local body resolves collisions once, so use
+    // the resulting support and never teleport through a rejected collision.
+    m_bOnGround=state.standing && state.ground_normal.y>=0.5f;
+    ++movement_messages; return true;
+}
+DBOOL CPlayerObj::Update(DVector*) {
+    auto* server = GetServerDE(); server->SetNextUpdate(m_hObject,.001f); ++updates;
+    if (!m_hClient) return DTRUE;
+    if (m_bFirstUpdate) {
+        ValidateAttributes();
+        if (!UpdateClientPhysics() || !TeleportClientToServerPos()) return DFALSE;
+        m_bFirstUpdate = DFALSE;
+    }
+    return UpdateStats();
+}
+bool CPlayerObj::UpdateStats() {
+    const blood2::PlayerStats value{m_damage.m_fHitPoints,m_damage.m_fArmorPoints,m_InventoryMgr.GetAmmoCount(1)};
+    if (value.health==last_sent_stats_.health && value.armor==last_sent_stats_.armor && value.bullets==last_sent_stats_.bullets) return true;
+    if (GetServerDE()->SendToClient(m_hClient,value)!=DE_OK) return false;
+    last_sent_stats_=value; return true;
+}
+DDWORD CPlayerObj::EngineMessageFn(DDWORD message,void* data,DFLOAT fData) {
+    DBOOL result = DTRUE;
+    switch (message) {
+        case MID_PRECREATE: {
+            auto ret = CBaseCharacter::EngineMessageFn(message,data,fData);
+            if (data) PostPropRead(static_cast<ObjectCreateStruct*>(data));
+            return ret;
+        }
+        case MID_INITIALUPDATE: result = InitialUpdate(static_cast<int>(fData)); break;
+        case MID_UPDATE: result = Update(static_cast<DVector*>(data)); break;
+        default: break;
+    }
+    if (result) return CBaseCharacter::EngineMessageFn(message,data,fData);
+    GetServerDE()->RemoveObject(m_hObject); return result;
+}
 
