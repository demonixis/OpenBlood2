+            : n == "filters"   ? filters(argv[2])
+            : n == "lifetime"  ? lifetime(argv[2])
+            : n == "callbacks" ? callbacks(argv[2])
+            : n == "failures"  ? failures(argv[2])
+            : n == "ai"        ? ai(argv[2])
+            : n == "private"   ? private_data(argv[2])
+                               : false)
+               ? 0
+               : 1;
