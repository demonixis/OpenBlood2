  "commands": [
    "cmake --build build/<debug|release> --target blood_splat_tests corpse_tests death_effect_tests ai_navigation_tests object_contract_tests world_tests player_controls_tests blood2_app blood_splat_gpu_tests level_change_gpu_tests death_effect_gpu_tests -j3",
    "cmake --build build/sanitize --target blood_splat_tests corpse_tests death_effect_tests ai_navigation_tests object_contract_tests world_tests player_controls_tests -j3",
    "ctest --test-dir build/<debug|release> -R '^(blood_splats|corpses|death_effects|ai_navigation|objects)\\.|^world\\.(level_change.*|destination_.*)$|^player_controls.corpse_clearance$' -V -j2",
    "ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 ctest --test-dir build/sanitize -R '^(blood_splats|corpses|death_effects|ai_navigation|objects)\\.|^world\\.(level_change.*|destination_.*)$|^player_controls.corpse_clearance$' -V -j2",
    "VK_DRIVER_FILES=/usr/share/vulkan/icd.d/nvidia_icd.x86_64.json ctest --test-dir build/release -R '^gpu\\.(blood_splat_alpha|blood_splat_private|character|lifecycle|corpse_clearance|mouse_combat|level_change|death_effects)$' -V"
  ],
  "development_findings": [
    "Initial compile caught ordinary quaternion field names; code now uses actual DRotation m_Vec/m_Spin.",
    "Early formulas fixture supplied 100 seconds to one update, exceeding the unchanged shared SPR limit. It now tests the same 100-second persistence with two valid 50-second updates; effect limit explicitly matches 60 seconds.",
    "Original nearest-prefix fixture now positions a later closer sprite to verify early stopping; first ties and the strict squared-distance boundary remain checked.",
    "Additional GPU rechecks print actual device name directly in both new test paths.",
    "No acceptance assertion, production physics bound or test timeout relaxed."
  ],
  "limitations": [
    "Diagnostic floor and private effect captures do not prove full authored encounter/campaign parity.",
    "Blood spurts, gib impact callers, shared SFX-list eviction and full save/restore remain unavailable.",
    "Source-alignment fallback, portable RNG and existing fullbright sprite rasterization are documented adaptations.",
    "No native Metal execution this increment; no dependency/shader/reference/asset changes."
  ],
