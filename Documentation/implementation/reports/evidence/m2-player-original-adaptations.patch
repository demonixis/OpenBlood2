+bool ServerAdapter::disconnect_client(HCLIENT client) {
+    trace_service("DisconnectClient");
+    auto it = clients_.find(client); if (it == clients_.end() || objects_.busy()) return false;
+    if (GetClientUserData(client)) return false; // Exit callback must detach first.
+    clients_.erase(it); return true;
+}
+HOBJECT ServerAdapter::GetClientUserData(HCLIENT client) {
+    trace_service("GetClientUserData");
+    auto it = clients_.find(client); if (it == clients_.end()) return nullptr;
+    const auto* record = objects_.get(it->second.player);
+    if (!record || record->life != Life::Alive) { it->second.player = nullptr; it->second.events.clear(); return nullptr; }
+    return it->second.player;
+}
+DRESULT ServerAdapter::SetClientUserData(HCLIENT client,HOBJECT player) {
+    trace_service("SetClientUserData");
+    auto it = clients_.find(client); if (it == clients_.end()) return DE_INVALIDPARAMS;
+    if (player) {
+        const auto* record = objects_.get(player);
+        if (!record || record->life != Life::Alive || !Objects::is_kind_of(record->type,objects_.find_class("CPlayerObj"))) return DE_INVALIDPARAMS;
+        if (it->second.player && it->second.player != player) return DE_ERROR;
+    }
+    if (!player) it->second.events.clear();
+    it->second.player = player; return DE_OK;
+}
+DRESULT ServerAdapter::SendToClient(HCLIENT client,const PlayerEvent& event) {
+    trace_service("SendToClient");
+    if (!GetClientUserData(client)) return DE_INVALIDPARAMS;
+    const bool valid = std::visit([](const auto& value) {
+        using T = std::decay_t<decltype(value)>;
+        if constexpr (std::is_same_v<T,PlayerRotation>) return std::isfinite(value.pitch) && std::isfinite(value.yaw);
+        else if constexpr (std::is_same_v<T,PlayerPosition>) return physics_vector(value.position);
+        else if constexpr (std::is_same_v<T,PlayerStats>) return std::isfinite(value.health) && std::isfinite(value.armor) && std::isfinite(value.bullets);
+        else if constexpr (std::is_same_v<T,PlayerPhysics>) return value.model.size()<=100 && value.skin.size()<=100 &&
+            value.model.find('\0')==std::string::npos && value.skin.find('\0')==std::string::npos &&
+            physics_vector(value.dimensions) && physics_vector(value.gravity) &&
+            value.dimensions.x>=0 && value.dimensions.y>=0 && value.dimensions.z>=0 &&
+            std::isfinite(value.move_speed) && std::isfinite(value.jump_speed);
+        else return true;
+    },event);
+    if (!valid) return DE_INVALIDPARAMS;
+    auto& events = clients_.at(client).events;
+    if (events.size() >= 256) return DE_ERROR;
+    events.push_back(event); return DE_OK;
+}
+bool ServerAdapter::take_client_events(HCLIENT client,std::vector<PlayerEvent>& events) {
+    events.clear();
+    if (!GetClientUserData(client)) return false;
+    events.swap(clients_.at(client).events); return true;
+}
