+    trace_service("GetObjectDims"); if (out) *out = {};
+    const auto* r = objects_.get(h); if (!r || !out) return DE_INVALIDPARAMS;
+    *out = r->dimensions; return DE_OK;
+}
+DRESULT ServerAdapter::SetObjectRotation(HOBJECT h,const DRotation* rotation) {
+    trace_service("SetObjectRotation"); auto* r = objects_.get(h);
+    if (!r || !rotation || !physics_vector(rotation->m_Vec) || !std::isfinite(rotation->m_Spin)) return DE_INVALIDPARAMS;
+    const auto& v = rotation->m_Vec;
+    const float norm = std::sqrt(v.x*v.x+v.y*v.y+v.z*v.z+rotation->m_Spin*rotation->m_Spin);
+    if (!std::isfinite(norm) || norm < 1e-6f) return DE_INVALIDPARAMS;
+    r->state.m_Rotation = {vector_scale(v,1/norm),rotation->m_Spin/norm}; return DE_OK;
+}
+DBOOL ServerAdapter::CompareStringsUpper(HSTRING a,HSTRING b) {
+    trace_service("CompareStringsUpper"); const char* x = string_data(a); const char* y = string_data(b);
+    return x && y && !CaseLess{}(x,y) && !CaseLess{}(y,x);
+}
+DRESULT ServerAdapter::SetModelFilenames(HOBJECT h,const char* model,const char* skin) {
+    trace_service("SetModelFilenames"); auto* r = objects_.get(h);
+    if (!r || r->life != Life::Alive || r->state.m_ObjectType != OT_MODEL || !objects_.models ||
+        !model || !skin || std::strlen(model)>100 || std::strlen(skin)>100) return DE_INVALIDPARAMS;
+    // Load before mutation. A missing replacement cannot discard the live model.
+    std::shared_ptr<const Model> next; std::string error;
+    if (!objects_.models->load(model,next,error)) { objects_.fail(ObjectError::Unsupported,error); return DE_ERROR; }
+    if (r->model != next) { r->model = std::move(next); r->animation.animation = 0; r->animation.reset(); }
+    SAFE_STRCPY(r->state.m_Filename,model); SAFE_STRCPY(r->state.m_SkinName,skin); r->model_error.clear(); return DE_OK;
+}
+DRESULT ServerAdapter::MoveObjectToGround(HOBJECT h) {
+    trace_service("MoveObjectToGround"); auto* r = objects_.get(h);
+    if (!r || r->life != Life::Alive || !collision || !collision_ready) return DE_INVALIDPARAMS;
+    // Original ObjectUtilities::MoveObjectToGround: downward ray, animation-0
+    // user dimensions for characters, then collision-aware MoveObject. The
+    // otherwise unbounded CastRay is limited to the supported coordinate range.
+    auto from = r->state.m_Pos; auto to = from; to.y = -10000000.0f;
+    CollisionHit nearest; auto result = collision->sweep(from,to,{},nearest);
+    if (result == CollisionQuery::Invalid) return DE_ERROR;
+    bool found = result == CollisionQuery::Hit;
+    for (auto id : objects_.snapshot()) {
+        const auto* other = objects_.get(id);
+        if (!other || other->life != Life::Alive || other->handle == h || !(other->state.m_Flags & FLAG_SOLID)) continue;
+        CollisionHit hit;
+        if (sweep_box(from,to,{},other->state.m_Pos,other->dimensions,hit) == CollisionQuery::Hit &&
+            (!found || hit.fraction < nearest.fraction)) { nearest = hit; found = true; }
+    }
+    if (!found || nearest.start_solid) return DE_NOTFOUND;
+    DVector dims = r->dimensions;
+    if (Objects::is_kind_of(r->type,objects_.find_class("CBaseCharacter")) && GetModelAnimUserDims(h,&dims,0) != DE_OK) return DE_ERROR;
+    const float distance = from.y-nearest.point.y+0.1f;
+    if (distance > dims.y) { from.y = from.y-distance+(dims.y+0.1f); return MoveObject(h,&from); }
+    return DE_OK; // Already close enough; original helper does not move upward.
+}
+}
