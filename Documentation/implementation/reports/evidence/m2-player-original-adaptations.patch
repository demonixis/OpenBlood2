+HCLIENT ServerAdapter::connect_client() {
+    trace_service("ConnectClient");
+    if (!bound_ || !clients_.empty() || client_tokens_.size() >= 65536 || objects_.busy()) return nullptr;
+    auto token = std::make_unique<ClientHandle>(); auto h = token.get();
+    client_tokens_.push_back(std::move(token)); clients_.emplace(h,Client{}); return h;
