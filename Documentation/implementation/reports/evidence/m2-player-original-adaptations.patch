+DLink CDestructable::m_DestructableHead{};
+DDWORD CDestructable::m_dwNumDestructables = 0;
+CDestructable::CDestructable() {
+    if (m_dwNumDestructables == 0) dl_TieOff(&m_DestructableHead);
+}
+CDestructable::~CDestructable() {
+    if (m_Link.m_pData && m_dwNumDestructables > 0) { dl_Remove(&m_Link); --m_dwNumDestructables; }
+}
+DBOOL CDestructable::Init(HOBJECT object,CInventoryMgr* inventory) {
+    if (!object || !BaseClass::GetServerDE()) return DFALSE;
+    m_hObject = object;
+    if (!m_Link.m_pData) {
+        dl_Insert(&m_DestructableHead,&m_Link); m_Link.m_pData = this; ++m_dwNumDestructables;
+    }
+    m_pInventoryMgr = inventory; return DTRUE;
+}
+void CDestructable::CalculateResistance(DBYTE value) {
+    if (value == 1) m_fResistance = 1.20f;
+    else if (value == 2) m_fResistance = 1.10f;
+    else if (value == 3) m_fResistance = 1.0f;
+    else if (value == 4) m_fResistance = 0.9f;
+    else if (value == 5) m_fResistance = 0.8f;
+    else if (value >= 6) m_fResistance = 0.7f;
+}
+bool CInventoryMgr::Init(HOBJECT object,HCLIENT client) {
+    auto* server = BaseClass::GetServerDE(); m_hOwner = object;
+    if (!m_hMuzzleFlash) {
+        ObjectCreateStruct state; state.m_ObjectType = OT_LIGHT;
+        if (auto* flash = server->CreateObject(server->GetClass("BaseClass"),&state)) {
+            m_hMuzzleFlash = flash->m_hObject;
+            if (server->CreateInterObjectLink(m_hOwner,m_hMuzzleFlash) != DE_OK) return false;
+        } else return false;
+    }
+    if (client) SetClient(client);
+    return true;
+}
+CInventoryMgr::~CInventoryMgr() {
+    if (m_hMuzzleFlash) BaseClass::GetServerDE()->RemoveObject(m_hMuzzleFlash);
+}
+DDWORD CInventoryMgr::EngineMessageFn(LPBASECLASS object,DDWORD message,void* data,DFLOAT fData) {
+    if (message == MID_LINKBROKEN && data == m_hMuzzleFlash) {
+        // The engine notifies on either endpoint's removal. Release this owned
+        // child before clearing the handle, including when the owner is pending.
+        BaseClass::GetServerDE()->RemoveObject(m_hMuzzleFlash); m_hMuzzleFlash = nullptr;
+    }
+    return Aggregate::EngineMessageFn(object,message,data,fData);
+}
+void CInventoryMgr::SetAmmoCount(DBYTE type,float count) {
+    if (type == 0 || type > 12 || m_bInfiniteAmmo || !std::isfinite(count) || count < 0) return;
+    m_fAmmo[type] = count;
+    // Original inventory-item removal/recharge paths require weapon/item code.
+    // This entry subset owns no such items and exposes no ObtainWeapon facade.
+}
+CBaseCharacter::CBaseCharacter() : B2BaseClass(OT_MODEL) {
+    AddAggregate(&m_damage); AddAggregate(&m_InventoryMgr);
+    // Original m_MoveObj (steering/AI movement) is not imported in this subset.
+}
+DDWORD CBaseCharacter::EngineMessageFn(DDWORD message,void* data,DFLOAT fData) {
+    if (message == MID_INITIALUPDATE && fData != INITIALUPDATE_SAVEGAME) {
+        auto flags = g_pServerDE->GetObjectFlags(m_hObject);
+        g_pServerDE->SetObjectFlags(m_hObject,flags | FLAG_MODELGOURAUDSHADE | FLAG_ANIMTRANSITION);
+    }
+    if (message == MID_MODELSTRINGKEY && data && pending_model_commands.size() < 32) {
+        auto* args = static_cast<ArgList*>(data); std::string command;
+        for (int i = 0; args->argv && i < args->argc; ++i) { if (i) command += ' '; command += args->argv[i]; }
+        pending_model_commands.push_back(std::move(command));
+    }
+    return B2BaseClass::EngineMessageFn(message,data,fData);
+}
+CPlayerObj::~CPlayerObj() {
+    auto* server = GetServerDE();
+    if (m_hClient) server->SetClientUserData(m_hClient,nullptr);
+    if (m_hstrTrigger) server->FreeString(m_hstrTrigger);
+    if (m_hstrPlayerName) server->FreeString(m_hstrPlayerName);
+    // Creation rollback owns the initial smell until entry succeeds. Ordinary
+    // lifetime leaves the world-owned scent to its original 20-second timeout.
+    if (!attributes_received && initial_smell_) server->RemoveObject(initial_smell_);
+}
+void CPlayerObj::PostPropRead(ObjectCreateStruct* state) {
+    SAFE_STRCPY(state->m_Filename,"Models\\Characters\\Caleb.abc");
+    SAFE_STRCPY(state->m_SkinName,"Skins\\Characters\\Caleb1.dtx");
+    SAFE_STRCPY(state->m_Name,"player"); state->m_ObjectType = OT_MODEL;
+}
+DBOOL CPlayerObj::InitialUpdate(int reason) {
+    auto* server = GetServerDE();
+    if (reason == INITIALUPDATE_SAVEGAME) { entry_error = "Player save restoration is not ported"; return DFALSE; }
+    // InitialUpdate precedes SetClient, as in the original engine.
+    if (!m_InventoryMgr.Init(m_hObject,m_hClient) || !m_damage.Init(m_hObject,&m_InventoryMgr)) return DFALSE;
+    m_bFirstUpdate = DTRUE;
+    m_InventoryMgr.SetAmmoCount(1,50);
+    server->SetNextUpdate(m_hObject,.001f);
+    m_damage.SetHitPoints(100); m_damage.SetArmorPoints(0);
+    m_damage.m_fMaxHitPoints = m_damage.m_fMaxMegaHitPoints = 100;
+    m_damage.m_fMaxArmorPoints = m_damage.m_fMaxNecroArmorPoints = 100;
+    m_damage.m_fMass = 250;
+    m_fSmellTime = server->GetTime(); m_fSmellDelay = .5f;
+    ObjectCreateStruct state; server->GetObjectPos(m_hObject,&state.m_Pos);
+    if (auto* smell = server->CreateObject(server->GetClass("SmellHint"),&state)) initial_smell_ = smell->m_hObject;
+    else return DFALSE;
+    DVector dims{12,82.0f/2,12}; server->SetObjectDims(m_hObject,&dims);
+    m_hstrTrigger = server->CreateString("TRIGGER");
+    initialized = m_hstrTrigger != nullptr;
+    return initialized;
+}
+bool CPlayerObj::SetCharacter(DBYTE character) {
+    // Caleb, default skin only until the other original character branches,
+    // sound roots and hit-sphere generation are ported. Reject before mutation.
+    if (character != 0 || m_nSkin != 0) { entry_error = "Only Caleb's default entry profile is ported"; return false; }
+    if (GetServerDE()->SetModelFilenames(m_hObject,"Models\\Characters\\Caleb.abc","Skins\\Characters\\Caleb1.dtx") != DE_OK) {
+        entry_error = "Player model could not be loaded"; return false;
+    }
+    m_nCharacter = character; return true;
+}
+bool CPlayerObj::Respawn() {
+    auto* server = GetServerDE();
+    // Preserve the original single-player dead-player gate. This operation is
+    // an entry reset, not a replacement for loading a save after death.
+    if (m_damage.IsDead()) { entry_error = "A dead single-player character requires save restoration"; return false; }
+    if (!SetCharacter(m_nCharacter)) return false;
+    const DDWORD flags = FLAG_VISIBLE | FLAG_MODELKEYS | FLAG_YROTATION | FLAG_ANIMTRANSITION |
+        FLAG_TOUCH_NOTIFY | FLAG_SOLID | FLAG_STAIRSTEP | FLAG_SHADOW;
+    server->SetObjectFlags(m_hObject,flags);
+    DVector velocity{}; server->SetVelocity(m_hObject,&velocity);
+    m_damage.SetHitPoints(100); m_damage.SetArmorPoints(0); m_bDead = DFALSE; m_fAirLevel = 100;
+    for (DBYTE i = 1; i <= 12; ++i) m_InventoryMgr.SetAmmoCount(i,0);
+    m_InventoryMgr.SetAmmoCount(1,50);
+    ++respawns;
+    return UpdateClientPhysics() && TeleportClientToServerPos();
+}
+void CPlayerObj::ValidateAttributes() {
+    auto clamp = [](DBYTE value) { return std::clamp<DBYTE>(value,1,5); };
+    m_nAttribStrength = clamp(m_nAttribStrength); m_nAttribSpeed = clamp(m_nAttribSpeed);
+    m_nAttribResistance = clamp(m_nAttribResistance); m_nAttribMagic = clamp(m_nAttribMagic);
+    if (m_nAttribStrength+m_nAttribSpeed+m_nAttribResistance+m_nAttribMagic > 12)
+        m_nAttribStrength = m_nAttribSpeed = m_nAttribResistance = m_nAttribMagic = 3;
+    m_damage.CalculateResistance(m_nAttribResistance);
+    static constexpr float move[] = {220,250,280,310,330,350};
+    static constexpr float maximum[] = {100,100,125,150,200,250};
+    static constexpr float mega[] = {100,150,200,250,300,400};
+    m_fMoveVel = move[m_nAttribSpeed-1]; m_fJumpVel = 600;
+    m_damage.m_fMaxHitPoints = maximum[m_nAttribStrength-1];
+    m_damage.m_fMaxMegaHitPoints = mega[m_nAttribStrength-1];
+    m_damage.m_fMaxArmorPoints = maximum[m_nAttribMagic-1];
+    m_damage.m_fMaxNecroArmorPoints = mega[m_nAttribMagic-1];
+}
+bool CPlayerObj::OnSinglePlayerInit(const blood2::PlayerInit& init) {
+    if (attributes_received || !m_hClient || init.name.size() > 100 || init.name.find('\0') != std::string::npos || init.character != 0 || init.skin != 0) return false;
+    m_hstrPlayerName = GetServerDE()->CreateString(init.name.c_str()); if (!m_hstrPlayerName) return false;
+    m_nCharacter = init.character; m_nSkin = init.skin;
+    m_nAttribStrength = init.strength; m_nAttribSpeed = init.speed;
+    m_nAttribResistance = init.resistance; m_nAttribMagic = init.magic;
+    ValidateAttributes();
+    // Preserve the actual request; do not claim weapons were obtained. Missing
+    // ObtainWeapon/ChangeWeaponSlot is a visible gameplay blocker.
+    m_InventoryMgr.requested_weapons = init.weapons;
+    if (!Respawn()) { GetServerDE()->FreeString(m_hstrPlayerName); m_hstrPlayerName = nullptr; return false; }
+    attributes_received = true; return true;
+}
+bool CPlayerObj::GoToStartPoint(HSTRING start_name) {
+    auto* server = GetServerDE(); auto* list = server->FindNamedObjects("Blood2StartPoint");
+    if (!list) return false;
+    // Fix the original empty-list early-return leak and use checked casts.
+    struct Release { ServerDE* server; ObjectList* list; ~Release() { server->RelinquishList(list); } } release{server,list};
+    bool remove_string = !start_name;
+    if (remove_string) start_name = server->CreateString("start");
+    if (!start_name) return false;
+    GameStartPoint* start = nullptr; GameStartPoint* fallback = nullptr;
+    for (auto* link = list->m_pFirstLink; link; link = link->m_pNext) {
+        auto* candidate = dynamic_cast<GameStartPoint*>(server->HandleToObject(link->m_hObject));
+        if (candidate && !candidate->IsMultiplayer()) {
+            fallback = candidate;
+            if (server->CompareStringsUpper(start_name,candidate->GetName())) { start = candidate; break; }
+        }
+    }
+    if (remove_string) server->FreeString(start_name);
+    if (!start) start = fallback;
+    if (!start) { entry_error = "No single-player GameStartPoint"; return false; }
+    m_fYaw = start->GetPitchYawRoll().y; m_fPitch = 0;
+    DVector position; server->GetObjectPos(start->m_hObject,&position);
+    start->SendTrigger();
+    if (server->TeleportObject(m_hObject,&position) != DE_OK ||
+        server->SendToClient(m_hClient,blood2::PlayerRotation{m_fPitch,m_fYaw}) != DE_OK) return false;
+    if (server->MoveObjectToGround(m_hObject) != DE_OK) { entry_error = "Start point has no supported ground collision"; return false; }
+    return UpdateClientPhysics() && TeleportClientToServerPos();
+}
+bool CPlayerObj::UpdateClientPhysics() {
+    if (!m_hClient) return true; // Original InitialUpdate has no client yet.
+    blood2::PlayerPhysics physics; physics.model = "Models\\Characters\\Caleb.abc";
+    physics.skin = "Skins\\Characters\\Caleb1.dtx";
+    auto* server = GetServerDE();
+    if (server->GetObjectDims(m_hObject,&physics.dimensions) != DE_OK || server->GetGlobalForce(&physics.gravity) != DE_OK) return false;
+    physics.move_speed = m_fMoveVel; physics.jump_speed = m_fJumpVel;
+    return server->SendToClient(m_hClient,physics) == DE_OK;
+}
+bool CPlayerObj::TeleportClientToServerPos() {
+    if (!m_hClient) return true;
+    blood2::PlayerPosition position; GetServerDE()->GetObjectPos(m_hObject,&position.position);
+    return GetServerDE()->SendToClient(m_hClient,position) == DE_OK;
+}
+DBOOL CPlayerObj::Update(DVector*) {
+    auto* server = GetServerDE(); server->SetNextUpdate(m_hObject,.001f); ++updates;
+    if (!m_hClient) return DTRUE;
+    if (m_bFirstUpdate) {
+        ValidateAttributes();
+        if (!UpdateClientPhysics() || !TeleportClientToServerPos() ||
+            server->SendToClient(m_hClient,blood2::PlayerStats{m_damage.m_fHitPoints,m_damage.m_fArmorPoints,m_InventoryMgr.GetAmmoCount(1)}) != DE_OK) return DFALSE;
+        m_bFirstUpdate = DFALSE;
+    }
+    return DTRUE;
+}
+DDWORD CPlayerObj::EngineMessageFn(DDWORD message,void* data,DFLOAT fData) {
+    DBOOL result = DTRUE;
+    switch (message) {
+        case MID_PRECREATE: {
+            auto ret = CBaseCharacter::EngineMessageFn(message,data,fData);
+            if (data) PostPropRead(static_cast<ObjectCreateStruct*>(data));
+            return ret;
+        }
+        case MID_INITIALUPDATE: result = InitialUpdate(static_cast<int>(fData)); break;
+        case MID_UPDATE: result = Update(static_cast<DVector*>(data)); break;
+        default: break;
+    }
+    if (result) return CBaseCharacter::EngineMessageFn(message,data,fData);
+    GetServerDE()->RemoveObject(m_hObject); return result;
+}
