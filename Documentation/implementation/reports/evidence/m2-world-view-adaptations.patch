diff --git a/tests/world_gpu_tests.cpp b/tests/world_gpu_tests.cpp
new file mode 100644
index 0000000..d876f24
--- /dev/null
+++ b/tests/world_gpu_tests.cpp
@@ -0,0 +1,110 @@
+#include "engine/capture.h"
+#include "engine/runtime.h"
+#include "engine/world_renderer.h"
+#include <SDL3/SDL.h>
+#include <iostream>
+using namespace OpenBlood2;
+#define CHECK(x)                                                                                                       \
+    do                                                                                                                 \
+    {                                                                                                                  \
+        if (!(x))                                                                                                      \
+        {                                                                                                              \
+            std::cerr << __LINE__ << ": " #x " " << error << " " << SDL_GetError() << '\n';                            \
+            return 1;                                                                                                  \
+        }                                                                                                              \
+    } while (false)
+int main(int argc, char** argv)
+{
+    std::string error;
+    Runtime runtime;
+    CHECK(runtime.initialize(true, error));
+    WorldMesh mesh;
+    auto triangle = [&](DVector a, DVector b, DVector c, DVector color)
+    {
+        for (auto p : {a, b, c})
+            mesh.vertices.push_back({p, color});
+    };
+    triangle({-1, -1, 2}, {1, -1, 2}, {0, 1, 2}, {1, 0, 0}); // Near red, submitted before far blue.
+    triangle({-2, -2, 4}, {2, -2, 4}, {2, 2, 4}, {0, 0, 1});
+    triangle({-2, -2, 4}, {-2, 2, 4}, {2, 2, 4}, {0, 0, 1});            // Opposite winding is visible too.
+    triangle({-1, -1, .5f}, {1, -1, .5f}, {0, 1, .5f}, {1, 1, 0});      // Must be near-clipped.
+    triangle({1, .6f, 2}, {1.5f, .6f, 2}, {1.25f, 1.2f, 2}, {0, 1, 0}); // +X right / +Y up.
+    mesh.ranges.push_back({0, static_cast<unsigned>(mesh.vertices.size()), {}, "synthetic"});
+    WorldRenderer renderer(runtime.gpu);
+    for (int cycle = 0; cycle < 3; ++cycle)
+    {
+        const Uint32 w = cycle == 1 ? 240 : 320, h = cycle == 1 ? 320 : 240;
+        CHECK(SDL_SetWindowSize(runtime.window, int(w), int(h)));
+        SDL_PumpEvents();
+        Capture capture;
+        CHECK(capture.initialize(runtime.gpu, SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, w, h));
+        CHECK(renderer.prepare(mesh, cycle, SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, w, h, error));
+        CHECK(renderer.prepare(mesh, cycle, SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, w, h, error));
+        CHECK(renderer.stats.uploads == unsigned(cycle + 1));
+        WorldDraw draw;
+        DVector eye{};
+        DRotation view;
+        if (cycle == 2)
+        {
+            eye = draw.position = {100, 20, -50};
+            view = draw.rotation = rotation_from_euler({0, 1.57079632679f, 0});
+        }
+        auto* cmd = SDL_AcquireGPUCommandBuffer(runtime.gpu);
+        CHECK(cmd);
+        SDL_GPUTexture* swap = nullptr;
+        Uint32 sw = 0, sh = 0;
+        CHECK(SDL_WaitAndAcquireGPUSwapchainTexture(cmd, runtime.window, &swap, &sw, &sh));
+        CHECK(swap);
+        CHECK(renderer.draw(cmd, capture.texture, mesh, std::span(&draw, 1), eye, view, false, error));
+        CHECK(capture.enqueue(cmd, swap));
+        CHECK(SDL_SubmitGPUCommandBuffer(cmd));
+        CHECK(SDL_WaitForGPUIdle(runtime.gpu));
+        auto* pixels = static_cast<const Uint8*>(SDL_MapGPUTransferBuffer(runtime.gpu, capture.transfer, false));
+        CHECK(pixels);
+        auto rgb = [&](int x, int y, int r, int g, int b)
+        {
+            auto* p = pixels + (y * w + x) * 4;
+            bool ok = p[0] == r && p[1] == g && p[2] == b && p[3] == 255;
+            if (!ok)
+                std::cerr << "cycle " << cycle << " pixel " << x << "," << y << " = " << int(p[0]) << "," << int(p[1])
+                          << "," << int(p[2]) << "," << int(p[3]) << "\n";
+            return ok;
+        };
+        bool correct = rgb(w / 2, h / 2, 255, 0, 0) && rgb(w * 3 / 10, h / 2, 0, 0, 255) &&
+                       rgb(w * 13 / 16, int(h / 2 - w * .2f), 0, 255, 0);
+        SDL_UnmapGPUTransferBuffer(runtime.gpu, capture.transfer);
+        if (!correct && argc == 2)
+            capture.save(argv[1]);
+        CHECK(correct);
+        if (cycle == 2 && argc == 2)
+            CHECK(capture.save(argv[1]));
+        // The original camera type-1 viewport leaves one-sixth bars above/below.
+        auto* bars = SDL_AcquireGPUCommandBuffer(runtime.gpu);
+        CHECK(bars);
+        CHECK(renderer.draw(bars, capture.texture, mesh, std::span(&draw, 1), eye, view, true, error));
+        SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(bars);
+        CHECK(copy);
+        SDL_GPUTextureRegion region{};
+        region.texture = capture.texture;
+        region.w = w;
+        region.h = h;
+        region.d = 1;
+        SDL_GPUTextureTransferInfo destination{};
+        destination.transfer_buffer = capture.transfer;
+        destination.pixels_per_row = w;
+        destination.rows_per_layer = h;
+        SDL_DownloadFromGPUTexture(copy, &region, &destination);
+        SDL_EndGPUCopyPass(copy);
+        CHECK(SDL_SubmitGPUCommandBuffer(bars));
+        CHECK(SDL_WaitForGPUIdle(runtime.gpu));
+        pixels = static_cast<const Uint8*>(SDL_MapGPUTransferBuffer(runtime.gpu, capture.transfer, false));
+        CHECK(pixels);
+        correct = rgb(w / 2, 1, 6, 9, 13) && rgb(w / 2, h - 2, 6, 9, 13) && rgb(w / 2, h / 2, 255, 0, 0);
+        SDL_UnmapGPUTransferBuffer(runtime.gpu, capture.transfer);
+        CHECK(correct);
+        renderer.clear_geometry();
+    }
+    std::cout << "GPU readback: depth occlusion, opposite winding, near clipping, +X/+Y orientation, camera/object "
+                 "transforms, resize and reupload pass\n";
+    return 0;
+}
diff --git a/tests/world_view_tests.cpp b/tests/world_view_tests.cpp
new file mode 100644
index 0000000..edfb7c7
--- /dev/null
+++ b/tests/world_view_tests.cpp
@@ -0,0 +1,218 @@
+#include "engine/collision.h"
+#include "engine/container.h"
+#include "engine/world_view.h"
+#include "game/server_adapter.h"
+#include <algorithm>
+#include <cmath>
+#include <iostream>
+#include <limits>
+using namespace OpenBlood2;
+#define CHECK(x)                                                                                                       \
+    do                                                                                                                 \
+    {                                                                                                                  \
+        if (!(x))                                                                                                      \
+        {                                                                                                              \
+            std::cerr << __LINE__ << ": " #x "\n";                                                                     \
+            return false;                                                                                              \
+        }                                                                                                              \
+    } while (false)
+namespace
+{
+    World fixture()
+    {
+        World w;
+        WorldModel m;
+        m.name = "primary";
+        m.points = {{-2, -2, 4}, {2, -2, 4}, {2, 2, 4}, {-2, 2, 4}};
+        m.planes = {{{0, 0, -1}, -4}};
+        m.surfaces.resize(1);
+        m.polygons = {{0, {0, 1, 2, 3, 0, 2, 3}, 4}};
+        w.models.push_back(m);
+        return w;
+    }
+    bool mesh_test()
+    {
+        auto w = fixture();
+        WorldMesh mesh;
+        std::string error;
+        CHECK(mesh.build(w, error));
+        CHECK(mesh.vertices.size() == 6 && mesh.ranges.size() == 1);
+        CHECK(mesh.vertices[0].position.x == -2 && mesh.vertices[0].position.z == 4);
+        w.models[0].surfaces[0].flags = 4;
+        CHECK(mesh.build(w, error));
+        CHECK(mesh.vertices.empty() && mesh.invisible == 1);
+        w.models[0].surfaces[0].flags = 8 | 16;
+        CHECK(mesh.build(w, error));
+        CHECK(mesh.transparent == 1 && mesh.sky == 1);
+        w.models[0].points[1] = w.models[0].points[0];
+        CHECK(mesh.build(w, error));
+        CHECK(mesh.degenerate == 1 && mesh.vertices.size() == 3);
+        return true;
+    }
+    bool rejects()
+    {
+        WorldMesh mesh;
+        std::string error;
+        for (int i = 0; i < 7; ++i)
+        {
+            auto w = fixture();
+            if (i == 0)
+                w.models.clear();
+            if (i == 1)
+                w.models[0].polygons[0].points[2] = 99;
+            if (i == 2)
+                w.models[0].polygons[0].base_points = 2;
+            if (i == 3)
+                w.models[0].polygons[0].surface = 1;
+            if (i == 4)
+                w.models[0].surfaces[0].plane = 1;
+            if (i == 5)
+                w.models[0].planes[0].normal.x = std::numeric_limits<float>::infinity();
+            if (i == 6)
+                w.models[0].points[0].x = std::numeric_limits<float>::quiet_NaN();
+            CHECK(!mesh.build(w, error));
+            CHECK(!error.empty() && mesh.vertices.empty() && mesh.ranges.empty());
+        }
+        return true;
+    }
+    bool camera()
+    {
+        WorldViewUniform u;
+        WorldDraw d;
+        CHECK(world_view_uniform({10, 20, 30}, {}, 2, d, u));
+        CHECK(u.eye[0] == 10 && u.right[0] == 1 && u.up[1] == 1 && u.forward[2] == 1 && u.projection[1] == 2);
+        CHECK(std::abs(u.projection[2] + u.projection[3]) < 1e-6);
+        CHECK(std::abs((65536 * u.projection[2] + u.projection[3]) / 65536 - 1) < 1e-6);
+        auto q = rotation_from_euler({0, 1.57079632679f, 0});
+        CHECK(world_view_uniform({}, q, 1, d, u));
+        CHECK(std::abs(u.forward[0] - 1) < 1e-5 && std::abs(u.right[2] + 1) < 1e-5);
+        CHECK(!world_view_uniform({}, q, 0, d, u));
+        q.m_Spin = 5;
+        CHECK(!world_view_uniform({}, q, 1, d, u));
+        return true;
+    }
+    bool lifetime()
+    {
+        GameSession g;
+        CHECK(g.initialize());
+        auto w = fixture();
+        w.models.push_back(w.models[0]);
+        w.models[1].name = "moving";
+        w.models[1].translation = {10, 20, 30};
+        WorldMesh mesh;
+        std::string error;
+        CHECK(mesh.build(w, error));
+        CHECK(mesh.vertices[6].position.x == -12 && mesh.vertices[6].position.z == -26);
+        auto h = g.create_example("CameraSpot");
+        CHECK(h);
+        auto* r = g.objects.get(h);
+        r->state.m_ObjectType = OT_WORLDMODEL;
+        SAFE_STRCPY(r->state.m_Filename, "moving");
+        r->state.m_Pos = {30, 40, 50};
+        r->state.m_Rotation = rotation_from_euler({0, 1, 0});
+        r->world_model = std::make_shared<ContainerShape>();
+        r->state.m_Flags |= FLAG_VISIBLE;
+        r->activity = OBJSTATE_INACTIVE;
+        std::vector<WorldDraw> draws;
+        WorldViewStats stats;
+        CHECK(world_draws(mesh, g.objects, draws, stats, error));
+        CHECK(draws.size() == 2 && stats.unbound == 0);
+        CHECK(draws[1].position.x == 30 && draws[1].rotation.m_Spin == r->state.m_Rotation.m_Spin);
+        r->state.m_Flags &= ~FLAG_VISIBLE;
+        CHECK(world_draws(mesh, g.objects, draws, stats, error));
+        CHECK(draws.size() == 1 && stats.hidden == 1);
+        r->state.m_Flags |= FLAG_VISIBLE;
+        mesh.ranges.push_back(mesh.ranges[1]);
+        CHECK(!world_draws(mesh, g.objects, draws, stats, error));
+        CHECK(draws.empty());
+        mesh.ranges.pop_back();
+        CHECK(g.objects.remove(h));
+        CHECK(world_draws(mesh, g.objects, draws, stats, error));
+        CHECK(draws.size() == 1 && stats.unbound == 1);
+        CHECK(g.objects.finish_frame());
+        CHECK(!g.objects.get(h));
+        CHECK(world_draws(mesh, g.objects, draws, stats, error));
+        CHECK(draws.size() == 1);
+        return true;
+    }
+    bool private_world(const char* directory)
+    {
+        GameSession g;
+        CHECK(g.initialize());
+        Config config;
+        config.data_dir = directory;
+        std::string error;
+        CHECK(g.resources.mount_game(config, error));
+        WorldMesh mesh;
+        std::vector<WorldDraw> draws;
+        WorldViewStats stats;
+        auto revision = g.world_revision;
+        for (int cycle = 0; cycle < 2; ++cycle)
+        {
+            CHECK(g.request_world("01_SubwayA", error));
+            CHECK(g.world_revision > revision);
+            revision = g.world_revision;
+            CHECK(mesh.build(g.world, error));
+            CHECK(mesh.ranges.size() == 116 && mesh.vertices.size() > 1000);
+            CHECK(g.enter_player(error));
+            CHECK(g.step(1. / 60));
+            CHECK(world_draws(mesh, g.objects, draws, stats, error));
+            CHECK(stats.draws > 50 && stats.triangles > 1000);
+            std::size_t posed = 0;
+            for (auto id : g.objects.snapshot())
+            {
+                auto* r = g.objects.get(id);
+                if (!r || !r->world_model || !(r->state.m_Flags & FLAG_VISIBLE))
+                    continue;
+                auto it = std::find_if(draws.begin(), draws.end(),
+                                       [&](const auto& d) { return mesh.ranges[d.range].name == r->state.m_Filename; });
+                CHECK(it != draws.end());
+                const auto& range = mesh.ranges[it->range];
+                if (!range.count)
+                    continue;
+                auto point = vector_add(it->position, rotate_vector(mesh.vertices[range.first].position, it->rotation));
+                bool found = false;
+                const auto offset = vector_subtract(r->state.m_Pos, r->world_model->origin);
+                for (const auto& t : r->world_model->triangles)
+                    for (auto p : t)
+                    {
+                        auto delta = vector_subtract(point, vector_add(p, offset));
+                        if (vector_dot(delta, delta) < .01f)
+                            found = true;
+                    }
+                CHECK(found);
+                ++posed;
+            }
+            CHECK(posed > 50);
+            auto time = g.objects.time();
+            auto before = g.objects.snapshot().size();
+            CHECK(world_draws(mesh, g.objects, draws, stats, error));
+            CHECK(g.objects.time() == time && g.objects.snapshot().size() == before);
+            std::cout << "SubwayA: vertices=" << mesh.vertices.size() << " draws=" << stats.draws
+                      << " triangles=" << stats.triangles << " unbound=" << stats.unbound
+                      << " invisible=" << mesh.invisible << " posed=" << posed << '\n';
+            CHECK(g.unload_world());
+            CHECK(g.world_revision > revision);
+            revision = g.world_revision;
+            CHECK(world_draws(mesh, g.objects, draws, stats, error));
+            CHECK(draws.size() == 1); // CPU cache owns no object identity.
+            mesh = {};
+            CHECK(world_draws(mesh, g.objects, draws, stats, error));
+            CHECK(draws.empty());
+        }
+        return true;
+    }
+} // namespace
+int main(int argc, char** argv)
+{
+    if (argc < 2)
+        return 2;
+    std::string_view c = argv[1];
+    bool ok = c == "lifetime"              ? lifetime()
+              : c == "mesh"                ? mesh_test()
+              : c == "rejects"             ? rejects()
+              : c == "camera"              ? camera()
+              : c == "subway" && argc == 3 ? private_world(argv[2])
+                                           : false;
+    return ok ? 0 : 1;
+}
