876: void AI_Mgr::OnStringKey(ArgList* pArgList)
877: {
878: 	if (!m_pServerDE || !pArgList || !pArgList->argv || pArgList->argc == 0) return;
879: 
880: 	char* pKey = pArgList->argv[0];
881: 	if (!pKey) return;
882: 
883: 	char szTemp[32];
884: 
885: 	//fire current weapon 
886: 	if(Sparam_Get(szTemp,pKey,"fire_key"))
887: 	{
888: 		if(m_hTarget == DNULL)
889: 			return;
890: 
891: 		Fire();
892: 	}
893: 	else if(Sparam_Get(szTemp,pKey,"show_weapon"))
894: 	{
895: 		char szTmp[8];
896: 		int nNum = atoi(szTmp);
897: 
898: 		CWeapon* pW = m_InventoryMgr.GetCurrentWeapon();
899: 
900: 		if(pW)
901: 			pW->ShowHandModel(nNum);
902: 	}
903: 	else if(Sparam_Get(szTemp,pKey,"extra_key"))
904: 	{
905: 		MC_Extra(szTemp);
906: 	}
907: 	else if(Sparam_Get(szTemp,pKey,"play_sound"))
908: 	{
909: 		//scripted scene? disable!!
910: 		if(g_hActiveCamera && m_nState != STATE_Script ) // && m_nState != STATE_Passive && m_nState != STATE_Idle)
911: 		{
912: 			CameraObj* pCameraObj = (CameraObj*)m_pServerDE->HandleToObject(g_hActiveCamera);
913: 			if(!pCameraObj->AllowPlayerMovement())
914: 			{
915: 				return;
916: 			}
917: 		}
918: 
919: 		if(m_nState != STATE_Script)
920: 		{
921: 			char szSound[256];
922: 			char szTmp[8];
923: 
924: 			if(Sparam_Get(szTmp,pKey,"sound_random"))
925: 			{
926: 				int nMax = atoi(szTmp);
927: 				int nNum = m_pServerDE->IntRandom(1,NRES(nMax));
928: 				sprintf(szSound, "%s%d.wav", szTemp, nNum);
929: 			}
930: 			else
931: 			{
932: 				sprintf(szSound, "%s.wav", szTemp);
933: 			}
934: 
935: 			DFLOAT fRadius = 1000.0f;
936: 
937: 			if(Sparam_Get(szTmp,pKey,"sound_radius"))
938: 			{
939: 				fRadius = (DFLOAT)atof(szTmp);
940: 			}
941: 
942: 			int nVol = 100;
943: 
944: 			if(Sparam_Get(szTmp,pKey,"sound_volume"))
945: 			{
946: 				nVol = atoi(szTmp);
947: 			}
948: 
949: 			int nChance = 100;
950: 
951: 			if(Sparam_Get(szTmp,pKey,"sound_chance"))
952: 			{
953: 				nChance = atoi(szTmp);
954: 			}
955: 
956: 			DBOOL bVoice = DFALSE;
957: 
958: 			if(Sparam_Get(szTmp,pKey,"sound_voice"))
959: 			{
960: 				bVoice = atoi(szTmp);
961: 			}
962: 
963: 			if(IsRandomChance(nChance))
964: 			{
965: 				if(bVoice)
966: 					m_pAnim_Sound->PlayVoice(m_hObject, szSound, fRadius, nVol);
967: 				else
968: 					m_pAnim_Sound->PlaySound(m_hObject, szSound, fRadius, nVol);
969: 			}
970: 		}
971: 	}
972: 
973: 	CBaseCharacter::OnStringKey(pArgList);
974: 	
975: 	return;

