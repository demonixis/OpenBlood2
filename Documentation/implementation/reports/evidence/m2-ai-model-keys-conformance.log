301: DBOOL CivilianAI::InitialUpdate(DVector *pMovement)
302: {
303: 	m_pServerDE = BaseClass::GetServerDE();
304: 	if (!m_pServerDE) return DFALSE;
305: 
306: 	//Load up animation indexes if first model instance
307: 	if(m_bMale || m_bLabTech && m_bMaleAnims)
308: 	{
309: 		m_Male_Anim_Sound.SetAnimationIndexes(m_hObject);
310: 		m_Male_Anim_Sound.GenerateHitSpheres(m_hObject);
311: 
312: 		m_Male_Anim_Sound.SetSoundRoot("sounds\\enemies\\civilian");
313: 		m_bMaleAnims = DFALSE;
314: 	}
315: 
316: 	if(!m_bMale && m_bFemaleAnims)
317: 	{
318: 		m_Female_Anim_Sound.SetAnimationIndexes(m_hObject);
319: 		m_Female_Anim_Sound.GenerateHitSpheres(m_hObject);
320: 
321: 		m_Female_Anim_Sound.SetSoundRoot("sounds\\enemies\\f_civ");
322: 		m_bFemaleAnims = DFALSE;
323: 	}
324: 
325: 	if(m_bMale || m_bLabTech)
326: 		AI_Mgr::InitStatics(&m_Male_Anim_Sound);
327: 	else
328: 		AI_Mgr::InitStatics(&m_Female_Anim_Sound);
329: 
330: 	return DTRUE;

