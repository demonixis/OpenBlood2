+    std::vector<WorldDraw> draws = {{0, {}, {}}, {1, {}, {}}, {2, {}, {}}};
+    for (unsigned cycle = 0; cycle < 5; ++cycle)
+    {
+        const unsigned w = cycle == 1 ? 400 : 320, h = cycle == 1 ? 300 : 240;
