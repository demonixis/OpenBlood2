{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Development with inspector",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "BLOOD2_BUILD_GAME": true,
        "BLOOD2_BUILD_LAUNCHER": true,
        "BLOOD2_INSPECTOR": true
      }
    },
    {
      "name": "dev",
      "displayName": "Optimized development with inspector",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release",
      "displayName": "Release without inspector",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BLOOD2_INSPECTOR": false
      }
    },
    {
      "name": "launcher-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/launcher-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "BLOOD2_BUILD_GAME": false,
        "BLOOD2_BUILD_LAUNCHER": true,
        "BLOOD2_INSPECTOR": false
      }
    },
    {
      "name": "launcher-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/launcher-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "BLOOD2_BUILD_GAME": false,
        "BLOOD2_BUILD_LAUNCHER": true,
        "BLOOD2_INSPECTOR": false
      }
    },
    {
      "name": "launcher-sanitize",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/launcher-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "BLOOD2_BUILD_GAME": false,
        "BLOOD2_BUILD_LAUNCHER": true,
        "BLOOD2_INSPECTOR": false,
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "BLOOD2_SANITIZERS": true
      }
    },
    {
      "name": "ci-release",
      "displayName": "CI Release game",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/ci/game",
      "cacheVariables": {
        "BLOOD2_GPU_TESTS": false,
        "BLOOD2_TEST_DATA_DIR": "",
        "BLOOD2_DEMO_DATA_DIR": "",
        "BLOOD2_BUILD_LAUNCHER": false
      }
    },
    {
      "name": "ci-launcher-release",
      "displayName": "CI Release launcher",
      "inherits": "launcher-release",
      "binaryDir": "${sourceDir}/build/ci/launcher",
      "cacheVariables": {
        "BLOOD2_GPU_TESTS": false,
        "BLOOD2_TEST_DATA_DIR": "",
        "BLOOD2_DEMO_DATA_DIR": "",
        "OPENSSL_USE_STATIC_LIBS": true,
        "BLOOD2_LAUNCHER_TEST_GAME": ""
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "launcher-debug",
      "configurePreset": "launcher-debug"
    },
    {
      "name": "launcher-release",
      "configurePreset": "launcher-release"
    },
    {
      "name": "launcher-sanitize",
      "configurePreset": "launcher-sanitize"
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release"
    },
    {
      "name": "ci-launcher-release",
      "configurePreset": "ci-launcher-release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "launcher-debug",
      "configurePreset": "launcher-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "launcher-release",
      "configurePreset": "launcher-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "launcher-sanitize",
      "configurePreset": "launcher-sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "headless"
        },
        "exclude": {
          "label": "gpu|private"
        }
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120
      }
    },
    {
      "name": "ci-launcher-release",
      "configurePreset": "ci-launcher-release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "headless"
        },
        "exclude": {
          "label": "gpu|private"
        }
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120
      }
    }
  ]
}
