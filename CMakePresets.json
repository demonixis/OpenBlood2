{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Development with inspector",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "BLOOD2_INSPECTOR": true
      }
    },
    {
      "name": "dev",
      "displayName": "Optimized development with inspector",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release",
      "displayName": "Release without inspector",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BLOOD2_INSPECTOR": false
      }
    },
    {
      "name": "ci-release",
      "displayName": "CI Release game",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/ci/game",
      "cacheVariables": {
        "BLOOD2_GPU_TESTS": false,
        "BLOOD2_TEST_DATA_DIR": "",
        "BLOOD2_DEMO_DATA_DIR": ""
      }
    },
    {
      "name": "xcode-macos",
      "displayName": "Xcode project: macOS game bundle",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/xcode-macos",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "BUILD_TESTING": false,
        "BLOOD2_INSPECTOR": false,
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0"
      }
    },
    {
      "name": "xcode-ios",
      "displayName": "Xcode project: iOS/iPadOS game (device)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/xcode-ios",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "BUILD_TESTING": false,
        "BLOOD2_INSPECTOR": false,
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0"
      }
    },
    {
      "name": "android-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "$env{ANDROID_SDK_ROOT}/ndk/29.0.14206865/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "BUILD_TESTING": false,
        "BLOOD2_INSPECTOR": false,
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_STL": "c++_static"
      }
    },
    {
      "name": "android",
      "displayName": "Android phone/tablet APK (arm64)",
      "inherits": "android-base",
      "binaryDir": "${sourceDir}/build/android",
      "cacheVariables": {
        "ANDROID_PLATFORM": "android-29",
        "BLOOD2_ANDROID_FLAVOR": "phone"
      }
    },
    {
      "name": "quest",
      "displayName": "Meta Quest immersive OpenXR APK (arm64)",
      "inherits": "android-base",
      "binaryDir": "${sourceDir}/build/quest",
      "cacheVariables": {
        "ANDROID_PLATFORM": "android-32",
        "BLOOD2_ANDROID_FLAVOR": "quest",
        "BLOOD2_XR": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release"
    },
    {
      "name": "xcode-macos",
      "configurePreset": "xcode-macos",
      "configuration": "Release"
    },
    {
      "name": "xcode-ios",
      "configurePreset": "xcode-ios",
      "configuration": "Release"
    },
    {
      "name": "android",
      "configurePreset": "android",
      "targets": [
        "blood2_apk"
      ]
    },
    {
      "name": "quest",
      "configurePreset": "quest",
      "targets": [
        "blood2_apk"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "headless"
        },
        "exclude": {
          "label": "gpu|private"
        }
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120
      }
    }
  ]
}
