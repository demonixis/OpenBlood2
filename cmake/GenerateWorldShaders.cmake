# Explicit offline regeneration from the HLSL sources; ordinary builds use the
# checked-in SPIR-V/MSL headers. SHADERCROSS is the pinned SDL_shadercross CLI
# built with DXC (tools/shaders). DXIL is not generated (see the Metal contracts).
if(NOT SHADERCROSS)
    message(FATAL_ERROR "Pass -DSHADERCROSS=<pinned shadercross with DXC>")
endif()
set(shader_dir "${CMAKE_CURRENT_LIST_DIR}/../src/engine/shaders")
if(NOT DEFINED OUTPUT_DIR)
    set(OUTPUT_DIR "${shader_dir}")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
# Temporary binaries/metadata never become distributable game assets.
set(work "${OUTPUT_DIR}/.generation")
file(MAKE_DIRECTORY "${work}")
# Each entry is a generated name <stem>_<vert|frag> compiled from <stem>.<stage>.hlsl, unless
# <name>_source names another file: the enhanced (PBR) fragment variants and the post-processing
# (auxiliary target) variants compile one source with defines.
set(pbr_frag_source pbr.frag)
set(pbr_high_frag_source pbr.frag)
set(pbr_high_frag_defines -DPBR_HIGH)
set(pbr_alpha_frag_source pbr.frag)
set(pbr_alpha_frag_defines -DPBR_ALPHA)
set(pbr_high_alpha_frag_source pbr.frag)
set(pbr_high_alpha_frag_defines -DPBR_HIGH -DPBR_ALPHA)
foreach(variant world sprite pbr pbr_high pbr_alpha pbr_high_alpha)
    if(DEFINED ${variant}_frag_source)
        set(${variant}_aux_frag_source ${${variant}_frag_source})
    else()
        set(${variant}_aux_frag_source ${variant}.frag)
    endif()
    set(${variant}_aux_frag_defines ${${variant}_frag_defines} -DAUX_TARGETS)
endforeach()
foreach(shader world_vert skinned_vert world_frag sprite_frag shadow_frag pbr_frag pbr_high_frag pbr_alpha_frag
        pbr_high_alpha_frag line_vert line_frag world_aux_frag sprite_aux_frag pbr_aux_frag pbr_high_aux_frag
        pbr_alpha_aux_frag pbr_high_alpha_aux_frag post_vert bloom_down_frag bloom_up_frag composite_frag fxaa_frag
        gtao_frag ao_blur_frag)
    string(REGEX REPLACE "_(vert|frag)$" ".\\1" filename "${shader}")
    set(defines ${${shader}_defines})
    if(DEFINED ${shader}_source)
        set(filename "${${shader}_source}")
    endif()
    set(source "${shader_dir}/${filename}.hlsl")
    if(shader MATCHES "_vert$")
        set(stage vertex)
    else()
        set(stage fragment)
    endif()
    foreach(target SPIRV MSL JSON)
        set(extra)
        if(target STREQUAL "MSL")
            set(extra --msl-version 1.2.0)
        endif()
        execute_process(COMMAND "${SHADERCROSS}" "${source}" -s HLSL -d ${target} -t ${stage} -e main ${defines} ${extra}
            -o "${work}/${shader}.${target}" COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
    # SPIR-V words as a C array, little-endian byte order from the binary module.
    file(READ "${work}/${shader}.SPIRV" hex HEX)
    string(LENGTH "${hex}" length)
    math(EXPR remainder "${length} % 8")
    if(length EQUAL 0 OR NOT remainder EQUAL 0)
        message(FATAL_ERROR "${shader}: SPIR-V is not a whole number of words")
    endif()
    math(EXPR last "${length} - 8")
    set(words "")
    set(column 0)
    foreach(offset RANGE 0 ${last} 8)
        string(SUBSTRING "${hex}" ${offset} 8 word)
        string(REGEX REPLACE "^(..)(..)(..)(..)$" "\\4\\3\\2\\1" word "${word}")
        string(APPEND words "0x${word},")
        math(EXPR column "${column} + 1")
        if(column EQUAL 8)
            string(APPEND words "\n")
            set(column 0)
        endif()
    endforeach()
    file(WRITE "${OUTPUT_DIR}/${shader}.h"
        "#pragma once\n// Generated by pinned SDL_shadercross (DXC) from ${filename}.hlsl; see GenerateWorldShaders.cmake.\nconst uint32_t ${shader}[] = {\n${words}\n};\n")
    file(READ "${work}/${shader}.MSL" msl)
    file(READ "${work}/${shader}.JSON" metadata)
    # Sampled images, read-only storage buffers and uniform buffers only. A new
    # resource category requires updating the renderer contract, not dropping it.
    foreach(resource storage_textures readwrite_storage_buffers readwrite_storage_textures)
        string(JSON count ERROR_VARIABLE missing GET "${metadata}" "${resource}")
        if(NOT missing AND NOT count EQUAL 0)
            message(FATAL_ERROR "${shader}: unsupported ${resource}")
        endif()
    endforeach()
    string(JSON samplers GET "${metadata}" samplers)
    string(JSON uniforms GET "${metadata}" uniform_buffers)
    string(JSON storage_buffers GET "${metadata}" storage_buffers)
    if(NOT msl MATCHES "${stage} main0_out main0\\(")
        message(FATAL_ERROR "${shader}: unexpected MSL entry point; inspect shadercross output")
    endif()
    file(WRITE "${OUTPUT_DIR}/${shader}_msl.h"
        "#pragma once\n// Generated by pinned SDL_shadercross (DXC) from ${filename}.hlsl; see GenerateWorldShaders.cmake.\nstatic constexpr unsigned ${shader}_samplers = ${samplers};\nstatic constexpr unsigned ${shader}_uniforms = ${uniforms};\nstatic constexpr unsigned ${shader}_storage_buffers = ${storage_buffers};\nstatic const char ${shader}_msl[] = R\"blood2msl(${msl})blood2msl\";\n")
endforeach()
file(REMOVE_RECURSE "${work}")
