# Explicit offline regeneration; ordinary builds use the checked-in SPIR-V/MSL.
find_program(GLSLANG glslangValidator REQUIRED)
find_program(SHADERCROSS shadercross REQUIRED)
set(shader_dir "${CMAKE_CURRENT_LIST_DIR}/../src/engine/shaders")
if(NOT DEFINED OUTPUT_DIR)
    set(OUTPUT_DIR "${shader_dir}")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
# Temporary binaries/metadata never become distributable game assets.
set(work "${OUTPUT_DIR}/.generation")
file(MAKE_DIRECTORY "${work}")
foreach(shader world_vert skinned_vert world_frag sprite_frag)
    string(REPLACE "_" "." filename "${shader}")
    if(shader MATCHES "_vert$")
        set(stage vertex)
    else()
        set(stage fragment)
    endif()
    execute_process(COMMAND "${GLSLANG}" -V --target-env vulkan1.0
        --vn "${shader}" -o "${OUTPUT_DIR}/${shader}.h" "${shader_dir}/${filename}"
        COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${GLSLANG}" -V --target-env vulkan1.0
        -o "${work}/${shader}.spv" "${shader_dir}/${filename}"
        COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${SHADERCROSS}" "${work}/${shader}.spv"
        -s SPIRV -d MSL -t "${stage}" --msl-version 1.2.0 -o "${work}/${shader}.msl"
        COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${SHADERCROSS}" "${work}/${shader}.spv"
        -s SPIRV -d JSON -t "${stage}" -o "${work}/${shader}.json"
        COMMAND_ERROR_IS_FATAL ANY)
    file(READ "${work}/${shader}.msl" msl)
    file(READ "${work}/${shader}.json" metadata)
    # Sampled images, read-only storage buffers and uniform buffers only. A new
    # resource category requires updating the renderer contract, not dropping it.
    foreach(resource storage_textures readwrite_storage_buffers readwrite_storage_textures)
        string(JSON count ERROR_VARIABLE missing GET "${metadata}" "${resource}")
        if(NOT missing AND NOT count EQUAL 0)
            message(FATAL_ERROR "${shader}: unsupported ${resource}")
        endif()
    endforeach()
    string(JSON samplers GET "${metadata}" samplers)
    string(JSON uniforms GET "${metadata}" uniform_buffers)
    string(JSON storage_buffers GET "${metadata}" storage_buffers)
    if(NOT msl MATCHES "${stage} main0_out main0\\(")
        message(FATAL_ERROR "${shader}: unexpected MSL entry point; inspect shadercross output")
    endif()
    file(WRITE "${OUTPUT_DIR}/${shader}_msl.h"
        "#pragma once\n// Generated by pinned SDL_shadercross; see tools/shaders and GenerateWorldShaders.cmake.\nstatic constexpr unsigned ${shader}_samplers = ${samplers};\nstatic constexpr unsigned ${shader}_uniforms = ${uniforms};\nstatic constexpr unsigned ${shader}_storage_buffers = ${storage_buffers};\nstatic const char ${shader}_msl[] = R\"blood2msl(${msl})blood2msl\";\n")
endforeach()
file(REMOVE_RECURSE "${work}")
