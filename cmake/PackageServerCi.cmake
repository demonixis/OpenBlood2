cmake_minimum_required(VERSION 3.28)
# Run from any directory after ci-server has built and passed its synthetic tests.
if(NOT PLATFORM MATCHES "^(linux-x64|windows-x64|macos-arm64)$")
    message(FATAL_ERROR "Set PLATFORM to linux-x64, windows-x64 or macos-arm64")
endif()
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED SERVER_BUILD)
    set(SERVER_BUILD "${source}/build/ci/server")
endif()
file(STRINGS "${source}/CMakeLists.txt" project_line REGEX "^project\\(Blood2 VERSION ")
string(REGEX REPLACE "^project\\(Blood2 VERSION ([0-9]+\\.[0-9]+\\.[0-9]+).*" "\\1" version "${project_line}")
if(NOT version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "Cannot read project version")
endif()
if("$ENV{GITHUB_REF_TYPE}" STREQUAL "tag" AND NOT "$ENV{GITHUB_REF_NAME}" STREQUAL "v${version}")
    message(FATAL_ERROR "Release tag does not match project version ${version}")
endif()
set(name "OpenBlood2-server-${version}-${PLATFORM}")
set(dist "${SERVER_BUILD}/dist")
set(package "${dist}/${name}")
if(EXISTS "${package}")
    message(FATAL_ERROR "Package already exists: ${package}; remove it before repackaging")
endif()
set(suffix "")
if(CMAKE_HOST_WIN32)
    set(suffix .exe)
endif()
file(MAKE_DIRECTORY "${package}/licenses")
file(COPY "${SERVER_BUILD}/blood2-server${suffix}" "${source}/LICENSE" DESTINATION "${package}")
foreach(license IN ITEMS SDL spdlog enet)
    file(COPY "${SERVER_BUILD}/licenses/${license}.txt" DESTINATION "${package}/licenses")
endforeach()
file(COPY "${source}/Documentation/dedicated_server.md" DESTINATION "${package}/Documentation")
file(COPY "${source}/Documentation/contracts/multiplayer_contracts.md" DESTINATION "${package}/Documentation/contracts")
file(COPY "${source}/Documentation/implementation/reports/m9_multiplayer.md"
    "${source}/Documentation/implementation/reports/m9_admission.md"
    "${source}/Documentation/implementation/reports/m9_world_baseline.md"
    DESTINATION "${package}/Documentation/implementation/reports")
file(COPY "${source}/Documentation/implementation/sources/m9_foundation_sources.json"
    "${source}/Documentation/implementation/sources/m9_admission_sources.json"
    "${source}/Documentation/implementation/sources/m9_world_baseline_sources.json"
    DESTINATION "${package}/Documentation/implementation/sources")
file(WRITE "${package}/README.txt"
    "OpenBlood2 dedicated server (M9). Bloodbath initial world replication is available; gameplay updates are pending.\nSee Documentation/dedicated_server.md for build status, data configuration and usage.\n")
file(COPY "${source}/Documentation/implementation/provenance.md" DESTINATION "${package}/Documentation/implementation")
if(CMAKE_HOST_WIN32)
    file(TO_CMAKE_PATH "$ENV{VCToolsRedistDir}" redist)
    file(GLOB runtime "${redist}/x64/Microsoft.VC*.CRT/*.dll")
    if(NOT runtime)
        message(FATAL_ERROR "No x64 MSVC runtime under VCToolsRedistDir")
    endif()
    file(COPY ${runtime} DESTINATION "${package}")
    set(run_environment "${CMAKE_COMMAND}" -E env "PATH=$ENV{SystemRoot}/System32")
endif()
if(CMAKE_HOST_APPLE)
    execute_process(COMMAND otool -L "${package}/blood2-server"
        OUTPUT_VARIABLE linked COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCHALL "\n[ \t]+[^\n]+" dependencies "${linked}")
    foreach(dependency IN LISTS dependencies)
        string(STRIP "${dependency}" dependency)
        if(NOT dependency MATCHES "^(/usr/lib/|/System/Library/)")
            message(FATAL_ERROR "Non-system server dependency: ${dependency}")
        endif()
    endforeach()
endif()
execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${source}"
    OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
file(WRITE "${package}/BUILD.txt"
    "OpenBlood2 ${version}\nDedicated server; Bloodbath initial replication, gameplay updates pending\nPlatform: ${PLATFORM}\nConfiguration: Release\nCommit: ${revision}\n")
execute_process(COMMAND ${run_environment} "${package}/blood2-server${suffix}" --help
    WORKING_DIRECTORY "${package}" COMMAND_ERROR_IS_FATAL ANY)
if(CMAKE_HOST_WIN32)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${name}.zip" --format=zip "${name}"
        WORKING_DIRECTORY "${dist}" COMMAND_ERROR_IS_FATAL ANY)
else()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${name}.tar.gz" "${name}"
        WORKING_DIRECTORY "${dist}" COMMAND_ERROR_IS_FATAL ANY)
endif()
