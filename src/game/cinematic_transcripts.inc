// English speech heard in stock WAVs that have no matching source text entry.
// Full paths disambiguate reused filenames. The last field opts into gameplay captions.
{"sounds/chosen/caleb/e1m1_1_cal.wav", "dialogue.sounds.chosen.caleb.e1m1_1_cal",
 "I'm not a bad dream. I'm their worst nightmare."},
{"sounds/chosen/caleb/e1m1_3_cal.wav", "dialogue.sounds.chosen.caleb.e1m1_3_cal",
 "Now, where did all those gun-toting madmen get to?", true},
{"sounds/chosen/caleb/e1m1_4_cal.wav", "dialogue.sounds.chosen.caleb.e1m1_4_cal",
 "Get ready for a surprise. Here's Caleb!", true},
{"sounds/chosen/caleb/e1m1_8_cal.wav", "dialogue.sounds.chosen.caleb.e1m1_8_cal",
 "Eviction time!", true},
{"sounds/chosen/caleb/e1m3_2_cal.wav", "dialogue.sounds.chosen.caleb.e1m3_2_cal",
 "They just don't make them like they used to."},
{"sounds/chosen/caleb/e1m3_3_cal.wav", "dialogue.sounds.chosen.caleb.e1m3_3_cal",
 "Hmm, I'll take a BLT. That's a lettuce, tomato, and blood sandwich. Hold the mayo, huh?", true},
{"sounds/chosen/caleb/e1m3_4_cal.wav", "dialogue.sounds.chosen.caleb.e1m3_4_cal",
 "Ah, now that's a spicy meatball.", true},
{"sounds/chosen/caleb/e1m4_1_cal.wav", "dialogue.sounds.chosen.caleb.e1m4_1_cal",
 "Looks like there's killing to do."},
{"sounds/chosen/caleb/e1m4_2_cal.wav", "dialogue.sounds.chosen.caleb.e1m4_2_cal",
 "Ah, this place is a hellhole. Heh heh, I like it.", true},
{"sounds/chosen/caleb/e1m4e3a_cal.wav", "dialogue.6caleb1",
 "These aren't Cabal."},
{"sounds/chosen/caleb/e1m4e5a_cal.wav", "dialogue.sounds.chosen.caleb.e1m4e5a_cal",
 "Hell if I know. What do you care? You don't seem to be having any problems with him."},
{"sounds/chosen/caleb/e1m4e7a_cal.wav", "dialogue.sounds.chosen.caleb.e1m4e7a_cal",
 "What's that supposed to mean?"},
{"sounds/chosen/caleb/e1m4e9a_cal.wav", "dialogue.sounds.chosen.caleb.e1m4e9a_cal",
 "I will solve it!"},
{"sounds/chosen/caleb/e1m5_1_cal.wav", "dialogue.sounds.chosen.caleb.e1m5_1_cal",
 "Hey, this place should be giving me kickbacks."},
{"sounds/chosen/caleb/e1m5_3_cal.wav", "dialogue.sounds.chosen.caleb.e1m5_3_cal",
 "Hmm, this is gonna get a lot worse before it gets better.", true},
{"sounds/chosen/caleb/e1m5_5_cal.wav", "dialogue.sounds.chosen.caleb.e1m5_5_cal",
 "Ugh. At least I'm not the only old dead guy down here.", true},
{"sounds/chosen/caleb/e2m5_1_cal.wav", "dialogue.sounds.chosen.caleb.e2m5_1_cal",
 "It's Howdy Doody time, kiddies. The bad man is here.", true},
{"sounds/chosen/caleb/e2m5_2_cal.wav", "dialogue.sounds.chosen.caleb.e2m5_2_cal",
 "Well, that's one way to open somebody up, but not nearly as quick or fun as my method."},
{"sounds/chosen/caleb/e2m5_4_cal.wav", "dialogue.sounds.chosen.caleb.e2m5_4_cal",
 "Ugh, I feel like a piece of meat.", true},
{"sounds/chosen/caleb/e3m1_2_cal.wav", "dialogue.sounds.chosen.caleb.e3m1_2_cal",
 "Now we're cooking with GAS!"},
{"sounds/chosen/caleb/e3m1_3_cal.wav", "dialogue.sounds.chosen.caleb.e3m1_3_cal",
 "Ahhh, nothing's ever easy."},
{"sounds/chosen/caleb/e3m2_1_cal.wav", "dialogue.sounds.chosen.caleb.e3m2_1_cal",
 "What a waste of good ammunition!"},
{"sounds/chosen/caleb/e3m2_2_cal.wav", "dialogue.sounds.chosen.caleb.e3m2_2_cal",
 "Hmm, a security checkpoint. Oh, damn. I guess I'm foiled. I'll have to turn back."},
{"sounds/chosen/caleb/e3m2_3_cal.wav", "dialogue.sounds.chosen.caleb.e3m2_3_cal",
 "Wow, with such spacious accommodations, perhaps I should seek employment here."},
{"sounds/chosen/caleb/e3m3_1_cal.wav", "dialogue.sounds.chosen.caleb.e3m3_1_cal",
 "Good morning, and in case I don't see you again, good afternoon, good evening, and good night!"},
{"sounds/chosen/caleb/e3m3_2_cal.wav", "dialogue.sounds.chosen.caleb.e3m3_2_cal",
 "That's him. That's the man I'm looking for."},
{"sounds/chosen/caleb/e3m3_3_cal.wav", "dialogue.sounds.chosen.caleb.e3m3_3_cal",
 "I'm no mechanic. I just mostly hurt people. Going down."},
{"sounds/chosen/caleb/e3m5_1_cal.wav", "dialogue.sounds.chosen.caleb.e3m5_1_cal",
 "You know this place seems almost unreal."},
{"sounds/chosen/caleb/e3m5_3_cal.wav", "dialogue.sounds.chosen.caleb.e3m5_3_cal",
 "This bridge looks perfectly safe to cross."},
{"sounds/chosen/caleb/e3m5_4_cal.wav", "dialogue.sounds.chosen.caleb.e3m5_4_cal",
 "A fine example of typical Cabal construction."},
{"sounds/chosen/caleb/kill/c_1liner_2.wav", "dialogue.sounds.chosen.caleb.kill.c_1liner_2",
 "Everybody dies."},
{"sounds/chosen/caleb/msc11cal.wav", "dialogue.sounds.chosen.caleb.msc11cal",
 "I'd say I'm sorry, but you know it wouldn't be sincere. Have a nice day."},
{"sounds/chosen/caleb/msc14_cal.wav", "dialogue.sounds.chosen.caleb.msc14_cal",
 "Mmm, nothing like fresh-packed meat."},
{"sounds/chosen/caleb/msc15_cal.wav", "dialogue.sounds.chosen.caleb.msc15_cal",
 "Meat inspector. I'm afraid I'm gonna have to shut you down."},
{"sounds/chosen/caleb/msc16_cal.wav", "dialogue.sounds.chosen.caleb.msc16_cal",
 "Oh, what a mess. These conditions are hardly sanitary.", true},
{"sounds/chosen/caleb/msc17_cal.wav", "dialogue.sounds.chosen.caleb.msc17_cal",
 "Mmm, grape is my favorite. Yum!", true},
{"sounds/chosen/caleb/msc18_cal.wav", "dialogue.sounds.chosen.caleb.msc18_cal",
 "Back to the grind..."},
{"sounds/chosen/caleb/msccaleb1.wav", "dialogue.sounds.chosen.caleb.msccaleb1",
 "Locked.", true},
{"sounds/chosen/caleb/msccaleb2.wav", "dialogue.sounds.chosen.caleb.msccaleb2",
 "It's stuck.", true},
{"sounds/chosen/caleb/subbcaleb1.wav", "dialogue.8caleb1",
 "You've gotta be kidding."},
{"sounds/chosen/caleb/taunt/tnt5_cal.wav", "dialogue.sounds.chosen.caleb.taunt.tnt5_cal",
 "Yeah, and I thought I was ugly."},
{"sounds/chosen/gabriella/e1m4e3_gab.wav", "dialogue.sounds.chosen.gabriella.e1m4e3_gab",
 "Someone's got to hold the train. These things are everywhere out there. The Cabal must be pretty desperate "
 "to be creating such creatures."},
{"sounds/chosen/gabriella/e1m4e4_gab.wav", "dialogue.6gab2",
 "Then what are they?"},
{"sounds/chosen/gabriella/e1m4e6_gab.wav", "dialogue.sounds.chosen.gabriella.e1m4e6_gab",
 "I don't have problems. I solve them."},
{"sounds/chosen/gabriella/e1m4e8_gab.wav", "dialogue.sounds.chosen.gabriella.e1m4e8_gab",
 "I'm not sure I can count on you anymore. This is becoming a bad situation. And if you can't solve it, I "
 "will."},
{"sounds/enemies/ancientone/ancient1.wav", "dialogue.17ish1",
 "Insect, we are the Ancient One.  Bow down before us."},
{"sounds/enemies/ancientone/ancient2.wav", "dialogue.17ish2",
 "You are all that stands between us and dominion?  Pathetic."},
{"sounds/enemies/ancientone/ancient3.wav", "dialogue.17ish3",
 "All that is will no longer be.  All that was has never been.  All that was to come... um..."},
{"sounds/enemies/ancientone/ancient4.wav", "dialogue.17ish4",
 "All that was to come will never... happen."},
{"sounds/enemies/civilian/02civ1.wav", "dialogue.sounds.enemies.civilian.02civ1",
 "Hey, buddy, you all right? You look like hell."},
{"sounds/enemies/civilian/02civ3.wav", "dialogue.sounds.enemies.civilian.02civ3",
 "Hey, I think the train is out. You know what? Maybe we should catch a cab."},
{"sounds/enemies/civilian/02civ4.wav", "dialogue.sounds.enemies.civilian.02civ4",
 "You gonna bark all day little doggy or you gonna bite?"},
{"sounds/enemies/civilian/02civ5.wav", "dialogue.sounds.enemies.civilian.02civ5",
 "No weapons allowed in here, buddy! Unless you buy it for me."},
{"sounds/enemies/civilian/11civ2.wav", "dialogue.sounds.enemies.civilian.11civ2",
 "Anything except hamburgers."},
{"sounds/enemies/civilian/11civ4.wav", "dialogue.sounds.enemies.civilian.11civ4",
 "Yeah, I got a hot dog for you."},
{"sounds/enemies/civilian/12civ2.wav", "dialogue.sounds.enemies.civilian.12civ2",
 "Oh, crap!"},
{"sounds/enemies/civilian/12civ3.wav", "dialogue.sounds.enemies.civilian.12civ3",
 "There's nobody home. Go away."},
{"sounds/enemies/civilian/12civ4.wav", "dialogue.sounds.enemies.civilian.12civ4",
 "Leave me alone!"},
{"sounds/enemies/civilian/12civ5.wav", "dialogue.sounds.enemies.civilian.12civ5",
 "I don't want any!"},
{"sounds/enemies/civilian/idle2.wav", "dialogue.sounds.enemies.civilian.idle2",
 "This is not happening. This is not happening. This is not happening. This is not happening.", true},
{"sounds/enemies/civilian/spot11.wav", "dialogue.sounds.enemies.civilian.spot11",
 "Ah, shit. This is not my day."},
{"sounds/enemies/civilian/spot2.wav", "dialogue.sounds.enemies.civilian.spot2",
 "This place is a madhouse!"},
{"sounds/enemies/f_civ/02civ2.wav", "dialogue.sounds.enemies.f_civ.02civ2",
 "This can't be happening. I'm gonna be late for work!"},
{"sounds/enemies/f_civ/02civ8.wav", "dialogue.sounds.enemies.f_civ.02civ8",
 "I don't know, I just stuck his head in too far, I guess."},
{"sounds/enemies/f_civ/09civ.wav", "dialogue.sounds.enemies.f_civ.09civ",
 "Who is it?"},
{"sounds/enemies/f_civ/09civ3.wav", "dialogue.sounds.enemies.f_civ.09civ3",
 "Really? Cool. I'm buzzing you in."},
{"sounds/enemies/f_civ/11civ1.wav", "dialogue.sounds.enemies.f_civ.11civ1",
 "Man, all this gristle is making me hungry. What do you want for lunch?"},
{"sounds/enemies/f_civ/11civ3.wav", "dialogue.sounds.enemies.f_civ.11civ3",
 "How about a hot dog?"},
{"sounds/enemies/f_civ/spot3.wav", "dialogue.sounds.enemies.f_civ.spot3",
 "Everything's going to hell here! What is this?"},
{"sounds/enemies/gideon/15gid2b.wav", "dialogue.sounds.enemies.gideon.15gid2b",
 "You have no idea how exquisite pain can feel. Allow me to demonstrate."},
{"sounds/enemies/gideon/tnt4_gid.wav", "dialogue.sounds.enemies.gideon.tnt4_gid",
 "Today, I witness the fall of the Great Betrayer!"},
{"sounds/enemies/gideon/tnt7_gid.wav", "dialogue.sounds.enemies.gideon.tnt7_gid",
 "You will be purged. The Cabal will live again!"},
{"sounds/enemies/loudspeaker/2loudspker.wav", "dialogue.sounds.enemies.loudspeaker.2loudspker",
 "The Lafayette Museum of Antiquities is now closed. Normal operating hours are 3 to 5 p.m. daily. Admission "
 "is $17. Please keep your children on a leash at all times. Thank you."},
{"sounds/enemies/prophet/spot3.wav", "dialogue.sounds.enemies.prophet.spot3",
 "Hello."},
{"sounds/events/cwvoice10.wav", "dialogue.sounds.events.cwvoice10",
 "Emergency self-destruct initiated. Self-destruct in 60 seconds.", true},
{"sounds/events/cwvoice11.wav", "dialogue.sounds.events.cwvoice11",
 "Processors shut down."},
{"sounds/events/cwvoice5.wav", "dialogue.sounds.events.cwvoice5",
 "Access granted.", true},
{"sounds/events/cwvoice6.wav", "dialogue.sounds.events.cwvoice6",
 "Access denied.", true},
{"sounds/events/cwvoice8.wav", "dialogue.sounds.events.cwvoice8",
 "Force field deactivated."},
{"sounds/events/cwvoice9.wav", "dialogue.sounds.events.cwvoice9",
 "Cryo-storage retrieval unit activated."},
{"sounds/events/davoice1.wav", "dialogue.sounds.events.davoice1",
 "Welcome to the Lafayette Antiquities Museum. Make sure and visit our newly restored Egyptian exhibits "
 "during your stay. Today's feature exhibit is on cults and rituals. Make sure and visit the North Wing with "
 "a half-scale reproduction of a mythical cult god."},
{"sounds/events/davoice2.wav", "dialogue.sounds.events.davoice2",
 "The Incas worshipped the high peaks that pierced the South American skies. These rugged summits "
 "represented a means of approaching the Sun God, the center of their religion, and many sacrifices were "
 "made atop these cold and unpredictable pinnacles."},
{"sounds/events/davoice3.wav", "dialogue.sounds.events.davoice3",
 "These ancient mummies were unearthed from the tombs beneath Saqqara. From the dawn of the ancient Egyptian "
 "civilization to its twilight more than 3,000 years later, it was used as a cemetery for the elite living "
 "in nearby Memphis. During the Early Dynastic Period and the Old Kingdom, several Egyptian kings preferred "
 "Saqqara as a burial place."},
{"sounds/events/psvoice1.wav", "dialogue.sounds.events.psvoice1",
 "Dr. Vandervoort, please report to the dissection room. We have a bleeder in need of attention.", true},
{"sounds/events/psvoice10j.wav", "dialogue.sounds.events.psvoice10j",
 "Remember, progress before safety.", true},
{"sounds/events/psvoice11j.wav", "dialogue.sounds.events.psvoice11j",
 "Please be advised, we have an intruder on level 3. He's armed and extremely dangerous. Please do not "
 "approach this man under any circumstances. In fact, run as fast as you can in the opposite direction. "
 "Thank you and have a nice day.", true},
{"sounds/events/psvoice2l.wav", "dialogue.sounds.events.psvoice2l",
 "Dr. Kohler, report to the front desk. Dr. Kohler, please report to the front desk. Your boyfriend is "
 "waiting.", true},
{"sounds/events/psvoice3.wav", "dialogue.sounds.events.psvoice3",
 "Dr. Cattell, emergency in Examination Lab 7.", true},
{"sounds/events/psvoice7l.wav", "dialogue.sounds.events.psvoice7l",
 "Dr. Coleman to neurology. Dr. Coleman, please report to neurology.", true},
{"sounds/events/psvoice8l.wav", "dialogue.sounds.events.psvoice8l",
 "Will the staff on levels 10, 11, and 12 please report to decontamination.", true},
{"sounds/events/tavoice1.wav", "dialogue.sounds.events.tavoice1",
 "Welcome to the Cabalco intercity transit system. We realize you have a choice when it comes to mass "
 "transit, and we're thrilled that you have chosen Cabalco.", true},
{"sounds/events/tavoice2a.wav", "dialogue.sounds.events.tavoice2a",
 "The Cabalco intercity transit system is getting a facelift. Muggings are down 13%, random beatings are "
 "down 6%, murders are down 3%, and mass system failures are down a big 7%. Unfortunately, animal "
 "mutilations are up a staggering 96%.", true},
{"sounds/events/tavoice3.wav", "dialogue.sounds.events.tavoice3",
 "Impaling your fellow passengers with sharp objects is strictly prohibited. Thank you.", true},
{"sounds/events/tavoice4.wav", "dialogue.sounds.events.tavoice4",
 "Cabalco Transit is a no-smoking environment. Thank you.", true},
{"sounds/events/tavoice5.wav", "dialogue.sounds.events.tavoice5",
 "Now approaching the Downtown Express.", true},
{"sounds/events/tavoice6.wav", "dialogue.sounds.events.tavoice6",
 "Next stop, Pickman Street.", true},
{"sounds/events/tavoice7.wav", "dialogue.sounds.events.tavoice7",
 "Entering the industrial sector.", true},
{"sounds/events/tavoice8.wav", "dialogue.sounds.events.tavoice8",
 "Next stop, Ingram Street.", true},
{"sounds/events/tavoice9.wav", "dialogue.sounds.events.tavoice9",
 "Please keep arms and legs inside the train at all times. If quick disposal is necessary, detached "
 "appendages can be deposited into any of the sterile limb receptacles located near every exit. Thank you "
 "for keeping Cabalco Transit clean and safe.", true},
{"sounds/events/vent2.wav", "dialogue.sounds.events.vent2",
 "I'm burnt very, very badly, but I'm not quite dead yet."},
{"sounds/phones/phone11.wav", "dialogue.sounds.phones.phone11",
 "Who is this? Stop calling here!"},
{"sounds/phones/phone12.wav", "dialogue.sounds.phones.phone12",
 "When I was young, we didn't have any Singularity Generators. We had to kill the Drudge Priest with our "
 "bare hands! And we liked it! He'd reach up and grab his Bone Leech and rip it off!"},
{"sounds/phones/phone13.wav", "dialogue.sounds.phones.phone13",
 "When I was young, we didn't have any Life Leeches! We had to kill those Soul Drudges with our bare hands! "
 "We had to bite their legs off, and they'd keep coming back! We didn't care! We liked it that way!"},
{"sounds/phones/phone2.wav", "dialogue.sounds.phones.phone2",
 "Um, good morning, afternoon, evening, Mr. Cal Eb. I'm with a market research firm and we're doing a survey "
 "on computer games. This call is not an attempt to sell you anything. First question: are you currently or "
 "have you ever been a character in a computer game?"},
{"sounds/phones/phone4.wav", "dialogue.sounds.phones.phone4",
 "The number you have reached is not in service at this time. Please stay on the line like an idiot, and no "
 "one will answer. This is a recording."},
{"sounds/phones/phone6.wav", "dialogue.sounds.phones.phone6",
 "Why can't I find Amanda Huggin' Kiss? Can you help me find Amanda Huggin' Kiss?"},
{"sounds/phones/phone8.wav", "dialogue.sounds.phones.phone8",
 "Somebody check the men's room for a huge ass!"},

// Nightmares dialogue transcribed against stock cinematic WAVs.
{"sounds_ao/chosen/caleb/calebintro1.wav", "dialogue.sounds_ao.chosen.caleb.calebintro1.1",
 "So there I was, stranded in the icy wastes, low on ammo and out of rotgut, and hunted by Cabal patrols.", false, 0, 10.50},
{"sounds_ao/chosen/caleb/calebintro1.wav", "dialogue.sounds_ao.chosen.caleb.calebintro1.2",
 "I could hardly see through all the snow, but up ahead I thought I saw a light, greenish, kind of "
 "haunting.", false, 10.50, 18.80},
{"sounds_ao/chosen/caleb/calebintro1.wav", "dialogue.sounds_ao.chosen.caleb.calebintro1.3",
 "Eh, my kind of digs, I remember thinking.", false, 18.80, 22.66},
{"sounds_ao/chosen/caleb/calebintro1.wav", "dialogue.sounds_ao.chosen.caleb.calebintro1.4",
 "Well, so I trudged on up and… Whoa, feeling funky here, guys?", false, 22.66, 30.41},
{"sounds_ao/chosen/caleb/calebl1a.wav", "dialogue.sounds_ao.chosen.caleb.calebl1a",
 "What in the hell? What is this? Some kind of freaky time warp acid trip?"},
{"sounds_ao/chosen/caleb/calebl1b.wav", "dialogue.sounds_ao.chosen.caleb.calebl1b",
 "Dammit, another portal? Ugh, I hate these things. Ah, well, here goes."},
{"sounds_ao/chosen/caleb/calebl2a.wav", "dialogue.sounds_ao.chosen.caleb.calebl2a",
 "What the… Ophelia, what's going on?"},
{"sounds_ao/chosen/caleb/calebl2b.wav", "dialogue.sounds_ao.chosen.caleb.calebl2b",
 "Where am I? Hmm, some kind of frat house. Oh wait, no, it can't be!"},
{"sounds_ao/chosen/caleb/calebl2c.wav", "dialogue.sounds_ao.chosen.caleb.calebl2c",
 "I don't think so, sister. Oh no, it's happening again!"},
{"sounds_ao/chosen/caleb/calebl3a.wav", "dialogue.sounds_ao.chosen.caleb.calebl3a",
 "Freakin' time orbs. I'm getting sick of this."},
{"sounds_ao/chosen/caleb/calebl3b.wav", "dialogue.sounds_ao.chosen.caleb.calebl3b",
 "What? JoJo?"},
{"sounds_ao/chosen/caleb/calebl3c.wav", "dialogue.sounds_ao.chosen.caleb.calebl3c",
 "Well, I'll be damned. Hey, can you do that tightrope act for me real quick? I always love that one. "
 "Uh-oh."},
{"sounds_ao/chosen/caleb/calebl4at1.wav", "dialogue.sounds_ao.chosen.caleb.calebl4at1",
 "For the love of…"},
{"sounds_ao/chosen/caleb/calebl4b.wav", "dialogue.sounds_ao.chosen.caleb.calebl4b",
 "Hey there, Gabriella."},
{"sounds_ao/chosen/caleb/calebl4c.wav", "dialogue.sounds_ao.chosen.caleb.calebl4c",
 "Whatever. Well, I sense a pattern here. Question is, where will I be whisked off to next? I'm all outta "
 "Chosen to visit."},
{"sounds_ao/chosen/caleb/calebl4d.wav", "dialogue.sounds_ao.chosen.caleb.calebl4d",
 "Okay, see ya."},
{"sounds_ao/chosen/caleb/calebl6a.wav", "dialogue.sounds_ao.chosen.caleb.calebl6a",
 "So you're the thing that's been dragging me through all these rifts. Now you're gonna pay, and my weenies "
 "better not be burnt when I get back, huh?"},
{"sounds_ao/chosen/caleb/llcaleb1a.wav", "dialogue.sounds_ao.chosen.caleb.llcaleb1a",
 "Ooh, so cold."},
{"sounds_ao/chosen/caleb/llcaleb1b.wav", "dialogue.sounds_ao.chosen.caleb.llcaleb1b",
 "A hedge maze. How delightful!"},
{"sounds_ao/chosen/caleb/llcaleb2a.wav", "dialogue.sounds_ao.chosen.caleb.llcaleb2a",
 "Oh, my head! A church? Oh, this really is a nightmare."},
{"sounds_ao/chosen/caleb/llcaleb2d.wav", "dialogue.sounds_ao.chosen.caleb.llcaleb2d",
 "Get along, little dogies. You know that Wyoming will be your new home."},
{"sounds_ao/chosen/caleb/llcaleb2e.wav", "dialogue.sounds_ao.chosen.caleb.llcaleb2e",
 "Time to drink this hangover away."},
{"sounds_ao/chosen/caleb/llcaleb2g.wav", "dialogue.sounds_ao.chosen.caleb.llcaleb2g",
 "Ah, yeah, that'll put some hair in your ass."},
{"sounds_ao/chosen/caleb/llcaleb2h.wav", "dialogue.sounds_ao.chosen.caleb.llcaleb2h",
 "Ah, hair of the dog that bit you."},
{"sounds_ao/chosen/caleb/llcaleb2i.wav", "dialogue.sounds_ao.chosen.caleb.llcaleb2i",
 "Hmm… This is the best level I've been in."},
{"sounds_ao/chosen/caleb/llcaleb2j.wav", "dialogue.sounds_ao.chosen.caleb.llcaleb2j",
 "My tummy feels funny."},
{"sounds_ao/chosen/gabriella/gab43.wav", "dialogue.sounds_ao.chosen.gabriella.gab43",
 "You!"},
{"sounds_ao/chosen/gabriella/gab44.wav", "dialogue.sounds_ao.chosen.gabriella.gab44",
 "Gabriella."},
{"sounds_ao/chosen/gabriella/gab45.wav", "dialogue.sounds_ao.chosen.gabriella.gab45",
 "Beats me. Just get on with it. I'm tired."},
{"sounds_ao/chosen/gabriella/gabint11.wav", "dialogue.sounds_ao.chosen.gabriella.gabint11",
 "So, Ophelia, what's your scariest story? Chipped a nail reloading once?"},
{"sounds_ao/chosen/gabriella/gabint21.wav", "dialogue.sounds_ao.chosen.gabriella.gabint21.1",
 "Of course!", false, 0, 1.92},
{"sounds_ao/chosen/gabriella/gabint21.wav", "dialogue.sounds_ao.chosen.gabriella.gabint21.2",
 "When I was a child, my papa would take me to the freak show every year, and every year I would see JoJo.", false, 1.92, 8.52},
{"sounds_ao/chosen/gabriella/gabint21.wav", "dialogue.sounds_ao.chosen.gabriella.gabint21.3",
 "I used to throw little clumps of dirt at him.", false, 8.52, 11.08},
{"sounds_ao/chosen/gabriella/gabint31.wav", "dialogue.sounds_ao.chosen.gabriella.gabint31",
 "One time I had to stay in a spooky mansion overnight."},
{"sounds_ao/chosen/gabriella/gabint32.wav", "dialogue.sounds_ao.chosen.gabriella.gabint32",
 "And that's it. It was scary."},
{"sounds_ao/chosen/gabriella/gabint33.wav", "dialogue.sounds_ao.chosen.gabriella.gabint33",
 "No!"},
{"sounds_ao/chosen/gabriella/gabint34.wav", "dialogue.sounds_ao.chosen.gabriella.gabint34",
 "Want me to tell this story or not?"},
{"sounds_ao/chosen/gabriella/gabint35.wav", "dialogue.sounds_ao.chosen.gabriella.gabint35",
 "It's much scarier if I go over the details."},
{"sounds_ao/chosen/gabriella/gabint36.wav", "dialogue.sounds_ao.chosen.gabriella.gabint36.1",
 "Good, now shut up, both of you!", false, 0, 2.40},
{"sounds_ao/chosen/gabriella/gabint36.wav", "dialogue.sounds_ao.chosen.gabriella.gabint36.2",
 "So there I am at this old, rotted mansion, deep in the sodden bayou near where I grew up.", false, 2.40, 8.90},
{"sounds_ao/chosen/gabriella/gabint36.wav", "dialogue.sounds_ao.chosen.gabriella.gabint36.3",
 "It's a cloudy night, and the air is filled with fog and swamp gas.", false, 8.90, 14.57},
{"sounds_ao/chosen/gabriella/gabint41.wav", "dialogue.sounds_ao.chosen.gabriella.gabint41",
 "Looks like I'm spending the night here. I might as well look around and try to find a bedroom."},
{"sounds_ao/chosen/gabriella/gabint42.wav", "dialogue.sounds_ao.chosen.gabriella.gabint42",
 "Here we go. Now for a good night's rest."},
{"sounds_ao/chosen/ishmael/ish31.wav", "dialogue.sounds_ao.chosen.ishmael.ish31",
 "JoJo here, master."},
{"sounds_ao/chosen/ishmael/ish32.wav", "dialogue.sounds_ao.chosen.ishmael.ish32",
 "JoJo hears and obeys, master."},
{"sounds_ao/chosen/ishmael/ish33.wav", "dialogue.sounds_ao.chosen.ishmael.ish33",
 "Well, that wasn't so bad. I wonder if I'll ever miss the smell of my own dung mingled with hay."},
{"sounds_ao/chosen/ishmael/ish34.wav", "dialogue.sounds_ao.chosen.ishmael.ish34",
 "Oh, hello there! Have you any bananas by chance?"},
{"sounds_ao/chosen/ishmael/ish35.wav", "dialogue.sounds_ao.chosen.ishmael.ish35",
 "Quite."},
{"sounds_ao/chosen/ishmael/ishint11.wav", "dialogue.sounds_ao.chosen.ishmael.ishint11",
 "[Chuckles]"},
{"sounds_ao/chosen/ishmael/ishint21.wav", "dialogue.sounds_ao.chosen.ishmael.ishint21.1",
 "Well, I suppose it is my turn, yes? My, my. Like Ophelia, I have a secret.", false, 0, 6.64},
{"sounds_ao/chosen/ishmael/ishint21.wav", "dialogue.sounds_ao.chosen.ishmael.ishint21.2",
 "Doubtlessly, you two have heard of JoJo, the idiot circus boy.", false, 6.64, 11.84},
{"sounds_ao/chosen/ishmael/ishint22.wav", "dialogue.sounds_ao.chosen.ishmael.ishint22.1",
 "Yes, well, I remember that. You see, I was JoJo.", false, 0, 4.90},
{"sounds_ao/chosen/ishmael/ishint22.wav", "dialogue.sounds_ao.chosen.ishmael.ishint22.2",
 "Unemployment did not cover evil cultists in those days, and the only place an out-of-work tattooed man "
 "could find work was the circus.", false, 4.90, 14.48},
{"sounds_ao/chosen/ishmael/ishint22.wav", "dialogue.sounds_ao.chosen.ishmael.ishint22.3",
 "So for a time I became JoJo. The previous JoJo passed on the revered mantle of JoJo-ness to me.", false, 14.48, 23.10},
{"sounds_ao/chosen/ishmael/ishint22.wav", "dialogue.sounds_ao.chosen.ishmael.ishint22.4",
 "And it was with proud grace that I strutted out onto the stage on my first day.", false, 23.10, 28.70},
{"sounds_ao/chosen/ishmael/ishint22.wav", "dialogue.sounds_ao.chosen.ishmael.ishint22.5",
 "Then, bastard little dirt-throwers like yourself taught me what it really was to be a freak.", false, 28.70, 35.00},
{"sounds_ao/chosen/ishmael/ishint22.wav", "dialogue.sounds_ao.chosen.ishmael.ishint22.6",
 "After a year of that, I was a prisoner to my own low self-esteem. One day, though, it all changed.", false, 35.00, 42.56},
{"sounds_ao/chosen/ishmael/ishint22.wav", "dialogue.sounds_ao.chosen.ishmael.ishint22.7",
 "Tchernobog spoke to me and did bid me to free myself of this mortal mockery.", false, 42.56, 50.96},
{"sounds_ao/chosen/ishmael/ishint22.wav", "dialogue.sounds_ao.chosen.ishmael.ishint22.8",
 "And so I did. But it was not easy.", false, 50.96, 54.56},
{"sounds_ao/chosen/ishmael/ishint31.wav", "dialogue.sounds_ao.chosen.ishmael.ishint31",
 "I must say I feel quite cheated."},
{"sounds_ao/chosen/ishmael/ishint32.wav", "dialogue.sounds_ao.chosen.ishmael.ishint32",
 "You might as well. We still have half a bag of marshmallows to go through, at any rate."},
{"sounds_ao/chosen/ishmael/ishintro.wav", "dialogue.sounds_ao.chosen.ishmael.ishintro",
 "Uh, would you please pass the weenies?"},
{"sounds_ao/chosen/ishmael/ishoutro.wav", "dialogue.sounds_ao.chosen.ishmael.ishoutro",
 "Um, excuse me, but who took the last marshmallow?"},
{"sounds_ao/chosen/ophelia/oph21.wav", "dialogue.sounds_ao.chosen.ophelia.oph21",
 "I've got to destroy those photo albums!"},
{"sounds_ao/chosen/ophelia/oph22.wav", "dialogue.sounds_ao.chosen.ophelia.oph22",
 "There, I've done it! My past is erased, and I can join the Cabal!"},
{"sounds_ao/chosen/ophelia/oph23.wav", "dialogue.sounds_ao.chosen.ophelia.oph23",
 "Hey, what are you doing in my story?"},
{"sounds_ao/chosen/ophelia/oph24.wav", "dialogue.sounds_ao.chosen.ophelia.oph24",
 "Erm… You're having a bad dream, Caleb, dear. Just a nightmare."},
{"sounds_ao/chosen/ophelia/ophint11.wav", "dialogue.sounds_ao.chosen.ophelia.ophint11.1",
 "Very funny. Actually, I have to let you two in on a little secret to tell this story.", false, 0, 6.64},
{"sounds_ao/chosen/ophelia/ophint11.wav", "dialogue.sounds_ao.chosen.ophelia.ophint11.2",
 "Don't tell Caleb, though. He'd never forgive me. You see, a very long time ago…", false, 6.64, 12.70},
{"sounds_ao/chosen/ophelia/ophint11.wav", "dialogue.sounds_ao.chosen.ophelia.ophint11.3",
 "Before I had any aspirations of world domination, I was but a boppy little sorority girl.", false, 12.70, 18.64},
{"sounds_ao/chosen/ophelia/ophint12.wav", "dialogue.sounds_ao.chosen.ophelia.ophint12.1",
 "Yeah, I know, Ish. Sounds bloody unlikely. It's true, though. My dark little secret.", false, 0, 5.76},
{"sounds_ao/chosen/ophelia/ophint12.wav", "dialogue.sounds_ao.chosen.ophelia.ophint12.2",
 "It's how I met the Cabal. One day they sent a horde of zombies to take over the campus.", false, 5.76, 10.96},
{"sounds_ao/chosen/ophelia/ophint12.wav", "dialogue.sounds_ao.chosen.ophelia.ophint12.3",
 "I understand there was some kind of genius student there who had invented a reanimation serum, but I "
 "doubt it.", false, 10.96, 16.82},
{"sounds_ao/chosen/ophelia/ophint12.wav", "dialogue.sounds_ao.chosen.ophelia.ophint12.4",
 "As zombies are prone to do, though, they gravitated toward the largest concentration of defenseless and "
 "scantily clad women, my sorority house.", false, 16.82, 25.60},
{"sounds_ao/chosen/ophelia/ophint12.wav", "dialogue.sounds_ao.chosen.ophelia.ophint12.5",
 "I figure I'd had enough of the perky life anyway. So instead of saving my sisters, I decided to ditch the "
 "bleached blonde look…", false, 25.60, 32.80},
{"sounds_ao/chosen/ophelia/ophint12.wav", "dialogue.sounds_ao.chosen.ophelia.ophint12.6",
 "And hook up with these Cabal guys. The problem was there was no way they'd let me in if they knew I "
 "belonged to a sorority.", false, 32.80, 38.68},
{"sounds_ao/chosen/ophelia/ophint12.wav", "dialogue.sounds_ao.chosen.ophelia.ophint12.7",
 "The zombies would take care of the girls, but the photo albums were still in the house. I had to get in "
 "there and destroy them.", false, 38.68, 46.40},
{"sounds_ao/chosen/ophelia/ophint31.wav", "dialogue.sounds_ao.chosen.ophelia.ophint31",
 "So, Gabby, it's down to you. What's your story?"},
{"sounds_ao/chosen/ophelia/ophint32.wav", "dialogue.sounds_ao.chosen.ophelia.ophint32",
 "And?"},
{"sounds_ao/chosen/ophelia/ophint33.wav", "dialogue.sounds_ao.chosen.ophelia.ophint33",
 "No deep secret to reveal? No corny plot to expose?"},
{"sounds_ao/chosen/ophelia/ophint34.wav", "dialogue.sounds_ao.chosen.ophelia.ophint34",
 "As far as I can tell, you've already told it."},
{"sounds_ao/chosen/ophelia/ophint35.wav", "dialogue.sounds_ao.chosen.ophelia.ophint35",
 "Now you're cookin'!"},
{"sounds_ao/chosen/ophelia/ophintro.wav", "dialogue.sounds_ao.chosen.ophelia.ophintro",
 "He always was terrible at telling stories."},
{"sounds_ao/enemies/gideon/gideoni1.wav", "dialogue.sounds_ao.enemies.gideon.gideoni1.1",
 "Oh, yes, hello. Surely you remember me? The power-mad and vainglorious Gideon?", false, 0, 9.14},
{"sounds_ao/enemies/gideon/gideoni1.wav", "dialogue.sounds_ao.enemies.gideon.gideoni1.2",
 "Once upon a time I pretended to the throne of the gods. Well, I suppose I got my wish.", false, 9.14, 16.30},
{"sounds_ao/enemies/gideon/gideoni1.wav", "dialogue.sounds_ao.enemies.gideon.gideoni1.3",
 "My undying soul is bound to this cranial prison for all eternity, no thanks to Caleb and his Chosen Ones.", false, 16.30, 24.88},
{"sounds_ao/enemies/gideon/gideoni1.wav", "dialogue.sounds_ao.enemies.gideon.gideoni1.4",
 "Anyway, there's no sense being bitter about it.", false, 24.88, 28.60},
{"sounds_ao/enemies/gideon/gideoni1.wav", "dialogue.sounds_ao.enemies.gideon.gideoni1.5",
 "I imagine one day I'll serve as a muse to some unfortunate playwright who wanders this way.", false, 28.60, 35.30},
{"sounds_ao/enemies/gideon/gideoni1.wav", "dialogue.sounds_ao.enemies.gideon.gideoni1.6",
 "Until then, gentle player, I'll amuse you with this little anecdote.", false, 35.30, 41.50},
{"sounds_ao/enemies/gideon/gideoni2.wav", "dialogue.sounds_ao.enemies.gideon.gideoni2.1",
 "After defeating the Ancient One, the Chosen had a long walk home through the Otherworld.", false, 0, 6.08},
{"sounds_ao/enemies/gideon/gideoni2.wav", "dialogue.sounds_ao.enemies.gideon.gideoni2.2",
 "They were able to handle the odd demon or two that came their way, but what they were not ready for…", false, 7.20, 13.12},
{"sounds_ao/enemies/gideon/gideoni2.wav", "dialogue.sounds_ao.enemies.gideon.gideoni2.3",
 "Was the powerful psychic terror that stalked the wastes. The Nightmare.", false, 13.12, 20.40},
{"sounds_ao/enemies/gideon/gideoni2.wav", "dialogue.sounds_ao.enemies.gideon.gideoni2.4",
 "Fools that they were, the Chosen practically invited a visit from this devil when they decided to tell "
 "scary stories…", false, 20.40, 27.28},
{"sounds_ao/enemies/gideon/gideoni2.wav", "dialogue.sounds_ao.enemies.gideon.gideoni2.5",
 "During one of their repasts. Little did they know, but each one of them was about to be transported…", false, 27.28, 34.32},
{"sounds_ao/enemies/gideon/gideoni2.wav", "dialogue.sounds_ao.enemies.gideon.gideoni2.6",
 "To their personal hells. Observe and be entertained, dear player.", false, 34.32, 40.96},
{"sounds_ao/enemies/gideon/gideoni3.wav", "dialogue.sounds_ao.enemies.gideon.gideoni3.1",
 "And so our story comes to an end. Caleb is victorious yet again. It seems nothing can stop him.", false, 0, 8.44},
{"sounds_ao/enemies/gideon/gideoni3.wav", "dialogue.sounds_ao.enemies.gideon.gideoni3.2",
 "At times it is almost as if the unseen hand of some otherworldly being is guiding his actions.", false, 8.44, 15.84},
{"sounds_ao/enemies/gideon/gideoni3.wav", "dialogue.sounds_ao.enemies.gideon.gideoni3.3",
 "But it is best for me not to dwell on such things. For now, I will content myself with observation.", false, 15.84, 24.64},
{"sounds_ao/enemies/gideon/gideoni3.wav", "dialogue.sounds_ao.enemies.gideon.gideoni3.4",
 "The Chosen have many adventures ahead of them. Stories to tell, battles to fight, and empires to forge.", false, 24.64, 32.48},
{"sounds_ao/enemies/gideon/gideoni3.wav", "dialogue.sounds_ao.enemies.gideon.gideoni3.5",
 "Perhaps one day I will find a way to make my return.", false, 32.48, 40.30},
{"sounds_ao/enemies/gideon/gideoni3.wav", "dialogue.sounds_ao.enemies.gideon.gideoni3.6",
 "And on that day, I assure you, Caleb will burn.", false, 40.30, 45.92},
{"sounds_ao/enemies/tchernobog/tcherno31.wav", "dialogue.sounds_ao.enemies.tchernobog.tcherno31",
 "Ishmael. Listen."},
{"sounds_ao/enemies/tchernobog/tcherno32.wav", "dialogue.sounds_ao.enemies.tchernobog.tcherno32",
 "You are JoJo no longer. Go. Kill these mortals and come to my side. We have much work to do."},
